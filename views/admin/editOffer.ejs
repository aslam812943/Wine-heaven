<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Offer | Wine Heaven</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --bg: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
        }

        .heading-font {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        }

        .btn-premium {
            background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dk) 100%);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            transition: all 0.2s;
            outline: none;
            font-family: 'Inter', sans-serif;
        }

        .form-input:focus {
            border-color: var(--maroon);
            box-shadow: 0 0 0 3px rgba(107, 15, 26, 0.1);
            background: white;
        }

        .form-label {
            display: block;
            font-size: 0.65rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }
    </style>
</head>

<body class="bg-[#f8f9fa]">
    <%- include('../partials/adminSidebar.ejs') %>
        <div class="lg:ml-64 p-6 pt-24 md:pt-6">
            <div class="max-w-xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 heading-font">Edit Offer</h1>
                        <p class="text-sm text-gray-500 mt-1">Update offer details.</p>
                    </div>
                    <a href="/admin/offers"
                        class="bg-white border border-gray-200 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-gray-50 transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-arrow-left text-xs"></i> Back
                    </a>
                </div>

                <div class="glass-card p-8">
                    <form action="/admin/offers/edit/<%= offer._id %>" method="POST">
                        <div class="space-y-5">
                            <div>
                                <label class="form-label">Offer Name</label>
                                <input type="text" name="offerName" value="<%= offer.offerName %>" class="form-input"
                                    placeholder="Offer name" maxlength="22" required>
                            </div>
                            <div>
                                <label class="form-label">Discount Percentage (%)</label>
                                <div class="relative">
                                    <input type="number" name="discountPercentage"
                                        value="<%= offer.discountPercentage %>" class="form-input pr-12"
                                        placeholder="e.g. 15" min="1" max="90" required>
                                    <span
                                        class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 font-bold text-sm">%</span>
                                </div>
                            </div>
                            <button type="submit"
                                class="btn-premium w-full py-3.5 rounded-xl text-xs font-bold uppercase tracking-widest shadow-lg">
                                <i class="fa-solid fa-floppy-disk mr-2"></i> Save Changes
                            </button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
</body>

</html>