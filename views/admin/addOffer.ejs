<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Offer | Wine Heaven</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --bg: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
        }

        .heading-font {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        }

        .btn-premium {
            background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dk) 100%);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(107, 15, 26, 0.3);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            transition: all 0.2s;
            outline: none;
            font-family: 'Inter', sans-serif;
        }

        .form-input:focus {
            border-color: var(--maroon);
            box-shadow: 0 0 0 3px rgba(107, 15, 26, 0.1);
            background: white;
        }

        .form-label {
            display: block;
            font-size: 0.65rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }

        .radio-card {
            border: 2px solid #e5e7eb;
            border-radius: 0.875rem;
            padding: 1rem 1.25rem;
            cursor: pointer;
            transition: all 0.2s;
            display: flex;
            align-items: center;
            gap: 0.75rem;
        }

        .radio-card:has(input:checked) {
            border-color: var(--maroon);
            background: rgba(107, 15, 26, 0.03);
        }

        .radio-card input[type="radio"] {
            accent-color: var(--maroon);
            width: 16px;
            height: 16px;
        }
    </style>
</head>

<body class="bg-[#f8f9fa]">
    <%- include('../partials/adminSidebar.ejs') %>
        <div class="lg:ml-64 p-6 pt-24 md:pt-6">
            <div class="max-w-xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 heading-font">Add Offer</h1>
                        <p class="text-sm text-gray-500 mt-1">Create a promotional offer for products or categories.</p>
                    </div>
                    <a href="/admin/offers"
                        class="bg-white border border-gray-200 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-gray-50 transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-arrow-left text-xs"></i> Back
                    </a>
                </div>

                <% if (typeof error_msg !=='undefined' && error_msg) { %>
                    <div class="mb-4 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-lg">
                        <p class="text-sm text-rose-600 font-medium">
                            <%= error_msg %>
                        </p>
                    </div>
                    <% } %>

                        <div class="glass-card p-8">
                            <form action="/admin/offers/add" method="POST">
                                <div class="space-y-6">
                                    <div>
                                        <label class="form-label">Offer Name</label>
                                        <input type="text" name="offerName" class="form-input"
                                            placeholder="e.g. Summer Sale" maxlength="22" required>
                                    </div>

                                    <div>
                                        <label class="form-label">Offer Type</label>
                                        <div class="grid grid-cols-2 gap-3">
                                            <label class="radio-card">
                                                <input type="radio" name="offerType" value="category" checked
                                                    onclick="toggleOfferType()">
                                                <div>
                                                    <p class="text-sm font-bold text-gray-700">Category</p>
                                                    <p class="text-[10px] text-gray-400">Apply to entire category</p>
                                                </div>
                                            </label>
                                            <label class="radio-card">
                                                <input type="radio" name="offerType" value="product"
                                                    onclick="toggleOfferType()">
                                                <div>
                                                    <p class="text-sm font-bold text-gray-700">Product</p>
                                                    <p class="text-[10px] text-gray-400">Apply to specific product</p>
                                                </div>
                                            </label>
                                        </div>
                                    </div>

                                    <div id="categorySection">
                                        <label class="form-label">Select Category</label>
                                        <select name="offerCategory" class="form-input">
                                            <option value="" disabled selected>Choose a category</option>
                                            <% categories.forEach(category=> { %>
                                                <option value="<%= category._id %>">
                                                    <%= category.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>

                                    <div id="productSection" style="display:none;">
                                        <label class="form-label">Select Product</label>
                                        <select name="offerProduct" class="form-input">
                                            <option value="" disabled selected>Choose a product</option>
                                            <% products.forEach(product=> { %>
                                                <option value="<%= product._id %>">
                                                    <%= product.name %>
                                                </option>
                                                <% }) %>
                                        </select>
                                    </div>

                                    <div>
                                        <label class="form-label">Discount Percentage (%)</label>
                                        <div class="relative">
                                            <input type="number" name="discountPercentage" class="form-input pr-12"
                                                placeholder="e.g. 15" min="1" max="90" required>
                                            <span
                                                class="absolute inset-y-0 right-0 pr-3.5 flex items-center text-gray-400 font-bold text-sm">%</span>
                                        </div>
                                    </div>

                                    <button type="submit"
                                        class="btn-premium w-full py-3.5 rounded-xl text-xs font-bold uppercase tracking-widest shadow-lg">
                                        <i class="fa-solid fa-tag mr-2"></i> Create Offer
                                    </button>
                                </div>
                            </form>
                        </div>
            </div>
        </div>
        <script>
            function toggleOfferType() {
                const offerType = document.querySelector('input[name="offerType"]:checked').value;
                document.getElementById('categorySection').style.display = offerType === 'category' ? 'block' : 'none';
                document.getElementById('productSection').style.display = offerType === 'product' ? 'block' : 'none';
            }
        </script>
</body>

</html>