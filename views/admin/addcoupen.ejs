<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Add Coupon | Wine Heaven</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --bg: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
        }

        .heading-font {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        }

        .btn-premium {
            background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dk) 100%);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(107, 15, 26, 0.3);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            transition: all 0.2s;
            outline: none;
            font-family: 'Inter', sans-serif;
        }

        .form-input:focus {
            border-color: var(--maroon);
            box-shadow: 0 0 0 3px rgba(107, 15, 26, 0.1);
            background: white;
        }

        .form-input.border-red-500 {
            border-color: #ef4444;
        }

        .form-label {
            display: block;
            font-size: 0.65rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }

        .error-hint {
            color: #ef4444;
            font-size: 0.7rem;
            margin-top: 0.25rem;
            font-weight: 500;
        }
    </style>
</head>

<body class="bg-[#f8f9fa]">
    <%- include('../partials/adminSidebar.ejs') %>
        <div class="lg:ml-64 p-6 pt-24 md:pt-6">
            <div class="max-w-2xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 heading-font">Add Coupon</h1>
                        <p class="text-sm text-gray-500 mt-1">Create a new discount coupon for customers.</p>
                    </div>
                    <a href="/admin/coupons"
                        class="bg-white border border-gray-200 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-gray-50 transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-arrow-left text-xs"></i> Back
                    </a>
                </div>

                <% if (typeof error_msg !=='undefined' && error_msg) { %>
                    <div class="mb-4 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-lg">
                        <p class="text-sm text-rose-600 font-medium">
                            <%= error_msg %>
                        </p>
                    </div>
                    <% } %>
                        <% if (typeof errors !=='undefined' && errors && errors.length> 0) { %>
                            <div class="mb-4 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-lg">
                                <ul class="list-disc list-inside space-y-1">
                                    <% errors.forEach(e=> { %><li class="text-sm text-rose-600">
                                            <%= e.msg %>
                                        </li>
                                        <% }) %>
                                </ul>
                            </div>
                            <% } %>

                                <div class="glass-card p-8">
                                    <form id="couponForm" action="/admin/coupons" method="POST">
                                        <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                            <div>
                                                <label class="form-label">Coupon Code <span
                                                        class="text-rose-400">*</span></label>
                                                <input type="text" id="code" name="code" class="form-input" required
                                                    minlength="4" maxlength="12" pattern="[A-Za-z0-9]+"
                                                    placeholder="e.g. SAVE20">
                                                <p id="codeError" class="error-hint hidden">4-12 alphanumeric characters
                                                    only.</p>
                                            </div>
                                            <div>
                                                <label class="form-label">Discount Type <span
                                                        class="text-rose-400">*</span></label>
                                                <select id="discountType" name="discountType" class="form-input"
                                                    required>
                                                    <option value="">Select type</option>
                                                    <option value="percentage">Percentage (%)</option>
                                                    <option value="fixed">Fixed Amount (₹)</option>
                                                </select>
                                                <p id="discountTypeError" class="error-hint hidden">Please select a
                                                    discount type.</p>
                                            </div>
                                            <div>
                                                <label class="form-label">Discount Amount <span
                                                        class="text-rose-400">*</span></label>
                                                <input type="number" id="discountAmount" name="discountAmount"
                                                    class="form-input" required min="1" step="0.01"
                                                    placeholder="Enter amount">
                                                <p id="discountAmountError" class="error-hint hidden">Invalid discount
                                                    amount.</p>
                                            </div>
                                            <div>
                                                <label class="form-label">Minimum Purchase</label>
                                                <input type="number" id="minimumPurchase" name="minimumPurchase"
                                                    class="form-input" min="0" step="0.01" placeholder="Optional (₹)">
                                            </div>
                                            <div>
                                                <label class="form-label">Valid From <span
                                                        class="text-rose-400">*</span></label>
                                                <input type="date" id="validFrom" name="validFrom" class="form-input"
                                                    required>
                                                <p id="validFromError" class="error-hint hidden">Select a valid start
                                                    date.</p>
                                            </div>
                                            <div>
                                                <label class="form-label">Valid Until <span
                                                        class="text-rose-400">*</span></label>
                                                <input type="date" id="validUntil" name="validUntil" class="form-input"
                                                    required>
                                                <p id="validUntilError" class="error-hint hidden">Select a valid end
                                                    date.</p>
                                            </div>
                                            <div class="md:col-span-2">
                                                <label class="form-label">Usage Limit <span
                                                        class="text-rose-400">*</span></label>
                                                <input type="number" id="usageLimit" name="usageLimit"
                                                    class="form-input" min="1" max="20" placeholder="Max 20 uses"
                                                    required>
                                                <p id="usageLimitError" class="error-hint hidden">Must be between 1 and
                                                    20.</p>
                                            </div>
                                        </div>
                                        <div class="mt-6 pt-4 border-t border-gray-100">
                                            <button type="submit"
                                                class="btn-premium w-full py-3.5 rounded-xl text-xs font-bold uppercase tracking-widest shadow-lg">
                                                <i class="fa-solid fa-ticket-simple mr-2"></i> Create Coupon
                                            </button>
                                        </div>
                                    </form>
                                </div>
            </div>
        </div>
        <script>
            document.addEventListener('DOMContentLoaded', function () {
                const form = document.getElementById('couponForm');
                const inputs = form.querySelectorAll('input, select');
                const today = new Date().toISOString().split('T')[0];
                const validFrom = document.getElementById('validFrom');
                const validUntil = document.getElementById('validUntil');
                validFrom.setAttribute('min', today);
                validUntil.setAttribute('min', today);

                function showError(input, show) {
                    const el = document.getElementById(`${input.id}Error`);
                    if (el) el.classList.toggle('hidden', !show);
                    input.classList.toggle('border-red-500', show);
                }

                function validateField(input) {
                    let isValid = true;
                    switch (input.id) {
                        case 'code': isValid = /^[A-Za-z0-9]{4,12}$/.test(input.value); break;
                        case 'discountAmount':
                            const type = document.getElementById('discountType').value;
                            isValid = type === 'percentage' ? (input.value > 0 && input.value <= 80) : input.value > 0;
                            break;
                        case 'validUntil':
                            const vf = document.getElementById('validFrom').value;
                            isValid = vf && input.value ? new Date(input.value) >= new Date(vf) : true;
                            break;
                        default: isValid = input.checkValidity();
                    }
                    showError(input, !isValid);
                    return isValid;
                }

                validFrom.addEventListener('change', () => { validUntil.min = validFrom.value; validateField(validUntil); });
                validUntil.addEventListener('change', () => { validFrom.max = validUntil.value; });
                document.getElementById('discountType').addEventListener('change', () => validateField(document.getElementById('discountAmount')));
                inputs.forEach(i => { i.addEventListener('input', () => validateField(i)); i.addEventListener('blur', () => validateField(i)); });

                form.addEventListener('submit', function (e) {
                    let valid = true;
                    inputs.forEach(i => { if (!validateField(i)) valid = false; });
                    if (!valid) e.preventDefault();
                });
            });
        </script>
</body>

</html>