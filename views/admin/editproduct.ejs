<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Product | Wine Heaven</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.css" rel="stylesheet">
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --bg: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
        }

        .heading-font {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        }

        .btn-premium {
            background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dk) 100%);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            transition: all 0.2s;
            outline: none;
            font-family: 'Inter', sans-serif;
        }

        .form-input:focus {
            border-color: var(--maroon);
            box-shadow: 0 0 0 3px rgba(107, 15, 26, 0.1);
            background: white;
        }

        .form-label {
            display: block;
            font-size: 0.65rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }

        .error-hint {
            color: #ef4444;
            font-size: 0.7rem;
            margin-top: 0.25rem;
            font-weight: 500;
        }

        .hidden {
            display: none;
        }

        .upload-zone {
            border: 2px dashed #e5e7eb;
            border-radius: 0.75rem;
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: #f9fafb;
        }

        .upload-zone:hover {
            border-color: var(--maroon);
        }

        .upload-zone input[type="file"] {
            display: none;
        }

        .cropped-image {
            width: 96px;
            height: 96px;
            object-fit: cover;
            border-radius: 0.75rem;
            border: 2px solid #e5e7eb;
        }

        .img-wrapper {
            position: relative;
            display: inline-block;
            margin: 6px;
        }

        .delete-button {
            position: absolute;
            top: -6px;
            right: -6px;
            background: #ef4444;
            color: white;
            border: none;
            border-radius: 50%;
            cursor: pointer;
            width: 22px;
            height: 22px;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 11px;
            font-weight: bold;
        }

        #crop-modal {
            display: none;
            position: fixed;
            top: 0;
            left: 0;
            width: 100%;
            height: 100%;
            background: rgba(0, 0, 0, 0.7);
            justify-content: center;
            align-items: center;
            z-index: 9999;
        }

        #crop-modal .modal-content {
            background: #fff;
            padding: 24px;
            border-radius: 20px;
            max-width: 90vw;
            width: 500px;
            max-height: 90vh;
            overflow-y: auto;
        }

        .preview-container {
            max-width: 100%;
            max-height: 380px;
        }
    </style>
</head>

<body class="bg-[#f8f9fa]">
    <div class="flex">
        <%- include('../partials/adminSidebar.ejs') %>
            <div class="lg:ml-64 p-6 pt-24 md:pt-6 w-full">
                <div class="max-w-2xl mx-auto">
                    <div class="flex justify-between items-center mb-6">
                        <div>
                            <h1 class="text-3xl font-bold text-gray-800 heading-font">Edit Product</h1>
                            <p class="text-sm text-gray-500 mt-1">Update product details and images.</p>
                        </div>
                        <a href="/admin/products"
                            class="bg-white border border-gray-200 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-gray-50 transition-colors flex items-center gap-2">
                            <i class="fa-solid fa-arrow-left text-xs"></i> Back
                        </a>
                    </div>

                    <% if (typeof error_msg !=='undefined' && error_msg) { %>
                        <div class="mb-4 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-lg">
                            <p class="text-sm text-rose-600">
                                <%= error_msg %>
                            </p>
                        </div>
                        <% } %>
                            <% if (typeof success_msg !=='undefined' && success_msg) { %>
                                <div class="mb-4 p-4 bg-emerald-50 border-l-4 border-emerald-500 rounded-r-lg">
                                    <p class="text-sm text-emerald-600">
                                        <%= success_msg %>
                                    </p>
                                </div>
                                <% } %>

                                    <div class="glass-card p-8">
                                        <form action="/admin/products/edit/<%= product._id %>" method="POST"
                                            enctype="multipart/form-data" id="productForm">
                                            <div class="space-y-5">
                                                <div class="grid grid-cols-1 md:grid-cols-2 gap-5">
                                                    <div>
                                                        <label class="form-label">Product Name</label>
                                                        <input type="text" name="name" id="name"
                                                            value="<%= product.name %>" class="form-input" required>
                                                    </div>
                                                    <div>
                                                        <label class="form-label">Price (₹)</label>
                                                        <div class="relative">
                                                            <input type="number" name="price" id="price"
                                                                value="<%= product.price %>" class="form-input pl-8"
                                                                required min="0">
                                                            <span
                                                                class="absolute inset-y-0 left-0 pl-3 flex items-center text-gray-400 font-bold text-sm">₹</span>
                                                        </div>
                                                    </div>
                                                    <div>
                                                        <label class="form-label">Category</label>
                                                        <select name="category" id="category" class="form-input"
                                                            required>
                                                            <% categories.forEach(category=> { %>
                                                                <option value="<%= category._id %>" <%=product.category
                                                                    &&
                                                                    product.category._id.toString()===category._id.toString()
                                                                    ? 'selected' : '' %>><%= category.name %>
                                                                </option>
                                                                <% }) %>
                                                        </select>
                                                    </div>
                                                    <div>
                                                        <label class="form-label">Stock</label>
                                                        <input type="number" name="stock" id="stock"
                                                            value="<%= product.stock %>" class="form-input" required
                                                            min="0">
                                                    </div>
                                                    <div>
                                                        <label class="form-label">Discount (%)</label>
                                                        <div class="relative">
                                                            <input id="discount" value="<%= product.discount %>"
                                                                type="number" name="discount" class="form-input pr-8"
                                                                min="0" max="90">
                                                            <span
                                                                class="absolute inset-y-0 right-0 pr-3 flex items-center text-gray-400 font-bold text-sm">%</span>
                                                        </div>
                                                        <p id="discount-error" class="error-hint hidden">Discount must
                                                            be 0-90.</p>
                                                    </div>
                                                </div>

                                                <div>
                                                    <label class="form-label">Description</label>
                                                    <textarea name="description" id="description"
                                                        class="form-input resize-none" rows="3"
                                                        required><%= product.description %></textarea>
                                                </div>

                                                <!-- Existing Images -->
                                                <div>
                                                    <label class="form-label">Existing Images</label>
                                                    <div class="flex flex-wrap" id="existingImages">
                                                        <% if (product.images && product.images.length> 0) { %>
                                                            <% product.images.forEach((image, index)=> { %>
                                                                <div class="img-wrapper" data-image-path="<%= image %>"
                                                                    data-index="<%= index %>">
                                                                    <img src="<%= image.startsWith('http') ? image : '/uploads/' + image %>"
                                                                        alt="Product Image" class="cropped-image">
                                                                    <button type="button" class="delete-button"
                                                                        onclick="markImageForDeletion(this, '<%= index %>')">×</button>
                                                                </div>
                                                                <% }) %>
                                                                    <% } else { %>
                                                                        <p class="text-sm text-gray-400">No existing
                                                                            images.</p>
                                                                        <% } %>
                                                    </div>
                                                </div>

                                                <!-- Upload New Images -->
                                                <div>
                                                    <label class="form-label">Upload New Images <span
                                                            class="text-gray-400 normal-case font-normal">(if replacing
                                                            existing)</span></label>
                                                    <label class="upload-zone block" for="imageInput">
                                                        <i
                                                            class="fa-solid fa-cloud-arrow-up text-2xl text-gray-300 mb-2"></i>
                                                        <p class="text-sm font-semibold text-gray-500">Click to add new
                                                            images</p>
                                                        <input type="file" id="imageInput" name="images"
                                                            accept="image/*" multiple>
                                                    </label>
                                                    <input type="hidden" name="croppedImages" id="croppedImages">
                                                    <input type="hidden" name="deletedImages" id="deletedImages">
                                                    <p id="image-error" class="error-hint hidden">Ensure exactly 3
                                                        images total.</p>
                                                </div>

                                                <div>
                                                    <label class="form-label">New Cropped Images</label>
                                                    <div class="flex flex-wrap" id="newImages"></div>
                                                </div>

                                                <!-- Crop Modal -->
                                                <div id="crop-modal" class="flex">
                                                    <div class="modal-content">
                                                        <h3
                                                            class="text-sm font-bold text-gray-700 mb-3 uppercase tracking-widest">
                                                            Crop Image</h3>
                                                        <img id="imagePreview" src="" alt="Image Preview"
                                                            class="preview-container">
                                                        <div class="mt-4 flex gap-3 justify-end">
                                                            <button type="button" onclick="closeCropModal()"
                                                                class="px-4 py-2 text-xs font-bold border border-gray-200 rounded-xl text-gray-600 hover:bg-gray-50">Cancel</button>
                                                            <button type="button" onclick="cropImage()"
                                                                class="btn-premium px-4 py-2 text-xs font-bold rounded-xl">
                                                                <i class="fa-solid fa-crop-simple mr-1"></i> Crop
                                                            </button>
                                                        </div>
                                                    </div>
                                                </div>

                                                <div class="pt-2 border-t border-gray-100">
                                                    <button type="submit"
                                                        class="btn-premium w-full py-3.5 rounded-xl text-xs font-bold uppercase tracking-widest shadow-lg">
                                                        <i class="fa-solid fa-floppy-disk mr-2"></i> Save Changes
                                                    </button>
                                                </div>
                                            </div>
                                        </form>
                                    </div>
                </div>
            </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.12/cropper.min.js"></script>
    <script>
        let form = document.getElementById('productForm');
        let cropper;
        let croppedImagesArray = [];
        let deletedImagesArray = [];
        let newImageIndex = 0;

        form.addEventListener('submit', function (e) {
            e.preventDefault();
            const totalImages = document.querySelectorAll('#existingImages .img-wrapper').length + croppedImagesArray.length;
            if (totalImages !== 3) {
                const errEl = document.getElementById('image-error');
                errEl.textContent = `Exactly 3 images required. Currently: ${totalImages}`;
                errEl.classList.remove('hidden');
                return;
            } else { document.getElementById('image-error').classList.add('hidden'); }

            const formData = new FormData(form);
            croppedImagesArray.forEach((item, index) => { formData.append('images', item.blob, `image-${Date.now()}-${index}.png`); });
            formData.set('deletedImages', JSON.stringify(deletedImagesArray));

            fetch(form.action, { method: 'POST', body: formData })
                .then(r => r.json())
                .then(data => {
                    if (data.success) window.location.href = '/admin/products';
                    else Swal.fire('Error', data.message || 'Update failed', 'error');
                })
                .catch(() => Swal.fire('Error', 'An unexpected error occurred', 'error'));
        });

        document.getElementById('imageInput').addEventListener('change', function (event) {
            const files = event.target.files;
            if (files.length) {
                for (let i = 0; i < files.length; i++) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        document.getElementById('crop-modal').style.display = 'flex';
                        const img = document.getElementById('imagePreview');
                        img.src = event.target.result;
                        img.onload = function () {
                            if (cropper) cropper.destroy();
                            cropper = new Cropper(img, { aspectRatio: 1, viewMode: 1 });
                        };
                    };
                    reader.readAsDataURL(files[i]);
                }
            }
        });

        function cropImage() {
            const canvas = cropper.getCroppedCanvas();
            canvas.toBlob(function (blob) {
                const url = URL.createObjectURL(blob);
                const imageId = `new-${newImageIndex++}`;
                croppedImagesArray.push({ id: imageId, blob, url });
                const imgWrapper = document.createElement('div');
                imgWrapper.className = 'img-wrapper';
                imgWrapper.dataset.imageId = imageId;
                imgWrapper.innerHTML = `<img src="${url}" alt="Cropped" class="cropped-image"><button type="button" class="delete-button" onclick="removeCroppedImage(this, '${imageId}')">×</button>`;
                document.getElementById('newImages').appendChild(imgWrapper);
            });
            closeCropModal();
        }

        function closeCropModal() {
            document.getElementById('crop-modal').style.display = 'none';
            if (cropper) cropper.destroy();
        }

        function markImageForDeletion(button, index) {
            const wrapper = button.parentElement;
            deletedImagesArray.push(wrapper.dataset.imagePath);
            wrapper.remove();
        }

        function removeCroppedImage(button, imageId) {
            button.parentElement.remove();
            croppedImagesArray = croppedImagesArray.filter(img => img.id !== imageId);
        }
    </script>
</body>

</html>