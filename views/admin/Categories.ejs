<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Category Management | Wine Heaven</title>
  <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
  <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
  <link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap"
    rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
  <style>
    :root {
      --maroon: #6b0f1a;
      --maroon-dk: #4a0a12;
      --gold: #c9a84c;
      --bg: #f8f9fa;
    }

    body {
      font-family: 'Inter', sans-serif;
      background-color: var(--bg);
    }

    .heading-font {
      font-family: 'Playfair Display', serif;
    }

    .glass-card {
      background: rgba(255, 255, 255, 0.9);
      backdrop-filter: blur(10px);
      border: 1px solid rgba(255, 255, 255, 0.2);
      border-radius: 20px;
      box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
    }

    .btn-premium {
      background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dk) 100%);
      color: white;
      transition: all 0.3s ease;
    }

    .btn-premium:hover {
      filter: brightness(1.1);
      transform: translateY(-1px);
    }

    .status-active {
      background: #ecfdf5;
      color: #059669;
      border: 1px solid #10b98130;
    }

    .status-blocked {
      background: #fff1f2;
      color: #e11d48;
      border: 1px solid #f43f5e30;
    }
  </style>
</head>

<body class="bg-[#f8f9fa]">
  <%- include('../partials/adminSidebar.ejs') %>

    <div class="lg:ml-64 p-6 pt-24 md:pt-6">
      <div class="glass-card p-8">
        <div class="flex flex-col md:flex-row justify-between items-center mb-8 gap-4">
          <div>
            <h1 class="text-3xl font-bold text-gray-800 heading-font">Category Management</h1>
            <p class="text-gray-500 text-sm mt-1">Manage your wine collections and categories.</p>
          </div>
          <div class="flex gap-3">
            <a href="/category/add"
              class="btn-premium px-6 py-2.5 rounded-xl text-sm font-bold flex items-center gap-2 shadow-lg">
              <i class="fa-solid fa-plus-circle"></i> Add Category
            </a>
          </div>
        </div>

        <% if (typeof error_msg !=='undefined' && error_msg) { %>
          <p class="text-rose-500 bg-rose-50 p-3 rounded-lg mb-4 text-sm font-medium">
            <%= error_msg %>
          </p>
          <% } %>
            <% if (typeof success_msg !=='undefined' && success_msg) { %>
              <p class="text-emerald-500 bg-emerald-50 p-3 rounded-lg mb-4 text-sm font-medium">
                <%= success_msg %>
              </p>
              <% } %>

                <div class="overflow-x-auto rounded-xl border border-gray-100">
                  <table class="min-w-full bg-white whitespace-nowrap">
                    <thead>
                      <tr class="bg-gray-50 text-gray-500 text-xs uppercase tracking-wider">
                        <th class="py-4 px-6 text-left font-bold">Category Name</th>
                        <th class="py-4 px-6 text-left font-bold">Preview</th>
                        <th class="py-4 px-6 text-left font-bold">Status</th>
                        <th class="py-4 px-6 text-left font-bold">Actions</th>
                      </tr>
                    </thead>
                    <tbody class="divide-y divide-gray-100">
                      <% categories.forEach(category=> { %>
                        <tr class="hover:bg-gray-50/50 transition-colors">
                          <td class="py-4 px-6">
                            <span class="font-semibold text-gray-700 capitalize">
                              <%= category.name %>
                            </span>
                          </td>
                          <td class="py-4 px-6">
                            <img src="<%= category.imageUrl %>" alt="<%= category.name %>"
                              class="w-20 h-14 object-cover rounded-lg shadow-sm border border-gray-100">
                          </td>
                          <td class="py-4 px-6">
                            <span
                              class="px-3 py-1 rounded-full text-xs font-bold uppercase tracking-tight <%= category.isBlocked ? 'status-blocked' : 'status-active' %>">
                              <%= category.isBlocked ? 'Blocked' : 'Active' %>
                            </span>
                          </td>
                          <td class="py-4 px-6">
                            <div class="flex items-center gap-2">
                              <a href="/category/edit/<%= category._id %>"
                                class="p-2 text-amber-500 hover:bg-amber-50 rounded-lg transition-colors" title="Edit">
                                <i class="fa-solid fa-pen-to-square"></i>
                              </a>
                              <% if (category.isBlocked) { %>
                                <form action="/category/unblock/<%= category._id %>" method="POST" class="inline">
                                  <button type="submit"
                                    class="p-2 text-emerald-500 hover:bg-emerald-50 rounded-lg transition-colors"
                                    title="Unblock">
                                    <i class="fa-solid fa-lock-open"></i>
                                  </button>
                                </form>
                                <% } else { %>
                                  <form action="/category/block/<%= category._id %>" method="POST" class="inline">
                                    <button type="submit"
                                      class="p-2 text-rose-500 hover:bg-rose-50 rounded-lg transition-colors"
                                      title="Block">
                                      <i class="fa-solid fa-lock"></i>
                                    </button>
                                  </form>
                                  <% } %>
                            </div>
                          </td>
                        </tr>
                        <% }) %>
                    </tbody>
                  </table>
                </div>

                <!-- Pagination Controls -->
                <div class="flex justify-center mt-8 gap-2">
                  <% if (currentPage> 1) { %>
                    <a href="?page=<%= currentPage - 1 %>"
                      class="w-10 h-10 flex items-center justify-center rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
                      <i class="fa-solid fa-chevron-left text-xs"></i>
                    </a>
                    <% } %>
                      <% for (let i=1; i <=totalPages; i++) { %>
                        <a href="?page=<%= i %>"
                          class="w-10 h-10 flex items-center justify-center rounded-xl font-bold text-sm transition-all <%= currentPage === i ? 'btn-premium' : 'bg-white border border-gray-200 text-gray-600 hover:bg-gray-50' %>">
                          <%= i %>
                        </a>
                        <% } %>
                          <% if (currentPage < totalPages) { %>
                            <a href="?page=<%= currentPage + 1 %>"
                              class="w-10 h-10 flex items-center justify-center rounded-xl border border-gray-200 text-gray-600 hover:bg-gray-50 transition-colors">
                              <i class="fa-solid fa-chevron-right text-xs"></i>
                            </a>
                            <% } %>
                </div>
      </div>
    </div>
    </div>

    <script>
      const menuToggle = document.getElementById('menu-toggle');
      const sidebar = document.querySelector('.sidebar');

      menuToggle.addEventListener('click', () => {
        sidebar.classList.toggle('open');
      });



      function confirmDelete(categoryId) {
        Swal.fire({
          title: 'Are you sure?',
          text: 'You won\'t be able to revert this!',
          icon: 'warning',
          showCancelButton: true,
          confirmButtonColor: '#3085d6',
          cancelButtonColor: '#d33',
          confirmButtonText: 'Yes, delete it!'
        }).then((result) => {
          if (result.isConfirmed) {
            document.getElementById(`deleteForm${categoryId}`).submit();
          }
        });
      }

    </script>
</body>

</html>