<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Edit Category | Wine Heaven</title>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600;700&display=swap"
        rel="stylesheet">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.css" rel="stylesheet">
    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --bg: #f8f9fa;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--bg);
        }

        .heading-font {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 20px;
            box-shadow: 0 8px 32px rgba(0, 0, 0, 0.05);
        }

        .btn-premium {
            background: linear-gradient(135deg, var(--maroon) 0%, var(--maroon-dk) 100%);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            filter: brightness(1.1);
            transform: translateY(-1px);
            box-shadow: 0 10px 20px rgba(107, 15, 26, 0.3);
        }

        .form-input {
            width: 100%;
            padding: 0.75rem 1rem;
            background: #f9fafb;
            border: 1px solid #e5e7eb;
            border-radius: 0.75rem;
            font-size: 0.875rem;
            color: #374151;
            transition: all 0.2s;
            outline: none;
            font-family: 'Inter', sans-serif;
        }

        .form-input:focus {
            border-color: var(--maroon);
            box-shadow: 0 0 0 3px rgba(107, 15, 26, 0.1);
            background: white;
        }

        .form-label {
            display: block;
            font-size: 0.65rem;
            font-weight: 700;
            color: #9ca3af;
            text-transform: uppercase;
            letter-spacing: 0.1em;
            margin-bottom: 0.5rem;
        }

        .upload-zone {
            border: 2px dashed #e5e7eb;
            border-radius: 0.75rem;
            padding: 1.5rem;
            text-align: center;
            cursor: pointer;
            transition: all 0.2s;
            background: #f9fafb;
        }

        .upload-zone:hover {
            border-color: var(--maroon);
            background: rgba(107, 15, 26, 0.02);
        }

        .upload-zone input[type="file"] {
            display: none;
        }

        #cropperContainer {
            display: none;
        }

        #croppedImagePreviewContainer {
            display: none;
        }
    </style>
</head>

<body class="bg-[#f8f9fa]">
    <%- include('../partials/adminSidebar.ejs') %>
        <div class="lg:ml-64 p-6 pt-24 md:pt-6">
            <div class="max-w-xl mx-auto">
                <div class="flex justify-between items-center mb-6">
                    <div>
                        <h1 class="text-3xl font-bold text-gray-800 heading-font">Edit Category</h1>
                        <p class="text-sm text-gray-500 mt-1">Update category details.</p>
                    </div>
                    <a href="/category"
                        class="bg-white border border-gray-200 text-gray-700 px-5 py-2.5 rounded-xl text-sm font-bold hover:bg-gray-50 transition-colors flex items-center gap-2">
                        <i class="fa-solid fa-arrow-left text-xs"></i> Back
                    </a>
                </div>

                <% if (typeof error_msg !=='undefined' && error_msg) { %>
                    <div class="mb-4 p-4 bg-rose-50 border-l-4 border-rose-500 rounded-r-lg">
                        <p class="text-sm text-rose-600 font-medium">
                            <%= error_msg %>
                        </p>
                    </div>
                    <% } %>
                        <% if (typeof success_msg !=='undefined' && success_msg) { %>
                            <div class="mb-4 p-4 bg-emerald-50 border-l-4 border-emerald-500 rounded-r-lg">
                                <p class="text-sm text-emerald-600 font-medium">
                                    <%= success_msg %>
                                </p>
                            </div>
                            <% } %>

                                <div class="glass-card p-8">
                                    <form id="categoryform" action="/category/edit/<%= category._id %>" method="POST"
                                        enctype="multipart/form-data" onsubmit="return validateForm()">
                                        <div class="space-y-5">
                                            <div>
                                                <label class="form-label">Category Name</label>
                                                <input type="text" id="name" name="name" value="<%= category.name %>"
                                                    class="form-input" placeholder="e.g. Red Wine">
                                                <p id="name-error" class="text-rose-500 text-xs mt-1 hidden">Name must
                                                    be at least 3 chars and start with uppercase.</p>
                                            </div>

                                            <!-- Current Image -->
                                            <div>
                                                <label class="form-label">Current Image</label>
                                                <div
                                                    class="flex items-center gap-4 p-4 bg-gray-50 rounded-xl border border-gray-100">
                                                    <img id="currentImage" src="<%= category.imageUrl %>"
                                                        alt="<%= category.name %>"
                                                        class="w-20 h-20 object-cover rounded-xl border border-gray-200">
                                                    <div>
                                                        <p class="text-sm font-semibold text-gray-700">
                                                            <%= category.name %>
                                                        </p>
                                                        <p class="text-xs text-gray-400 mt-0.5">Current category image
                                                        </p>
                                                        <button type="button" id="deleteImageButton"
                                                            class="mt-2 text-[10px] font-bold text-rose-500 hover:text-rose-700 transition-colors uppercase tracking-widest">
                                                            <i class="fa-solid fa-trash-can mr-1"></i> Remove Image
                                                        </button>
                                                    </div>
                                                </div>
                                                <p id="image-error" class="text-rose-500 text-xs mt-1 hidden">Please
                                                    upload a category image.</p>
                                            </div>

                                            <div>
                                                <label class="form-label">Upload New Image</label>
                                                <label class="upload-zone block" for="image">
                                                    <i
                                                        class="fa-solid fa-cloud-arrow-up text-2xl text-gray-400 mb-2"></i>
                                                    <p class="text-sm font-semibold text-gray-500">Click to replace
                                                        image</p>
                                                    <input type="file" id="image" name="image" accept="image/*">
                                                </label>
                                            </div>

                                            <div id="cropperContainer" class="space-y-3">
                                                <label class="form-label">Crop Your Image</label>
                                                <div class="rounded-xl overflow-hidden border border-gray-100">
                                                    <img id="cropperImage" style="max-width: 100%;" alt="Crop" />
                                                </div>
                                                <button type="button" onclick="cropImage()"
                                                    class="btn-premium w-full py-3 rounded-xl text-xs font-bold uppercase tracking-widest">
                                                    <i class="fa-solid fa-crop-simple mr-2"></i> Crop & Confirm
                                                </button>
                                            </div>

                                            <div id="croppedImagePreviewContainer" class="space-y-2">
                                                <label class="form-label">Cropped Preview</label>
                                                <div
                                                    class="rounded-xl overflow-hidden w-32 h-32 border border-gray-100">
                                                    <img id="croppedImagePreview" class="w-full h-full object-cover"
                                                        alt="Preview" />
                                                </div>
                                                <p class="text-[10px] text-emerald-600 font-bold"><i
                                                        class="fa-solid fa-check-circle mr-1"></i>Image cropped and
                                                    ready</p>
                                            </div>

                                            <input type="hidden" id="croppedImage" name="croppedImage">
                                            <input type="hidden" name="deleteImage" id="deleteImage" value="false">

                                            <button type="submit"
                                                class="btn-premium w-full py-3.5 rounded-xl text-xs font-bold uppercase tracking-widest shadow-lg">
                                                <i class="fa-solid fa-floppy-disk mr-2"></i> Save Changes
                                            </button>
                                        </div>
                                    </form>
                                </div>
            </div>
        </div>

        <script src="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.5.13/cropper.min.js"></script>
        <script>
            let cropper;
            const imageInput = document.getElementById('image');
            const cropperImage = document.getElementById('cropperImage');
            const cropperContainer = document.getElementById('cropperContainer');
            const croppedImagePreview = document.getElementById('croppedImagePreview');
            const croppedImagePreviewContainer = document.getElementById('croppedImagePreviewContainer');
            const currentImage = document.getElementById('currentImage');
            const deleteImageInput = document.getElementById('deleteImage');

            function validateForm() {
                let isValid = true;
                const nameValue = document.getElementById('name').value.trim();
                document.getElementById('name-error').classList.add('hidden');
                document.getElementById('image-error').classList.add('hidden');
                if (nameValue.length < 3 || nameValue.charAt(0) !== nameValue.charAt(0).toUpperCase()) {
                    document.getElementById('name-error').classList.remove('hidden'); isValid = false;
                }
                return isValid;
            }

            document.getElementById('deleteImageButton').addEventListener('click', function () {
                if (confirm('Remove current image?')) {
                    currentImage.src = '';
                    currentImage.parentElement.parentElement.style.display = 'none';
                    deleteImageInput.value = 'true';
                    if (cropper) { cropper.destroy(); cropper = null; }
                }
            });

            imageInput.addEventListener('change', function (e) {
                const file = e.target.files[0];
                if (file) {
                    const reader = new FileReader();
                    reader.onload = function (event) {
                        cropperImage.src = event.target.result;
                        cropperContainer.style.display = 'block';
                        croppedImagePreviewContainer.style.display = 'none';
                        if (cropper) cropper.destroy();
                        cropper = new Cropper(cropperImage, { aspectRatio: 1, viewMode: 1, autoCropArea: 0.8 });
                        deleteImageInput.value = 'false';
                    };
                    reader.readAsDataURL(file);
                }
            });

            function cropImage() {
                if (cropper) {
                    const canvas = cropper.getCroppedCanvas({ width: 300, height: 300 });
                    canvas.toBlob((blob) => {
                        const reader = new FileReader();
                        reader.onloadend = () => {
                            document.getElementById('croppedImage').value = reader.result;
                            croppedImagePreview.src = reader.result;
                            croppedImagePreviewContainer.style.display = 'block';
                            cropperContainer.style.display = 'none';
                        };
                        reader.readAsDataURL(blob);
                    });
                }
            }
        </script>
</body>

</html>