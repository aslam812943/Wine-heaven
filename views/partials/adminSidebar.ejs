<!-- Font Awesome for Icons -->
<link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
<!-- Google Fonts -->
<link
    href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@700&family=Inter:wght@400;500;600&display=swap"
    rel="stylesheet">
<!-- Tailwind CSS -->
<link href="https://cdnjs.cloudflare.com/ajax/libs/tailwindcss/2.2.19/tailwind.min.css" rel="stylesheet">

<style>
    :root {
        --maroon: #6b0f1a;
        --maroon-dk: #18080e;
        --gold: #c9a84c;
        --sidebar-width: 260px;
    }

    #sidebar {
        background: linear-gradient(180deg, var(--maroon-dk) 0%, #2d0a0e 100%);
        width: var(--sidebar-width);
        transition: all 0.3s cubic-bezier(0.4, 0, 0.2, 1);
        border-right: 1px solid rgba(201, 168, 76, 0.1);
        z-index: 50;
    }

    .brand-section {
        padding: 2rem 1.5rem;
        border-bottom: 1px solid rgba(255, 255, 255, 0.05);
    }

    .brand-title {
        font-family: 'Playfair Display', serif;
        font-size: 1.5rem;
        color: var(--gold);
        letter-spacing: 1px;
    }

    .nav-link {
        display: flex;
        align-items: center;
        padding: 0.875rem 1.5rem;
        margin: 0.25rem 1rem;
        border-radius: 12px;
        color: rgba(255, 255, 255, 0.7);
        font-weight: 500;
        transition: all 0.2s ease;
        gap: 12px;
    }

    .nav-link i {
        font-size: 1.1rem;
        width: 24px;
        text-align: center;
    }

    .nav-link:hover {
        background: rgba(201, 168, 76, 0.1);
        color: var(--gold);
        transform: translateX(5px);
    }

    .nav-link.active {
        background: linear-gradient(90deg, rgba(201, 168, 76, 0.2) 0%, rgba(201, 168, 76, 0.05) 100%);
        color: var(--gold);
        border-left: 3px solid var(--gold);
    }

    .logout-btn {
        margin-top: auto;
        margin-bottom: 2rem;
        background: rgba(239, 68, 68, 0.1);
        color: #ef4444;
        border: 1px solid rgba(239, 68, 68, 0.2);
    }

    .logout-btn:hover {
        background: #ef4444;
        color: white;
        transform: none;
    }

    /* Mobile Header Overlay */
    @media (max-width: 768px) {
        #sidebar {
            transform: translateX(-100%);
        }

        #sidebar.active {
            transform: translateX(0);
        }
    }
</style>

<div class="flex flex-col md:flex-row">
    <!-- Sidebar -->
    <div id="sidebar" class="fixed top-0 left-0 h-screen md:block hidden overflow-y-auto">
        <div class="brand-section mb-6">
            <h2 class="brand-title flex items-center gap-3">
                <i class="fa-solid fa-wine-bottle"></i>
                Wine Heaven
            </h2>
            <p class="text-[10px] uppercase tracking-[3px] text-gray-500 mt-1 font-semibold">Admin Panel</p>
        </div>

        <nav class="flex flex-col h-[calc(100%-140px)]">
            <a href="/admin/Dashboard"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'dashboard' ? 'active' : '' %>">
                <i class="fa-solid fa-chart-pie"></i>
                <span>Dashboard</span>
            </a>
            <a href="/admin/products"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'products' ? 'active' : '' %>">
                <i class="fa-solid fa-wine-glass"></i>
                <span>Products</span>
            </a>
            <a href="/admin/customers"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'customers' ? 'active' : '' %>">
                <i class="fa-solid fa-users"></i>
                <span>Customers</span>
            </a>
            <a href="/admin/orders"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'orders' ? 'active' : '' %>">
                <i class="fa-solid fa-shopping-bag"></i>
                <span>Orders</span>
            </a>
            <a href="/admin/coupons"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'coupons' ? 'active' : '' %>">
                <i class="fa-solid fa-ticket-simple"></i>
                <span>Coupons</span>
            </a>
            <a href="/admin/sales-report"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'sales-report' ? 'active' : '' %>">
                <i class="fa-solid fa-file-invoice-dollar"></i>
                <span>Sales Report</span>
            </a>
            <a href="/admin/offers"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'offers' ? 'active' : '' %>">
                <i class="fa-solid fa-tag"></i>
                <span>Offers</span>
            </a>
            <a href="/category"
                class="nav-link <%= typeof activePage !== 'undefined' && activePage === 'category' ? 'active' : '' %>">
                <i class="fa-solid fa-layer-group"></i>
                <span>Category</span>
            </a>

            <a href="/admin/logout" class="nav-link logout-btn mt-auto">
                <i class="fa-solid fa-right-from-bracket"></i>
                <span>Logout</span>
            </a>
        </nav>
    </div>

    <!-- Mobile Header -->
    <header
        class="fixed top-0 left-0 right-0 bg-[#18080e] text-white p-4 w-full md:hidden flex justify-between items-center z-[100] border-bottom border-gray-800">
        <h2 class="brand-title text-lg flex items-center gap-2">
            <i class="fa-solid fa-wine-bottle"></i>
            Wine Heaven
        </h2>
        <button id="menuToggle" class="p-2 rounded bg-gold text-maroon-dk hover:bg-yellow-600 transition-colors">
            <i class="fa-solid fa-bars-staggered"></i>
        </button>
    </header>
</div>

<script>
    const menuToggle = document.getElementById('menuToggle');
    const sidebar = document.getElementById('sidebar');

    menuToggle.addEventListener('click', () => {
        sidebar.classList.toggle('hidden');
        sidebar.classList.toggle('active');
        sidebar.classList.toggle('block');
    });

    // Close sidebar on window resize if it was open on mobile
    window.addEventListener('resize', () => {
        if (window.innerWidth >= 768) {
            sidebar.classList.remove('active');
            sidebar.classList.add('hidden');
        }
    });

    document.querySelectorAll('.nav-link').forEach(link => {
        if (window.location.pathname === link.getAttribute('href')) {
            link.classList.add('active');
        }
    });
</script>