<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Wallet | Wine Heaven</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&display=swap"
        rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'wine-maroon': '#6b0f1a',
                        'wine-gold': '#c9a84c',
                        'wine-cream': '#fdf8f2',
                        'wine-black': '#0a0202',
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --wine-maroon: #6b0f1a;
            --wine-gold: #c9a84c;
            --wine-cream: #fdf8f2;
            --wine-black: #0a0202;
            --glass-bg: rgba(255, 255, 255, 0.05);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        body {
            background-color: var(--wine-cream);
            font-family: 'Inter', sans-serif;
            color: var(--wine-black);
            overflow-x: hidden;
        }

        .playfair {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.7);
            backdrop-filter: blur(20px);
            -webkit-backdrop-filter: blur(20px);
            border: 1px solid rgba(107, 15, 26, 0.08);
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.03);
        }

        .wine-gradient {
            background: linear-gradient(135deg, #6b0f1a 0%, #4a0a12 100%);
            position: relative;
            overflow: hidden;
        }

        .wine-gradient::before {
            content: '';
            position: absolute;
            top: -50%;
            left: -50%;
            width: 200%;
            height: 200%;
            background: radial-gradient(circle, rgba(201, 168, 76, 0.1) 0%, transparent 70%);
            animation: rotate 20s linear infinite;
        }

        @keyframes rotate {
            from {
                transform: rotate(0deg);
            }
 

            to { 
                transform: rotate(360deg);
            }
        }

        .gold-glow:hover {
            box-shadow: 0 0 25px rgba(201, 168, 76, 0.4);
            transform: translateY(-2px);
        }

        .custom-scrollbar::-webkit-scrollbar {
            width: 5px;
        }

        .custom-scrollbar::-webkit-scrollbar-track {
            background: transparent;
        }

        .custom-scrollbar::-webkit-scrollbar-thumb {
            background: var(--wine-gold);
            border-radius: 10px;
        }

        .transaction-row {
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .transaction-row:hover {
            background: rgba(107, 15, 26, 0.03);
            transform: translateX(8px);
        }

        .balance-badge {
            background: rgba(255, 255, 255, 0.15);
            backdrop-filter: blur(10px);
            border: 1px solid rgba(255, 255, 255, 0.2);
        }
    </style>
</head>

<body class="min-h-screen">
    <%- include('../partials/userHeader.ejs') %>

        <main class="container mx-auto px-4 pt-32 pb-20">
            <!-- Hero Section -->
            <div class="mb-16 text-center" data-aos="fade-down">
                <span class="text-wine-gold uppercase tracking-[0.4em] text-xs font-bold mb-3 block">Member
                    Privilege</span>
                <h1 class="playfair text-5xl md:text-6xl font-bold text-wine-black mb-6">Wallet Reserve</h1>
                <div class="w-16 h-1 bg-wine-maroon mx-auto rounded-full"></div>
            </div>

            <div class="max-w-6xl mx-auto">
                <div class="grid grid-cols-1 lg:grid-cols-12 gap-8 lg:items-start">

                    <!-- Left Sidebar: Balance & Stats -->
                    <div class="lg:col-span-4 space-y-6">
                        <!-- Premium Balance Card -->
                        <div class="wine-gradient rounded-[2.5rem] p-8 text-white shadow-2xl" data-aos="fade-right">
                            <div class="relative z-10">
                                <div class="flex justify-between items-start mb-12">
                                    <div>
                                        <p class="text-wine-gold font-bold uppercase tracking-widest text-[10px] mb-1">
                                            Available Funds</p>
                                        <h2 class="playfair text-5xl font-bold flex items-baseline">
                                            <span class="text-2xl mr-1 opacity-70">₹</span>
                                            <%= wallet && wallet.balance ? wallet.balance.toLocaleString('en-IN',
                                                {minimumFractionDigits: 0, maximumFractionDigits: 0}) : '0' %>
                                                <span class="text-xl opacity-60">.00</span>
                                        </h2>
                                    </div>
                                    <div
                                        class="w-12 h-12 bg-white/10 rounded-2xl flex items-center justify-center backdrop-blur-lg border border-white/20">
                                        <i class="fas fa-vault text-wine-gold text-xl"></i>
                                    </div>
                                </div>

                                <div class="space-y-4 pt-6 border-t border-white/10">
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-white/60 font-medium capitalize">Member Status</span>
                                        <span
                                            class="text-xs font-bold text-wine-gold bg-wine-gold/10 px-3 py-1 rounded-full border border-wine-gold/20 flex items-center">
                                            <i class="fas fa-crown mr-2 text-[10px]"></i>
                                        </span>
                                    </div>
                                    <div class="flex items-center justify-between">
                                        <span class="text-xs text-white/60 font-medium capitalize">Currency</span>
                                        <span class="text-xs font-bold text-white tracking-widest uppercase">INR</span>
                                    </div>
                                </div>
                            </div>
                        </div>

                        <!-- Enhanced Stats -->
                        <div class="grid grid-cols-1 gap-4">
                            <div class="glass-card rounded-3xl p-6 transition-all duration-300 hover:border-green-500/20"
                                data-aos="fade-up" data-aos-delay="100">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-2xl bg-green-50 flex items-center justify-center">
                                        <i class="fas fa-arrow-down-long text-green-600"></i>
                                    </div>
                                    <span class="text-[10px] font-bold text-green-600 uppercase tracking-widest">Total
                                        In</span>
                                </div>
                                <p class="text-xs text-gray-500 font-medium mb-1">Lifetime Credited</p>
                                <p class="text-2xl font-bold text-wine-black">
                                    ₹<%= wallet && wallet.transaction ? wallet.transaction.filter(t=> t.transactionType
                                        === 'Credited').reduce((sum, t) => sum + (t.wallet_amount || 0),
                                        0).toLocaleString('en-IN') : '0' %>.00
                                </p>
                            </div>

                            <div class="glass-card rounded-3xl p-6 transition-all duration-300 hover:border-red-500/20"
                                data-aos="fade-up" data-aos-delay="200">
                                <div class="flex items-center justify-between mb-4">
                                    <div class="w-12 h-12 rounded-2xl bg-red-50 flex items-center justify-center">
                                        <i class="fas fa-arrow-up-long text-red-600"></i>
                                    </div>
                                    <span class="text-[10px] font-bold text-red-600 uppercase tracking-widest">Total
                                        Out</span>
                                </div>
                                <p class="text-xs text-gray-500 font-medium mb-1">Lifetime Spent</p>
                                <p class="text-2xl font-bold text-wine-black">
                                    ₹<%= wallet && wallet.transaction ? wallet.transaction.filter(t=> t.transactionType
                                        === 'Debited').reduce((sum, t) => sum + (t.wallet_amount || 0),
                                        0).toLocaleString('en-IN') : '0' %>.00
                                </p>
                            </div>
                        </div>
                    </div>

                    <!-- Right Side: Transactions History -->
                    <div class="lg:col-span-8">
                        <div class="glass-card rounded-[2.5rem] p-8 md:p-10 min-h-[600px] flex flex-col"
                            data-aos="fade-left">
                            <div class="flex flex-col md:flex-row justify-between md:items-center gap-4 mb-10">
                                <div>
                                    <h3 class="playfair text-3xl font-bold text-wine-black mb-1">Activity Log</h3>
                                    <p class="text-xs text-gray-400 font-medium tracking-wide italic">Detailed record of
                                        your reserve movements</p>
                                </div>
                                <div class="flex gap-2">
                                    <!-- <button
                                        class="p-3 bg-white rounded-2xl border border-wine-maroon/5 text-wine-maroon hover:bg-wine-maroon hover:text-white transition-all duration-300">
                                        <i class="fas fa-download text-sm"></i>
                                    </button>
                                    <button
                                        class="px-5 py-3 bg-wine-maroon text-white rounded-2xl font-bold text-xs gold-glow transition-all duration-300 flex items-center">
                                        <i class="fas fa-filter mr-2"></i> Refine
                                    </button> -->
                                </div>
                            </div>

                            <% if (wallet && wallet.transaction && wallet.transaction.length> 0) { %>
                                <div class="flex-grow overflow-x-auto custom-scrollbar">
                                    <table class="w-full border-separate border-spacing-y-4">
                                        <thead>
                                            <tr class="text-left">
                                                <th
                                                    class="pb-2 text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] px-4">
                                                    Description</th>
                                                <th
                                                    class="pb-2 text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] px-4 hidden md:table-cell text-center">
                                                    Reference</th>
                                                <th
                                                    class="pb-2 text-[10px] font-bold text-gray-400 uppercase tracking-[0.2em] px-4 text-right">
                                                    Sum</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <% wallet.transaction.sort((a, b)=> new Date(b.transaction_date) - new
                                                Date(a.transaction_date)).forEach(function(transaction) { %>
                                                <tr class="transaction-row bg-white/40 rounded-3xl group">
                                                    <td class="py-5 px-4 rounded-l-3xl">
                                                        <div class="flex items-center">
                                                            <div
                                                                class="w-12 h-12 rounded-2xl <%= transaction.transactionType === 'Credited' ? 'bg-green-50/50 text-green-600' : 'bg-red-50/50 text-red-600' %> flex items-center justify-center mr-4 group-hover:scale-110 transition-transform duration-300">
                                                                <i
                                                                    class="fas <%= transaction.transactionType === 'Credited' ? 'fa-plus' : 'fa-minus' %> text-sm"></i>
                                                            </div>
                                                            <div>
                                                                <p class="font-bold text-wine-black text-sm mb-0.5">
                                                                    <%= transaction.transactionWay ||
                                                                        (transaction.transactionType==='Credited'
                                                                        ? 'General Credit' : 'Payment' ) %>
                                                                </p>
                                                                <p
                                                                    class="text-[10px] text-gray-400 font-bold uppercase tracking-widest">
                                                                    <%= new
                                                                        Date(transaction.transaction_date).toLocaleDateString(undefined,
                                                                        { day: '2-digit' , month: 'short' ,
                                                                        year: 'numeric' }) %>
                                                                </p>
                                                            </div>
                                                        </div>
                                                    </td>
                                                    <td class="py-5 px-4 hidden md:table-cell text-center">
                                                        <% if (transaction.order_id) { %>
                                                            <span
                                                                class="inline-flex items-center px-4 py-1.5 rounded-full text-[10px] font-bold bg-wine-maroon/5 text-wine-maroon border border-wine-maroon/10 hover:bg-wine-maroon hover:text-white transition-colors duration-300 cursor-pointer">
                                                                ID: <%=
                                                                    transaction.order_id.toString().slice(-8).toUpperCase()
                                                                    %>
                                                            </span>
                                                            <% } else { %>
                                                                <span
                                                                    class="text-[10px] font-bold text-gray-300 tracking-tighter">INTERNAL</span>
                                                                <% } %>
                                                    </td>
                                                    <td class="py-5 px-4 text-right rounded-r-3xl">
                                                        <span
                                                            class="font-bold text-sm <%= transaction.transactionType === 'Credited' ? 'text-green-600' : 'text-red-600' %> tabular-nums">
                                                            <%= transaction.transactionType==='Credited' ? '+' : '-' %>
                                                                ₹<%= transaction.wallet_amount ?
                                                                    transaction.wallet_amount.toLocaleString('en-IN')
                                                                    : '0' %>
                                                        </span>
                                                    </td>
                                                </tr>
                                                <% }); %>
                                        </tbody>
                                    </table>
                                </div>

                                <!-- Pagination -->
                                <div
                                    class="flex flex-col sm:flex-row items-center justify-between mt-10 pt-8 border-t border-wine-maroon/5 gap-6">
                                    <p class="text-[11px] text-gray-400 font-bold uppercase tracking-[0.2em]">Record <%=
                                            (page-1)*limit + 1 %> - <%= Math.min(page*limit, wallet.transaction.length)
                                                %> of <%= wallet.transaction.length %>
                                    </p>
                                    <nav class="flex items-center gap-3">
                                        <% if (page> 1) { %>
                                            <a href="/wallet?page=<%= page - 1 %>&limit=<%= limit %>"
                                                class="w-10 h-10 flex items-center justify-center rounded-2xl bg-white border border-wine-maroon/10 text-wine-maroon hover:bg-wine-maroon hover:text-white transition-all duration-300 shadow-sm">
                                                <i class="fas fa-angle-left text-xs"></i>
                                            </a>
                                            <% } %>

                                                <% for (let i=1; i <=totalpages; i++) { %>
                                                    <a href="/wallet?page=<%= i %>&limit=<%= limit %>"
                                                        class="w-10 h-10 flex items-center justify-center rounded-2xl font-bold text-[11px] transition-all duration-500 <%= i === page ? 'bg-wine-maroon text-white shadow-lg shadow-wine-maroon/20 scale-110' : 'bg-white border border-wine-maroon/10 text-wine-maroon hover:bg-wine-maroon/5' %>">
                                                        <%= i %>
                                                    </a>
                                                    <% } %>

                                                        <% if (page < totalpages) { %>
                                                            <a href="/wallet?page=<%= page + 1 %>&limit=<%= limit %>"
                                                                class="w-10 h-10 flex items-center justify-center rounded-2xl bg-white border border-wine-maroon/10 text-wine-maroon hover:bg-wine-maroon hover:text-white transition-all duration-300 shadow-sm">
                                                                <i class="fas fa-angle-right text-xs"></i>
                                                            </a>
                                                            <% } %>
                                    </nav>
                                </div>
                                <% } else { %>
                                    <div class="flex-grow flex flex-col items-center justify-center py-20 text-center">
                                        <div
                                            class="w-32 h-32 bg-wine-cream rounded-[2.5rem] flex items-center justify-center mb-8 relative">
                                            <div
                                                class="absolute inset-0 bg-wine-gold/10 rounded-[2.5rem] animate-ping opacity-20">
                                            </div>
                                            <i class="fas fa-wine-glass-empty text-5xl text-wine-gold/30"></i>
                                        </div>
                                        <h4 class="playfair text-2xl font-bold text-wine-black mb-3">No Transactions
                                            Recorded</h4>
                                        <p class="text-gray-400 max-w-xs text-sm font-medium leading-relaxed">Your
                                            reserve activity is currently empty. Complete an order or process a refund
                                            to see activity here.</p>
                                        <a href="/wines"
                                            class="mt-10 px-10 py-4 bg-wine-maroon text-white rounded-2xl font-bold text-xs hover:transform hover:-translate-y-1 transition-all duration-300 shadow-xl gold-glow uppercase tracking-widest">
                                            Store Collection
                                        </a>
                                    </div>
                                    <% } %>
                        </div>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../partials/userFooter.ejs') %>

            <script>
                AOS.init({
                    duration: 1000,
                    once: true,
                    easing: 'ease-out-expo'
                });
            </script>
</body>

</html>