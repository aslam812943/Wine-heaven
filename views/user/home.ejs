<%-include('../partials/userHeader.ejs')%>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <style>
        :root {
            --wine-maroon: #6b0f1a;
            --wine-maroon-dark: #4a0a12;
            --wine-gold: #c9a84c;
            --wine-cream: #fdf8f2;
            --wine-black: #0a0202;
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        .smooth-scroll {
            scroll-behavior: smooth;
        }

        body {
            margin: 0;
            padding-top: 0 !important;
            background-color: var(--wine-black);
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            overflow-x: hidden;
            color: #f5f0eb;
        }

        h1,
        h2,
        h3,
        .playfair {
            font-family: 'Playfair Display', Georgia, serif;
        }

        /* ═══════════════════════ HERO SECTION ═══════════════════════ */
        .hero-section {
            position: relative;
            min-height: 100vh;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #080103;
            padding: calc(var(--nav-h) + 15px) 24px 60px;
            box-sizing: border-box;
        }

        .bg-video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            object-fit: cover;
            z-index: 0;
            filter: brightness(0.62) contrast(1.15) saturate(1.1);
            pointer-events: none;
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background:
                linear-gradient(180deg,
                    rgba(10, 2, 4, 0.75) 0%,
                    rgba(10, 2, 4, 0.25) 25%,
                    rgba(10, 2, 4, 0.35) 60%,
                    rgba(10, 2, 4, 0.95) 100%),
                radial-gradient(ellipse at 50% 50%,
                    rgba(14, 2, 6, 0.12) 0%,
                    rgba(8, 1, 3, 0.75) 100%);
            z-index: 1;
            pointer-events: none;
        }

        .hero-content {
            position: relative;
            z-index: 10;
            color: #fff;
            max-width: 960px;
            width: 100%;
            margin: 0 auto;
            text-align: center;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
        }

        /* Eyebrow badge */
        .hero-eyebrow {
            display: inline-flex;
            align-items: center;
            gap: 16px;
            margin-bottom: 1.4rem;
        }

        .hero-eyebrow-line {
            width: 44px;
            height: 1px;
            background: linear-gradient(90deg, transparent, rgba(201, 168, 76, 0.8));
        }

        .hero-eyebrow-line.reverse {
            background: linear-gradient(90deg, rgba(201, 168, 76, 0.8), transparent);
        }

        .hero-eyebrow-badge {
            display: inline-flex;
            align-items: center;
            gap: 8px;
            padding: 6px 18px;
            background: rgba(201, 168, 76, 0.08);
            border: 1px solid rgba(201, 168, 76, 0.32);
            border-radius: 999px;
            backdrop-filter: blur(12px);
            -webkit-backdrop-filter: blur(12px);
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.72rem;
            font-weight: 600;
            letter-spacing: 2.8px;
            text-transform: uppercase;
            color: var(--wine-gold);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.35);
        }

        .hero-eyebrow-badge i {
            font-size: 0.75rem;
            color: var(--wine-gold);
        }

        /* Hero Typography */
        .hero-title {
            font-family: 'Playfair Display', Georgia, serif;
            margin: 0 0 1.4rem;
            line-height: 1.1;
            text-align: center;
            text-shadow: 0 4px 30px rgba(0, 0, 0, 0.7);
        }

        .hero-title-prefix {
            display: block;
            font-size: clamp(2rem, 4.4vw, 3.8rem);
            font-weight: 500;
            color: #fbf7f0;
            letter-spacing: -0.01em;
            margin-bottom: 0.12em;
        }

        .hero-title-highlight {
            display: block;
            font-style: italic;
            font-weight: 700;
            font-size: clamp(3rem, 7.5vw, 5.8rem);
            line-height: 1.05;
            background: linear-gradient(135deg, #ffffff 0%, #faecd0 30%, #dfbe64 60%, #c9a84c 85%, #9e7926 100%);
            -webkit-background-clip: text;
            -webkit-text-fill-color: transparent;
            filter: drop-shadow(0 8px 32px rgba(0, 0, 0, 0.8));
        }

        .hero-subtitle {
            font-family: 'Plus Jakarta Sans', 'Inter', sans-serif;
            font-size: clamp(1rem, 1.7vw, 1.22rem);
            font-weight: 300;
            line-height: 1.7;
            color: rgba(253, 248, 242, 0.88);
            max-width: 680px;
            margin: 0 auto 2.2rem;
            letter-spacing: 0.2px;
            text-shadow: 0 2px 16px rgba(0, 0, 0, 0.8);
        }

        /* Hero Actions */
        .hero-cta-group {
            display: flex;
            flex-direction: row;
            align-items: center;
            justify-content: center;
            gap: 18px;
            margin-bottom: 2.5rem;
        }

        @media (max-width: 540px) {
            .hero-cta-group {
                flex-direction: column;
                width: 100%;
                gap: 12px;
            }
        }

        .hero-cta-primary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            padding: 16px 36px;
            background: linear-gradient(135deg, #dfbe64 0%, #c9a84c 50%, #9e7926 100%);
            color: #0b0204;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.85rem;
            font-weight: 700;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            border-radius: 999px;
            text-decoration: none;
            box-shadow: 0 10px 30px rgba(201, 168, 76, 0.35);
            border: 1px solid rgba(255, 255, 255, 0.25);
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
            position: relative;
            overflow: hidden;
        }

        .hero-cta-primary::before {
            content: '';
            position: absolute;
            inset: 0;
            background: linear-gradient(90deg, transparent, rgba(255, 255, 255, 0.3), transparent);
            transform: translateX(-100%);
            transition: transform 0.6s ease;
        }

        .hero-cta-primary:hover {
            transform: translateY(-4px);
            box-shadow: 0 16px 40px rgba(201, 168, 76, 0.55);
            color: #000;
        }

        .hero-cta-primary:hover::before {
            transform: translateX(100%);
        }

        .hero-cta-primary i {
            transition: transform 0.3s ease;
        }

        .hero-cta-primary:hover i {
            transform: translateX(5px);
        }

        .hero-cta-secondary {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            gap: 10px;
            padding: 16px 34px;
            background: rgba(255, 255, 255, 0.05);
            backdrop-filter: blur(14px);
            -webkit-backdrop-filter: blur(14px);
            border: 1px solid rgba(255, 255, 255, 0.25);
            color: #ffffff;
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.85rem;
            font-weight: 600;
            letter-spacing: 1.8px;
            text-transform: uppercase;
            border-radius: 999px;
            text-decoration: none;
            transition: all 0.35s cubic-bezier(0.4, 0, 0.2, 1);
        }

        .hero-cta-secondary:hover {
            background: rgba(201, 168, 76, 0.12);
            border-color: var(--wine-gold);
            color: var(--wine-gold);
            transform: translateY(-4px);
            box-shadow: 0 12px 30px rgba(0, 0, 0, 0.4);
        }

        /* Prestige Credential Strip */
        .hero-prestige-strip {
            display: inline-flex;
            align-items: center;
            gap: 28px;
            padding: 12px 28px;
            background: rgba(14, 2, 6, 0.55);
            backdrop-filter: blur(16px);
            -webkit-backdrop-filter: blur(16px);
            border: 1px solid rgba(201, 168, 76, 0.2);
            border-radius: 999px;
            box-shadow: 0 10px 30px rgba(0, 0, 0, 0.4);
            max-width: 90%;
        }

        @media (max-width: 768px) {
            .hero-prestige-strip {
                display: none;
            }
        }

        .prestige-card {
            display: flex;
            align-items: center;
            gap: 10px;
            text-align: left;
        }

        .prestige-icon {
            width: 28px;
            height: 28px;
            border-radius: 50%;
            background: rgba(201, 168, 76, 0.12);
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--wine-gold);
            font-size: 0.75rem;
        }

        .prestige-meta {
            display: flex;
            flex-direction: column;
        }

        .prestige-value {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.78rem;
            font-weight: 700;
            color: #ffffff;
            letter-spacing: 0.5px;
            line-height: 1.1;
        }

        .prestige-desc {
            font-family: 'Plus Jakarta Sans', sans-serif;
            font-size: 0.65rem;
            color: rgba(255, 255, 255, 0.65);
            letter-spacing: 0.3px;
            margin-top: 2px;
        }

        .prestige-divider {
            width: 1px;
            height: 24px;
            background: rgba(201, 168, 76, 0.25);
        }

        /* Scroll Down */
        .hero-scroll {
            position: absolute;
            bottom: 24px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            display: flex;
            flex-direction: column;
            align-items: center;
            gap: 6px;
            text-decoration: none;
            opacity: 0.85;
            transition: opacity 0.3s ease, transform 0.3s ease;
        }

        .hero-scroll:hover {
            opacity: 1;
            transform: translateX(-50%) translateY(3px);
        }

        .hero-scroll-track {
            width: 22px;
            height: 36px;
            border: 1.5px solid rgba(201, 168, 76, 0.5);
            border-radius: 12px;
            position: relative;
            background: rgba(14, 2, 6, 0.4);
            backdrop-filter: blur(6px);
        }

        .hero-scroll-dot {
            width: 4px;
            height: 7px;
            background: var(--wine-gold);
            border-radius: 2px;
            position: absolute;
            top: 7px;
            left: 50%;
            transform: translateX(-50%);
            animation: heroScrollDrop 2s cubic-bezier(0.4, 0, 0.2, 1) infinite;
        }

        @keyframes heroScrollDrop {
            0% {
                transform: translate(-50%, 0);
                opacity: 0;
            }

            30% {
                opacity: 1;
            }

            100% {
                transform: translate(-50%, 15px);
                opacity: 0;
            }
        }

        /* Section Headlines */
        .section-tag {
            color: var(--wine-gold);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 4px;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            display: block;
            text-align: center;
        }

        .section-title {
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 700;
            color: var(--wine-black);
            text-align: center;
            margin-bottom: 4rem;
        }

        .show-all-container {
            display: flex;
            justify-content: center;
            margin-top: 5rem;
        }

        .btn-premium-outline {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 40px;
            border: 1px solid var(--wine-gold);
            color: var(--wine-gold);
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            text-decoration: none;
            letter-spacing: 1px;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            background: transparent;
        }

        .btn-premium-outline:hover {
            background: var(--wine-gold);
            color: #fff;
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(201, 168, 76, 0.3);
        }

        .btn-icon {
            transition: transform 0.4s ease;
        }

        .btn-premium-outline:hover .btn-icon {
            transform: translateX(8px);
        }
    </style>

    <!-- Hero Section -->
    <section class="hero-section">
        <video autoplay muted loop playsinline class="bg-video">
            <source src="/uplods/mixkit-pouring-red-wine-from-a-bottle-very-close-view-22734-full-hd.mp4"
                type="video/mp4">
        </video>
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <!-- Eyebrow Badge -->
            <div class="hero-eyebrow" data-aos="fade-down" data-aos-duration="900">
                <span class="hero-eyebrow-line"></span>
                <span class="hero-eyebrow-badge">
                    <i class="fa-solid fa-crown"></i>
                    <span>Private Cellar &bull; Grand Cru Reserve</span>
                </span>
                <span class="hero-eyebrow-line reverse"></span>
            </div>

            <!-- Elevated Editorial Typography -->
            <h1 class="hero-title" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="150">
                <span class="hero-title-prefix">Experience the Essence of</span>
                <span class="hero-title-highlight">Fine Living</span>
            </h1>

            <!-- Subtitle -->
            <p class="hero-subtitle" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="300">
                Curating the world’s most exquisite terroirs, rare library vintages, and legendary châteaux for the discerning palate.
            </p>

            <!-- Refined Actions -->
            <div class="hero-cta-group" data-aos="fade-up" data-aos-duration="1000" data-aos-delay="450">
                <a href="#categories" class="hero-cta-primary">
                    <span>Explore Collection</span>
                    <i class="fa-solid fa-arrow-right-long"></i>
                </a>
                <a href="/about" class="hero-cta-secondary">
                    <i class="fa-regular fa-compass"></i>
                    <span>Our Story</span>
                </a>
            </div>

            <!-- Sommelier Prestige Strip -->
            <div class="hero-prestige-strip" data-aos="fade-up" data-aos-duration="1100" data-aos-delay="600">
                <div class="prestige-card">
                    <div class="prestige-icon"><i class="fa-solid fa-shield-halved"></i></div>
                    <div class="prestige-meta">
                        <span class="prestige-value">100% Provenance</span>
                        <span class="prestige-desc">Direct Château Sourcing</span>
                    </div>
                </div>
                <div class="prestige-divider"></div>
                <div class="prestige-card">
                    <div class="prestige-icon"><i class="fa-solid fa-temperature-arrow-down"></i></div>
                    <div class="prestige-meta">
                        <span class="prestige-value">12°C Cellared</span>
                        <span class="prestige-desc">Climate-Controlled Vaults</span>
                    </div>
                </div>
                <div class="prestige-divider"></div>
                <div class="prestige-card">
                    <div class="prestige-icon"><i class="fa-solid fa-wine-glass"></i></div>
                    <div class="prestige-meta">
                        <span class="prestige-value">Sommelier Rated</span>
                        <span class="prestige-desc">Master Cellar Selection</span>
                    </div>
                </div>
            </div>
        </div>

        <!-- Scroll Indicator -->
        <a href="#categories" id="scrollLink" class="hero-scroll" aria-label="Scroll to wine collection">
            <div class="hero-scroll-track">
                <div class="hero-scroll-dot"></div>
            </div>
        </a>
    </section>

    <style>
        /* Categories Section */
        .categories-section {
            padding: 100px 20px;
            background: var(--wine-black);
            position: relative;
        }

        .categories-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .categories-inner {
            display: flex;
            gap: 30px;
            overflow-x: auto;
            scroll-behavior: smooth;
            padding: 20px 0 40px;
            scrollbar-width: none;

        }

        .categories-inner::-webkit-scrollbar {
            display: none;

        }

        .category-card {
            flex: 0 0 320px;
            height: 450px;
            border-radius: 24px;
            overflow: hidden;
            position: relative;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .category-card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
        }

        .category-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
        }

        .category-card:hover img {
            transform: scale(1.1);
        }

        .category-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(10, 2, 2, 0.9) 0%, rgba(10, 2, 2, 0) 60%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 40px;
        }

        .category-name {
            font-size: 1.8rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
        }

        .category-btn {
            font-size: 0.8rem;
            color: var(--wine-gold);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0.8;
            transition: all 0.3s ease;
        }

        .category-card:hover .category-btn {
            opacity: 1;
            gap: 15px;
        }

        /* Products Section Refined */
        .products-section {
            padding: 80px 20px;
            background: var(--wine-cream);
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 30px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .product-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
            border: 1px solid rgba(107, 15, 26, 0.05);
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(107, 15, 26, 0.12);
            border-color: rgba(201, 168, 76, 0.25);
        }

        .product-media {
            height: 280px;

            position: relative;
            overflow: hidden;
            background: #fdfdfd;
        }

        .product-media img {
            width: 100%;
            height: 100%;
            object-fit: contain;

            padding: 20px;
            transition: transform 0.6s ease;
        }

        .product-card:hover .product-media img {
            transform: scale(1.05) translateY(-5px);
        }


        .card-actions-bar {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            display: flex;
            gap: 10px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            padding: 8px 15px;
            border-radius: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 5;
        }

        .product-card:hover .card-actions-bar {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .bar-action {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--wine-maroon);
            transition: all 0.2s ease;
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
        }

        .bar-action:hover {
            background: var(--wine-maroon);
            color: #fff;
            transform: scale(1.15);
        }

        .product-info {
            padding: 20px;
            text-align: center;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: linear-gradient(to bottom, #fff, #fffafb);
        }

        .product-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--wine-black);
            margin-bottom: 5px;
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.3s;
        }

        .product-name:hover {
            color: var(--wine-maroon);
        }

        .product-price {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--wine-maroon);
            margin-bottom: 12px;
            display: block;
        }

        .view-link {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            color: var(--wine-gold);
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin: 0 auto;
            position: relative;
            padding-bottom: 4px;
        }

        .view-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 1.5px;
            background: var(--wine-gold);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s ease;
        }

        .product-card:hover .view-link::after {
            transform: scaleX(1);
            transform-origin: left;
        }

        .view-link i {
            font-size: 10px;
            transition: transform 0.3s;
        }

        .product-card:hover .view-link i {
            transform: translateX(3px);
        }
    </style>

    <!-- Categories Section -->
    <section id="categories" class="categories-section">
        <div class="categories-container">
            <span class="section-tag" data-aos="fade-up">Curated Collections</span>
            <h2 class="section-title text-white" data-aos="fade-up" data-aos-delay="100">Our Fine Vintages</h2>

            <div class="categories-inner" data-aos="fade-left" data-aos-delay="200">
                <% categories.forEach((category, i)=> { %>
                    <a href="/categorys/<%= category._id %>" class="category-card" data-aos="fade-up"
                        data-aos-delay="<%= 100 * (i + 1) %>">
                        <img src="<%= category.imageUrl %>" alt="<%= category.name %>" loading="lazy">
                        <div class="category-overlay">
                            <h3 class="category-name">
                                <%= category.name %>
                            </h3>
                            <span class="category-btn">
                                Explore <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                    <% }); %>
            </div>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section id="produc" class="products-section">
        <div class="container mx-auto">
            <span class="section-tag" data-aos="fade-up">Seasonal Highlights</span>
            <h2 class="section-title" data-aos="fade-up" data-aos-delay="100">Masterpiece Selection</h2>

            <div class="product-grid">
                <% products.forEach((product, i)=> { %>
                    <div class="product-card" data-aos="fade-up" data-aos-delay="<%= 100 * (i % 4) %>">
                        <div class="product-media">
                            <img src="<%= (product.images && product.images.length > 0) ? (product.images[0].startsWith('http') ? product.images[0] : '/uploads/' + product.images[0]) : '/assets/img/no-image.png' %>"
                                alt="<%= product.name %>" loading="lazy">
                            <div class="card-actions-bar">
                                <button onclick="addToWishlist('<%= product._id%>', this)" class="bar-action"
                                    title="Add to Wishlist">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                                <button onclick="addtocart('<%= product._id%>', this)" class="bar-action"
                                    title="Add to Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </button>
                            </div>
                        </div>
                        <div class="product-info">
                            <div>
                                <a href="/wine/<%= product._id %>" class="product-name">
                                    <%= product.name %>
                                </a>
                                <span class="product-price">₹<%= product.price %></span>
                            </div>
                            <a href="/wine/<%= product._id %>" class="view-link">
                                Discover <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                    <% }); %>
            </div>

            <% if (showAllButton) { %>
                <div class="show-all-container" data-aos="fade-up">
                    <a href="/wines" class="btn-premium-outline">
                        View All Masterpieces
                        <span class="btn-icon"><i class="fa-solid fa-arrow-right-long"></i></span>
                    </a>
                </div>
                <% } %>
        </div>
    </section>

    <script>
        // Initialize AOS
        AOS.init({
            duration: 1200,
            once: true,
            offset: 100,
            easing: 'ease-out-cubic'
        });

        // Smooth Scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);

                if (targetElement) {
                    window.scrollTo({
                        top: targetElement.offsetTop - 80,
                        behavior: 'smooth'
                    });
                }
            });
        });

        async function addtocart(productId, target) {
            try {
                const response = await fetch('/cartt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId }),
                });

                if (response.ok) {
                    showToast('success', 'Selection Added to cart');
                } else {
                    const error = await response.json();
                    showToast('info', error.message || 'Unable to add this selection.');
                }
            } catch (error) {
                console.error("Fetch error:", error);
                showToast('error', 'An unexpected error occurred.');
            }
        }

        async function addToWishlist(productId, target) {
            try {
                const response = await fetch('/wishlistt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId }),
                });

                if (response.ok) {
                    const data = await response.json();
                    showToast(data.action === 'added' ? 'success' : 'info', data.message);
                } else {
                    const error = await response.json();
                    showToast('error', error.message || 'Failed to update your list.');
                }
            } catch (error) {
                console.error('Error:', error);
                showToast('error', 'An unexpected error occurred.');
            }
        }

        // --- SEAMLESS INFINITE SCROLL FOR CATEGORIES ---
        const categoriesInner = document.querySelector('.categories-inner');
        if (categoriesInner) {

            const items = [...categoriesInner.children];
            items.forEach(item => {
                const clone = item.cloneNode(true);
                categoriesInner.appendChild(clone);
            });

            let isHovered = false;
            let scrollAmount = 0;
            const scrollSpeed = 0.8; // Pixels per frame

            categoriesInner.addEventListener('mouseenter', () => isHovered = true);
            categoriesInner.addEventListener('mouseleave', () => isHovered = false);

            function step() {
                if (!isHovered) {
                    scrollAmount += scrollSpeed;


                    const originalWidth = categoriesInner.scrollWidth / 2;

                    if (scrollAmount >= originalWidth) {
                        scrollAmount = 0;
                    }

                    categoriesInner.scrollLeft = scrollAmount;
                }
                requestAnimationFrame(step);
            }

            requestAnimationFrame(step);
        }
    </script>

    <%-include('../partials/userFooter.ejs')%>