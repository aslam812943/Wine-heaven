<%-include('../partials/userHeader.ejs')%>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <style>
        :root {
            --wine-maroon: #6b0f1a;
            --wine-maroon-dark: #4a0a12;
            --wine-gold: #c9a84c;
            --wine-cream: #fdf8f2;
            --wine-black: #0a0202;
            --glass-bg: rgba(255, 255, 255, 0.03);
            --glass-border: rgba(255, 255, 255, 0.1);
        }

        .smooth-scroll {
            scroll-behavior: smooth;
        }

        body {
            background-color: var(--wine-cream);
            font-family: 'Inter', sans-serif;
            overflow-x: hidden;
        }

        h1,
        h2,
        h3,
        .playfair {
            font-family: 'Playfair Display', serif;
        }

        /* Hero Section */
        .hero-section {
            position: relative;
            height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            background: #000;
        }

        .bg-video {
            position: absolute;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
            min-width: 100%;
            min-height: 100%;
            width: auto;
            height: auto;
            object-fit: cover;
            z-index: 0;
            filter: brightness(0.6) contrast(1.1);
        }

        .hero-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to bottom,
                    rgba(10, 2, 2, 0.4) 0%,
                    rgba(10, 2, 2, 0.6) 100%);
            z-index: 1;
        }

        .hero-content {
            position: relative;
            z-index: 10;
            color: #fff;
            max-width: 900px;
            padding: 0 20px;
            text-align: center;
        }

        .hero-title {
            font-size: clamp(2.5rem, 8vw, 5rem);
            font-weight: 700;
            line-height: 1.1;
            margin-bottom: 1.5rem;
            opacity: 0;
            transform: translateY(30px);
            animation: fadeInUp 1.2s cubic-bezier(0.2, 0.6, 0.2, 1) forwards;
        }

        .hero-subtitle {
            font-size: clamp(1.1rem, 3vw, 1.5rem);
            font-weight: 400;
            color: rgba(255, 255, 255, 0.9);
            margin-bottom: 2.5rem;
            letter-spacing: 1px;
            opacity: 0;
            transform: translateY(20px);
            animation: fadeInUp 1.2s cubic-bezier(0.2, 0.6, 0.2, 1) 0.3s forwards;
        }

        @keyframes fadeInUp {
            to {
                opacity: 1;
                transform: translateY(0);
            }
        }

        .btn-premium {
            display: inline-flex;
            align-items: center;
            justify-content: center;
            padding: 16px 36px;
            font-size: 0.95rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 2px;
            border-radius: 50px;
            transition: all 0.4s cubic-bezier(0.4, 0, 0.2, 1);
            text-decoration: none;
            position: relative;
            overflow: hidden;
        }

        .btn-gold {
            background: linear-gradient(135deg, var(--wine-gold), #a07828);
            color: white;
            box-shadow: 0 10px 25px rgba(201, 168, 76, 0.3);
            border: none;
        }

        .btn-gold:hover {
            transform: translateY(-5px);
            box-shadow: 0 15px 35px rgba(201, 168, 76, 0.45);
            background: linear-gradient(135deg, #d4ba70, var(--wine-gold));
        }

        .btn-outline-white {
            border: 2px solid rgba(255, 255, 255, 0.8);
            color: white;
            margin-left: 1rem;
        }

        .btn-outline-white:hover {
            background: white;
            color: var(--wine-black);
            transform: translateY(-5px);
        }

        .scroll-down {
            position: absolute;
            bottom: 40px;
            left: 50%;
            transform: translateX(-50%);
            z-index: 10;
            cursor: pointer;
            transition: all 0.3s ease;
        }

        .scroll-down:hover {
            bottom: 30px;
        }

        .scroll-mouse {
            width: 26px;
            height: 42px;
            border: 2px solid rgba(255, 255, 255, 0.5);
            border-radius: 13px;
            position: relative;
        }

        .scroll-dot {
            width: 4px;
            height: 8px;
            background: var(--wine-gold);
            border-radius: 2px;
            position: absolute;
            top: 8px;
            left: 50%;
            margin-left: -2px;
            animation: scrollMove 2s infinite;
        }

        @keyframes scrollMove {
            0% {
                transform: translateY(0);
                opacity: 0;
            }

            30% {
                opacity: 1;
            }

            100% {
                transform: translateY(18px);
                opacity: 0;
            }
        }

        /* Section Headlines */
        .section-tag {
            color: var(--wine-gold);
            text-transform: uppercase;
            font-weight: 700;
            letter-spacing: 4px;
            font-size: 0.85rem;
            margin-bottom: 1rem;
            display: block;
            text-align: center;
        }

        .section-title {
            font-size: clamp(2rem, 5vw, 3.5rem);
            font-weight: 700;
            color: var(--wine-black);
            text-align: center;
            margin-bottom: 4rem;
        }

        .show-all-container {
            display: flex;
            justify-content: center;
            margin-top: 5rem;
        }

        .btn-premium-outline {
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 16px 40px;
            border: 1px solid var(--wine-gold);
            color: var(--wine-gold);
            font-family: 'Playfair Display', serif;
            font-weight: 600;
            text-decoration: none;
            letter-spacing: 1px;
            transition: all 0.4s ease;
            position: relative;
            overflow: hidden;
            background: transparent;
        }

        .btn-premium-outline:hover {
            background: var(--wine-gold);
            color: #fff;
            transform: translateY(-5px);
            box-shadow: 0 10px 30px rgba(201, 168, 76, 0.3);
        }

        .btn-icon {
            transition: transform 0.4s ease;
        }

        .btn-premium-outline:hover .btn-icon {
            transform: translateX(8px);
        }
    </style>

    <!-- Hero Section -->
    <section class="hero-section">
        <video autoplay muted loop playsinline class="bg-video">
            <source src="/uplods/mixkit-pouring-red-wine-from-a-bottle-very-close-view-22734-full-hd.mp4"
                type="video/mp4">
        </video>
        <div class="hero-overlay"></div>

        <div class="hero-content">
            <h1 class="hero-title">Experience the Essence of Fine Living</h1>
            <p class="hero-subtitle">Curating the world's most exquisite vintages for the discerning palate.</p>
            <div class="flex flex-col sm:flex-row justify-center items-center gap-6">
                <a href="#categories" class="btn-premium btn-gold">
                    Explore Collection
                </a>
                <a href="/about" class="btn-premium btn-outline-white">
                    Our Story
                </a>
            </div>
        </div>

        <a href="#produc" id="scrollLink" class="scroll-down">
            <div class="scroll-mouse">
                <div class="scroll-dot"></div>
            </div>
        </a>
    </section>

    <style>
        /* Categories Section */
        .categories-section {
            padding: 100px 20px;
            background: var(--wine-black);
            position: relative;
        }

        .categories-container {
            max-width: 1400px;
            margin: 0 auto;
        }

        .categories-inner {
            display: flex;
            gap: 30px;
            overflow-x: auto;
            scroll-behavior: smooth;
            padding: 20px 0 40px;
            scrollbar-width: none;

        }

        .categories-inner::-webkit-scrollbar {
            display: none;

        }

        .category-card {
            flex: 0 0 320px;
            height: 450px;
            border-radius: 24px;
            overflow: hidden;
            position: relative;
            transition: all 0.5s cubic-bezier(0.4, 0, 0.2, 1);
            cursor: pointer;
            box-shadow: 0 20px 40px rgba(0, 0, 0, 0.4);
        }

        .category-card:hover {
            transform: translateY(-15px) scale(1.02);
            box-shadow: 0 30px 60px rgba(0, 0, 0, 0.6);
        }

        .category-card img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform 0.8s ease;
        }

        .category-card:hover img {
            transform: scale(1.1);
        }

        .category-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(10, 2, 2, 0.9) 0%, rgba(10, 2, 2, 0) 60%);
            display: flex;
            flex-direction: column;
            justify-content: flex-end;
            padding: 40px;
        }

        .category-name {
            font-size: 1.8rem;
            font-weight: 700;
            color: #fff;
            margin-bottom: 10px;
        }

        .category-btn {
            font-size: 0.8rem;
            color: var(--wine-gold);
            text-transform: uppercase;
            letter-spacing: 2px;
            font-weight: 700;
            display: flex;
            align-items: center;
            gap: 10px;
            opacity: 0.8;
            transition: all 0.3s ease;
        }

        .category-card:hover .category-btn {
            opacity: 1;
            gap: 15px;
        }

        /* Products Section Refined */
        .products-section {
            padding: 80px 20px;
            background: var(--wine-cream);
        }

        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(240px, 1fr));
            gap: 30px;
            max-width: 1400px;
            margin: 0 auto;
        }

        .product-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
            border: 1px solid rgba(107, 15, 26, 0.05);
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(107, 15, 26, 0.12);
            border-color: rgba(201, 168, 76, 0.25);
        }

        .product-media {
            height: 280px;

            position: relative;
            overflow: hidden;
            background: #fdfdfd;
        }

        .product-media img {
            width: 100%;
            height: 100%;
            object-fit: contain;

            padding: 20px;
            transition: transform 0.6s ease;
        }

        .product-card:hover .product-media img {
            transform: scale(1.05) translateY(-5px);
        }


        .card-actions-bar {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            display: flex;
            gap: 10px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            padding: 8px 15px;
            border-radius: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 5;
        }

        .product-card:hover .card-actions-bar {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .bar-action {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--wine-maroon);
            transition: all 0.2s ease;
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
        }

        .bar-action:hover {
            background: var(--wine-maroon);
            color: #fff;
            transform: scale(1.15);
        }

        .product-info {
            padding: 20px;
            text-align: center;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: linear-gradient(to bottom, #fff, #fffafb);
        }

        .product-name {
            font-size: 1.15rem;
            font-weight: 700;
            color: var(--wine-black);
            margin-bottom: 5px;
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.3s;
        }

        .product-name:hover {
            color: var(--wine-maroon);
        }

        .product-price {
            font-size: 1.1rem;
            font-weight: 600;
            color: var(--wine-maroon);
            margin-bottom: 12px;
            display: block;
        }

        .view-link {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            color: var(--wine-gold);
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin: 0 auto;
            position: relative;
            padding-bottom: 4px;
        }

        .view-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 1.5px;
            background: var(--wine-gold);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s ease;
        }

        .product-card:hover .view-link::after {
            transform: scaleX(1);
            transform-origin: left;
        }

        .view-link i {
            font-size: 10px;
            transition: transform 0.3s;
        }

        .product-card:hover .view-link i {
            transform: translateX(3px);
        }
    </style>

    <!-- Categories Section -->
    <section id="categories" class="categories-section">
        <div class="categories-container">
            <span class="section-tag" data-aos="fade-up">Curated Collections</span>
            <h2 class="section-title text-white" data-aos="fade-up" data-aos-delay="100">Our Fine Vintages</h2>

            <div class="categories-inner" data-aos="fade-left" data-aos-delay="200">
                <% categories.forEach((category, i)=> { %>
                    <a href="/categorys/<%= category._id %>" class="category-card" data-aos="fade-up"
                        data-aos-delay="<%= 100 * (i + 1) %>">
                        <img src="<%= category.imageUrl %>" alt="<%= category.name %>" loading="lazy">
                        <div class="category-overlay">
                            <h3 class="category-name">
                                <%= category.name %>
                            </h3>
                            <span class="category-btn">
                                Explore <i class="fa-solid fa-arrow-right"></i>
                            </span>
                        </div>
                    </a>
                    <% }); %>
            </div>
        </div>
    </section>

    <!-- Featured Products Section -->
    <section id="produc" class="products-section">
        <div class="container mx-auto">
            <span class="section-tag" data-aos="fade-up">Seasonal Highlights</span>
            <h2 class="section-title" data-aos="fade-up" data-aos-delay="100">Masterpiece Selection</h2>

            <div class="product-grid">
                <% products.forEach((product, i)=> { %>
                    <div class="product-card" data-aos="fade-up" data-aos-delay="<%= 100 * (i % 4) %>">
                        <div class="product-media">
                            <img src="<%= (product.images && product.images.length > 0) ? (product.images[0].startsWith('http') ? product.images[0] : '/uploads/' + product.images[0]) : '/assets/img/no-image.png' %>"
                                alt="<%= product.name %>" loading="lazy">
                            <div class="card-actions-bar">
                                <button onclick="addToWishlist('<%= product._id%>', this)" class="bar-action"
                                    title="Add to Wishlist">
                                    <i class="fa-regular fa-heart"></i>
                                </button>
                                <button onclick="addtocart('<%= product._id%>', this)" class="bar-action"
                                    title="Add to Cart">
                                    <i class="fa-solid fa-cart-shopping"></i>
                                </button>
                            </div>
                        </div>
                        <div class="product-info">
                            <div>
                                <a href="/products/<%= product._id %>" class="product-name">
                                    <%= product.name %>
                                </a>
                                <span class="product-price">₹<%= product.price %></span>
                            </div>
                            <a href="/products/<%= product._id %>" class="view-link">
                                Discover <i class="fa-solid fa-arrow-right"></i>
                            </a>
                        </div>
                    </div>
                    <% }); %>
            </div>

            <% if (showAllButton) { %>
                <div class="show-all-container" data-aos="fade-up">
                    <a href="/wines" class="btn-premium-outline">
                        View All Masterpieces
                        <span class="btn-icon"><i class="fa-solid fa-arrow-right-long"></i></span>
                    </a>
                </div>
                <% } %>
        </div>
    </section>

    <script>
        // Initialize AOS
        AOS.init({
            duration: 1200,
            once: true,
            offset: 100,
            easing: 'ease-out-cubic'
        });

        // Smooth Scroll
        document.querySelectorAll('a[href^="#"]').forEach(anchor => {
            anchor.addEventListener('click', function (e) {
                e.preventDefault();
                const targetId = this.getAttribute('href');
                const targetElement = document.querySelector(targetId);

                if (targetElement) {
                    window.scrollTo({
                        top: targetElement.offsetTop - 80,
                        behavior: 'smooth'
                    });
                }
            });
        });

        async function addtocart(productId, target) {
            try {
                const response = await fetch('/cartt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId }),
                });

                if (response.ok) {
                    Swal.fire({
                        icon: 'success',
                        title: 'Selection Added',
                        text: 'This vintage has been added to your cart.',
                        confirmButtonColor: '#6b0f1a',
                        background: '#fdf8f2'
                    });
                } else {
                    const error = await response.json();
                    Swal.fire({
                        icon: 'info',
                        text: error.message || 'Unable to add this selection.',
                        confirmButtonColor: '#6b0f1a'
                    });
                }
            } catch (error) {
                console.error("Fetch error:", error);
                Swal.fire({
                    icon: 'error',
                    title: 'System Error',
                    text: 'An unexpected error occurred.',
                    confirmButtonColor: '#6b0f1a'
                });
            }
        }

        async function addToWishlist(productId, target) {
            try {
                const response = await fetch('/wishlistt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId }),
                });

                if (response.ok) {
                    const data = await response.json();
                    Swal.fire({
                        icon: data.action === 'added' ? 'success' : 'info',
                        title: data.action === 'added' ? 'Added to Curator List' : 'Selection Removed',
                        text: data.message,
                        confirmButtonColor: '#6b0f1a',
                    });
                } else {
                    const error = await response.json();
                    Swal.fire({
                        icon: 'error',
                        title: 'Error',
                        text: error.message || 'Failed to update your list.',
                        confirmButtonColor: '#6b0f1a',
                    });
                }
            } catch (error) {
                console.error('Error:', error);
                Swal.fire({
                    icon: 'error',
                    title: 'System Error',
                    text: 'An unexpected error occurred.',
                    confirmButtonColor: '#6b0f1a',
                });
            }
        }

        // --- SEAMLESS INFINITE SCROLL FOR CATEGORIES ---
        const categoriesInner = document.querySelector('.categories-inner');
        if (categoriesInner) {

            const items = [...categoriesInner.children];
            items.forEach(item => {
                const clone = item.cloneNode(true);
                categoriesInner.appendChild(clone);
            });

            let isHovered = false;
            let scrollAmount = 0;
            const scrollSpeed = 0.8; // Pixels per frame

            categoriesInner.addEventListener('mouseenter', () => isHovered = true);
            categoriesInner.addEventListener('mouseleave', () => isHovered = false);

            function step() {
                if (!isHovered) {
                    scrollAmount += scrollSpeed;


                    const originalWidth = categoriesInner.scrollWidth / 2;

                    if (scrollAmount >= originalWidth) {
                        scrollAmount = 0;
                    }

                    categoriesInner.scrollLeft = scrollAmount;
                }
                requestAnimationFrame(step);
            }

            requestAnimationFrame(step);
        }
    </script>

    <%-include('../partials/userFooter.ejs')%>