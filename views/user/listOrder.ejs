<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Order Detail | Wine Heaven</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <!-- SweetAlert2 -->
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>
    <script src="https://checkout.razorpay.com/v1/checkout.js"></script>

    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --cream: #fdf8f2;
            --text-dark: #1a0a0e;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cream);
            color: var(--text-dark);
        }

        .font-playfair {
            font-family: 'Playfair Display', serif;
        }

        .status-badge {
            font-size: 0.7rem;
            font-weight: 600;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            padding: 4px 12px;
            border-radius: 20px;
            display: inline-flex;
            align-items: center;
            gap: 6px;
        }

        .status-pending {
            background: #fffbeb;
            color: #92400e;
            border: 1px solid #fef3c7;
        }

        .status-confirmed {
            background: #eff6ff;
            color: #1e40af;
            border: 1px solid #dbeafe;
        }

        .status-shipped {
            background: #f5f3ff;
            color: #5b21b6;
            border: 1px solid #ede9fe;
        }

        .status-delivered {
            background: #ecfdf5;
            color: #065f46;
            border: 1px solid #d1fae5;
        }

        .status-cancelled {
            background: #fef2f2;
            color: #991b1b;
            border: 1px solid #fee2e2;
        }

        .status-returned {
            background: #f9fafb;
            color: #1f2937;
            border: 1px solid #f3f4f6;
        }

        .page-header {
            background: white;
            border-bottom: 1px solid rgba(107, 15, 26, 0.07);
            padding: 28px 0;
        }

        .order-container {
            background: white;
            border-radius: 24px;
            box-shadow: 0 20px 50px rgba(107, 15, 26, 0.05);
            overflow: hidden;
            border: 1px solid rgba(107, 15, 26, 0.05);
        }

        .item-row {
            transition: all 0.3s ease;
        }

        .item-row:hover {
            background: rgba(107, 15, 26, 0.02);
        }
    </style>
</head>

<body>
    <%- include('../partials/userHeader.ejs') %>

        <% if (orders) { %>
            <!-- Page Header -->
            <div class="page-header">
                <div class="container mx-auto px-4">
                    <div class="max-w-6xl mx-auto flex flex-col md:flex-row md:items-center justify-between gap-4">
                        <div>
                            <div class="flex items-center gap-2 text-xs text-gray-400 mb-2">
                                <a href="/orders" class="hover:text-maroon transition" style="color: var(--maroon);">My
                                    Orders</a>
                                <i class="fa-solid fa-chevron-right text-[8px] opacity-40"></i>
                                <span>Order Details</span>
                            </div>
                            <h1 class="text-2xl md:text-3xl font-bold font-playfair text-gray-900">Order Details</h1>
                        </div>
                        <div class="bg-gray-50 border border-gray-100 px-6 py-3 rounded-2xl">
                            <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-1">Order #
                            </p>
                            <p class="text-xl font-bold font-playfair">
                                <%= orders._id.toString().slice(-12).toUpperCase() %>
                            </p>
                        </div>
                    </div>
                </div>
            </div>

            <div class="container mx-auto px-4 py-8 pb-20">
                <div class="max-w-6xl mx-auto">
                    <div class="order-container">
                        <!-- Summary Bar -->
                        <div class="grid grid-cols-2 md:grid-cols-4 border-b border-gray-100 bg-gray-50/50">
                            <div class="p-6 md:border-r border-gray-100">
                                <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-1">Placed
                                    On
                                </p>
                                <p class="font-bold text-gray-900">
                                    <%= new Date(orders.createdAt).toLocaleDateString('en-GB', { day: '2-digit' ,
                                        month: 'short' , year: 'numeric' }) %>
                                </p>
                            </div>
                            <div class="p-6 md:border-r border-gray-100">
                                <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-1">Total
                                    Paid
                                </p>
                                <p class="font-bold text-maroon" style="color: var(--maroon);">₹<%=
                                        orders.totalAmount.toLocaleString() %>.00</p>
                            </div>
                            <div class="p-6 md:border-r border-gray-100 text-right md:text-left">
                                <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-1">
                                    Payment
                                </p>
                                <p class="font-bold text-gray-900">
                                    <%= orders.paymentMethod %>
                                </p>
                            </div>
                            <div class="p-6 text-right md:text-left">
                                <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-1">Status
                                </p>
                                <span
                                    class="status-badge <%= orders.orderStatus === 'Pending' ? 'status-pending' : 'status-delivered' %>">
                                    <%= orders.orderStatus %>
                                </span>
                            </div>
                        </div>

                        <div class="p-6 md:p-10">
                            <div class="grid grid-cols-1 lg:grid-cols-12 gap-12">
                                <!-- Items List -->
                                <div class="lg:col-span-8">
                                    <div class="flex items-center justify-between mb-8">
                                        <h3
                                            class="text-xl font-bold text-gray-900 font-playfair flex items-center gap-3">
                                            <span
                                                class="w-8 h-8 rounded-full bg-maroon text-white flex items-center justify-center text-xs"
                                                style="background: var(--maroon);">
                                                <%= orders.items.length %>
                                            </span>
                                            Order Items
                                        </h3>

                                        <% if (orders.items.some(i=> i.productStatus !== 'Order Not Conform')) { %>
                                            <a href="/sales-report/download/pdf?orderId=<%= orders._id %>"
                                                class="text-xs font-bold text-maroon hover:text-gold flex items-center gap-2"
                                                style="color: var(--maroon);">
                                                <i class="fa-solid fa-file-pdf"></i> DOWNLOAD INVOICE
                                            </a>
                                            <% } %>
                                    </div>

                                    <div class="space-y-6">
                                        <% orders.items.forEach(item=> { %>
                                            <div
                                                class="item-row flex gap-6 p-4 rounded-3xl border border-gray-50 bg-gray-50/20">
                                                <div
                                                    class="w-24 h-28 flex-shrink-0 bg-white rounded-2xl overflow-hidden border border-gray-100 shadow-sm">
                                                    <img src="/uploads/<%= item.productImage %>"
                                                        class="w-full h-full object-cover">
                                                </div>

                                                <div class="flex-grow py-1 flex flex-col justify-between">
                                                    <div>
                                                        <div class="flex justify-between items-start">
                                                            <h4 class="font-bold text-gray-900 text-lg">
                                                                <%= item.productName %>
                                                            </h4>
                                                            <span class="status-badge <%= 
                                                            item.productStatus === 'Pending' ? 'status-pending' : 
                                                            item.productStatus === 'Confirmed' ? 'status-confirmed' : 
                                                            item.productStatus === 'Shipped' ? 'status-shipped' : 
                                                            item.productStatus === 'Delivered' ? 'status-delivered' : 
                                                            item.productStatus === 'Cancelled' ? 'status-cancelled' : 'status-returned'
                                                        %>">
                                                                <%= item.productStatus %>
                                                            </span>
                                                        </div>
                                                        <p class="text-xs text-gray-400 mt-1">Quantity: <span
                                                                class="font-bold text-gray-900">
                                                                <%= item.productCount %>
                                                            </span></p>
                                                    </div>

                                                    <div class="flex items-end justify-between">
                                                        <p class="text-xl font-bold font-playfair">₹<%=
                                                                (item.productPrice * item.productCount).toLocaleString()
                                                                %>.00</p>

                                                        <div class="flex gap-4">
                                                            <% if (['Pending', 'Confirmed' , 'Shipped'
                                                                ].includes(item.productStatus)) { %>
                                                                <button
                                                                    class="cancel-btn text-xs font-bold text-red-600 hover:tracking-widest transition-all"
                                                                    data-order-id="<%= orders._id %>"
                                                                    data-payment-id="<%= orders.paymentDetails?.razorpay_payment_id || '' %>"
                                                                    data-product-id="<%= item.productId?._id || item.productId %>">
                                                                    CANCEL ITEM
                                                                </button>
                                                                <% } else if (item.productStatus==='Delivered' ) { %>
                                                                    <button
                                                                        class="return-btn text-xs font-bold text-amber-600 hover:tracking-widest transition-all"
                                                                        data-order-id="<%= orders._id %>"
                                                                        data-payment-id="<%= orders.paymentDetails?.razorpay_payment_id || '' %>"
                                                                        data-product-id="<%= item.productId?._id || item.productId %>">
                                                                        RETURN ITEM
                                                                    </button>
                                                                    <% } else if
                                                                        (item.productStatus==='Order Not Conform' ) { %>
                                                                        <button
                                                                            onclick="paynow('<%= orders._id %>', this)"
                                                                            class="text-xs font-bold text-maroon hover:tracking-widest transition-all"
                                                                            style="color: var(--maroon);">
                                                                            PAY NOW
                                                                        </button>
                                                                        <% } %>
                                                        </div>
                                                    </div>
                                                </div>
                                            </div>
                                            <% }); %>
                                    </div>
                                </div>

                                <!-- Right Column -->
                                <div class="lg:col-span-4 space-y-8">
                                    <!-- Address Section -->
                                    <div class="bg-gray-50/50 rounded-3xl p-8 border border-gray-100">
                                        <h4
                                            class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-6 flex items-center gap-2">
                                            <i class="fa-solid fa-map-pin opacity-30"></i> Shipping Address
                                        </h4>
                                        <% if (orders.shippingAddress && orders.shippingAddress.length> 0) { %>
                                            <% let addr=orders.shippingAddress[0]; %>
                                                <div
                                                    class="text-sm text-gray-700 leading-relaxed uppercase tracking-tight">
                                                    <p class="font-black text-gray-900 text-base mb-2">
                                                        <%= addr.name %>
                                                    </p>
                                                    <p>
                                                        <%= addr.address %>
                                                    </p>
                                                    <p>
                                                        <%= addr.city %>, <%= addr.state %> - <%= addr.pincode %>
                                                    </p>
                                                    <div class="mt-6 font-bold text-maroon"
                                                        style="color: var(--maroon);">
                                                        <i class="fa-solid fa-phone mr-2 opacity-50"></i>
                                                        <%= addr.mobile %>
                                                    </div>
                                                </div>
                                                <% } %>
                                    </div>

                                    <!-- Billing Section -->
                                    <div class="bg-maroon/[0.02] rounded-3xl p-8 border border-maroon/5">
                                        <h4 class="text-[10px] font-bold text-gray-400 uppercase tracking-widest mb-6">
                                            Order Summary</h4>
                                        <div class="space-y-4 text-sm font-medium">
                                            <div class="flex justify-between">
                                                <span class="text-gray-400">Items Total</span>
                                                <span>₹<%= (orders.totalAmount + (orders.discount || 0) -
                                                        100).toLocaleString() %>.00</span>
                                            </div>
                                            <div class="flex justify-between">
                                                <span class="text-gray-400">Shipping Fee</span>
                                                <span>₹100.00</span>
                                            </div>
                                            <% if (orders.discount> 0) { %>
                                                <div class="flex justify-between text-green-600 italic">
                                                    <span>Coupon Discount</span>
                                                    <span>-₹<%= orders.discount.toLocaleString() %>.00</span>
                                                </div>
                                                <% } %>
                                                    <div
                                                        class="pt-4 border-t border-gray-100 flex justify-between items-center text-lg">
                                                        <span class="font-bold text-gray-900">Total</span>
                                                        <span class="font-bold text-maroon font-playfair text-2xl"
                                                            style="color: var(--maroon);">₹<%=
                                                                orders.totalAmount.toLocaleString() %>.00</span>
                                                    </div>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <% } %>

                <!-- Modals (Cancel/Return) -->
                <!-- [Rest of modal HTML and Scripts same as before, but adapted if needed] -->
                <div id="cancel-modal" class="fixed inset-0 z-[2000] hidden">
                    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeCancelModal()"></div>
                    <div
                        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-3xl shadow-2xl p-8">
                        <h3 class="text-2xl font-playfair font-bold mb-4 text-gray-900">Cancel Item?</h3>
                        <textarea id="cancel-reason" rows="3"
                            class="w-full bg-gray-50 border border-gray-100 rounded-2xl p-4 text-sm mb-6 focus:ring-1 focus:ring-maroon outline-none"
                            placeholder="Reason for cancellation..." required></textarea>
                        <div class="flex gap-4">
                            <button type="button" onclick="closeCancelModal()"
                                class="flex-1 py-3 font-bold text-gray-400">CLOSE</button>
                            <button id="confirm-cancel-btn"
                                class="flex-2 px-8 py-3 bg-red-600 text-white font-bold rounded-xl shadow-lg shadow-red-100">CONFIRM</button>
                        </div>
                    </div>
                </div>

                <div id="return-modal" class="fixed inset-0 z-[2000] hidden">
                    <div class="absolute inset-0 bg-black/40 backdrop-blur-sm" onclick="closeReturnModal()"></div>
                    <div
                        class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 w-full max-w-md bg-white rounded-3xl shadow-2xl p-8">
                        <h3 class="text-2xl font-playfair font-bold mb-4 text-gray-900">Return Item</h3>
                        <textarea id="return-reason" rows="3"
                            class="w-full bg-gray-50 border border-gray-100 rounded-2xl p-4 text-sm mb-6 focus:ring-1 focus:ring-amber-500 outline-none"
                            placeholder="Reason for return..." required></textarea>
                        <div class="flex gap-4">
                            <button type="button" onclick="closeReturnModal()"
                                class="flex-1 py-3 font-bold text-gray-400">CLOSE</button>
                            <button id="confirm-return-btn"
                                class="flex-2 px-8 py-3 bg-amber-600 text-white font-bold rounded-xl shadow-lg shadow-amber-100">SUBMIT</button>
                        </div>
                    </div>
                </div>

                <%- include('../partials/userFooter.ejs') %>

                    <script>
                        // Modal helpers
                        const showModal = (id) => { document.getElementById(id).classList.remove('hidden'); document.body.style.overflow = 'hidden'; }
                        const hideModal = (id) => { document.getElementById(id).classList.add('hidden'); document.body.style.overflow = ''; }

                        let currentOrderId, currentProductId, currentPaymentId;

                        document.querySelectorAll('.cancel-btn').forEach(btn => {
                            btn.onclick = () => {
                                currentOrderId = btn.dataset.orderId;
                                currentProductId = btn.dataset.productId;
                                currentPaymentId = btn.dataset.paymentId;
                                showModal('cancel-modal');
                            }
                        });
                        const closeCancelModal = () => hideModal('cancel-modal');

                        document.getElementById('confirm-cancel-btn').onclick = async () => {
                            const reason = document.getElementById('cancel-reason').value;
                            if (!reason) return;
                            const res = await fetch('/orders/cancel', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderId: currentOrderId, productId: currentProductId, paymentId: currentPaymentId, reason }) });
                            if (res.ok) location.reload();
                            else Swal.fire('Error', 'Failed to cancel item', 'error');
                        };

                        document.querySelectorAll('.return-btn').forEach(btn => {
                            btn.onclick = () => {
                                currentOrderId = btn.dataset.orderId;
                                currentProductId = btn.dataset.productId;
                                currentPaymentId = btn.dataset.paymentId;
                                showModal('return-modal');
                            }
                        });
                        const closeReturnModal = () => hideModal('return-modal');

                        document.getElementById('confirm-return-btn').onclick = async () => {
                            const reason = document.getElementById('return-reason').value;
                            if (!reason) return;
                            const res = await fetch('/orders/return', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ orderId: currentOrderId, productId: currentProductId, paymentId: currentPaymentId, reason }) });
                            if (res.ok) location.reload();
                            else Swal.fire('Error', 'Failed to submit return', 'error');
                        };

                        async function paynow(orderId, btn) {
                            btn.disabled = true; btn.innerText = '...';
                            try {
                                const orderData = await (await fetch(`/api/order/${orderId}`)).json();
                                const paymentData = await (await fetch(`/payment-render/${orderData.totalAmount}`, { method: 'POST' })).json();
                                const options = {
                                    key: "<%= process.env.RAZOR_KEY_ID %>",
                                    amount: orderData.totalAmount * 100,
                                    currency: "INR",
                                    name: "Wine Heaven",
                                    order_id: paymentData.orderID,
                                    handler: async (resp) => {
                                        await fetch('/api/place-pending-order', {
                                            method: 'POST',
                                            headers: { 'Content-Type': 'application/json' },
                                            body: JSON.stringify({ ...orderData, razorpay_payment_id: resp.razorpay_payment_id, razorpay_order_id: resp.razorpay_order_id, razorpay_signature: resp.razorpay_signature })
                                        });
                                        window.location.href = "/order-confirmation";
                                    },
                                    theme: { color: "#6b0f1a" }
                                };
                                new Razorpay(options).open();
                            } catch (e) { btn.disabled = false; btn.innerText = 'PAY NOW'; }
                        }
                    </script>
</body>

</html>