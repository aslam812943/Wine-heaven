<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Profile Information | Wine Heaven</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&display=swap"
        rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'wine-maroon': '#6b0f1a',
                        'wine-gold': '#c9a84c',
                        'wine-cream': '#fdf8f2',
                        'wine-black': '#0a0202',
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --wine-maroon: #6b0f1a;
            --wine-gold: #c9a84c;
            --wine-cream: #fdf8f2;
            --wine-black: #0a0202;
        }

        body {
            background-color: var(--wine-cream);
            font-family: 'Inter', sans-serif;
            color: var(--wine-black);
        }

        .playfair {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(107, 15, 26, 0.1);
            box-shadow: 0 8px 32px 0 rgba(107, 15, 26, 0.05);
        }

        .input-premium {
            background: rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(107, 15, 26, 0.1);
            transition: all 0.3s ease;
        }

        .input-premium:focus {
            border-color: var(--wine-gold);
            background: white;
            box-shadow: 0 0 0 4px rgba(201, 168, 76, 0.1);
            outline: none;
        }

        .btn-wine {
            background: var(--wine-maroon);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-wine:hover {
            background: #4a0a12;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(107, 15, 26, 0.2);
        }

        .btn-gold-outline {
            border: 1px solid var(--wine-gold);
            color: var(--wine-gold);
            transition: all 0.3s ease;
        }

        .btn-gold-outline:hover {
            background: var(--wine-gold);
            color: white;
        }

        .error-label {
            color: #d11124;
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: none;
        }
    </style>
</head>

<body class="min-h-screen">
    <%- include('../partials/userHeader.ejs') %>

        <main class="container mx-auto px-4 pt-32 pb-12 flex justify-center">
            <div class="w-full max-w-2xl" data-aos="fade-up">
                <!-- Header Section -->
                <div class="mb-10 text-center">
                    <span class="text-wine-gold uppercase tracking-[0.3em] text-xs font-bold mb-2 block">Member
                        Profile</span>
                    <h1 class="playfair text-3xl md:text-4xl font-bold text-wine-black mb-4">Account Information</h1>
                    <div class="w-16 h-1 bg-wine-gold mx-auto"></div>
                </div>

                <div class="glass-card rounded-[2rem] p-8 md:p-12 shadow-2xl relative overflow-hidden">
                    <!-- Decorative background icon -->
                    <div class="absolute -right-10 -top-10 opacity-[0.03] pointer-events-none">
                        <i class="fas fa-user-circle text-[15rem]"></i>
                    </div>

                    <div class="relative z-10 space-y-8">
                        <!-- Profile Header (Initials) -->
                        <div class="flex items-center space-x-6 mb-12">
                            <div
                                class="w-20 h-20 rounded-2xl bg-wine-maroon flex items-center justify-center text-white shadow-lg shadow-wine-maroon/20">
                                <span class="text-3xl font-bold playfair">
                                    <%= user ? user.name.charAt(0).toUpperCase() : 'U' %>
                                </span>
                            </div>
                            <div>
                                <h2 class="text-2xl font-bold text-wine-black">
                                    <%= user ? user.name : 'User' %>
                                </h2>
                                <p class="text-wine-gold font-medium text-sm">Premium Wine Collector</p>
                            </div>
                        </div>

                        <!-- Name Section -->
                        <div class="group">
                            <label
                                class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">Full
                                Name</label>
                            <% if (user) { %>
                                <div class="flex items-center space-x-3" id="nameDisplay">
                                    <input type="text" value="<%= user.name %>" id="nameInput"
                                        class="input-premium px-4 py-3 rounded-xl w-full font-medium" disabled>
                                    <button onclick="enableEditName()" class="btn-gold-outline p-3 rounded-xl"
                                        title="Edit Name">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </div>

                                <form action="/updateDetails" method="POST" id="editNameForm"
                                    onsubmit="return validateName()"
                                    class="hidden space-y-4 animate-in fade-in slide-in-from-top-4 duration-300">
                                    <div class="relative">
                                        <input type="text" name="name" maxlength="15" id="editNameInput"
                                            class="input-premium px-4 py-3 rounded-xl w-full font-medium"
                                            value="<%= user.name %>">
                                        <p id="nameError" class="error-label">Name must be 3-15 chars, start with a
                                            capital, and no leading spaces.</p>
                                    </div>
                                    <div class="flex space-x-3">
                                        <button type="submit"
                                            class="btn-wine flex-1 py-3 rounded-xl font-bold text-sm">Update
                                            Name</button>
                                        <button type="button" onclick="cancelEditName()"
                                            class="bg-gray-100 text-gray-500 px-6 py-3 rounded-xl font-bold text-sm hover:bg-gray-200">Cancel</button>
                                    </div>
                                </form>
                                <% } %>
                        </div>

                        <!-- Email Section (ReadOnly) -->
                        <div>
                            <label
                                class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">Email
                                Address</label>
                            <div class="relative">
                                <input type="text" value="<%= user ? user.email : '' %>"
                                    class="input-premium px-4 py-3 rounded-xl w-full font-medium text-gray-400 cursor-not-allowed"
                                    disabled>
                                <div class="absolute right-4 top-1/2 -translate-y-1/2">
                                    <i class="fas fa-lock text-gray-300 text-xs" title="Email cannot be changed"></i>
                                </div>
                            </div>
                        </div>

                        <!-- Phone Section -->
                        <div>
                            <label
                                class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">Phone
                                Number</label>
                            <% if (user) { %>
                                <div class="flex items-center space-x-3" id="phoneDisplay">
                                    <input type="text" value="<%= user.phone || 'Not provided' %>" id="phoneInput"
                                        class="input-premium px-4 py-3 rounded-xl w-full font-medium" disabled>
                                    <button onclick="enableEditPhone()" class="btn-gold-outline p-3 rounded-xl"
                                        title="Edit Phone">
                                        <i class="fas fa-edit"></i>
                                    </button>
                                </div>

                                <form action="/updateDetails" method="POST" id="editPhoneForm"
                                    onsubmit="return validatePhone()"
                                    class="hidden space-y-4 animate-in fade-in slide-in-from-top-4 duration-300">
                                    <div class="relative">
                                        <input type="text" name="phone" maxlength="10" id="editPhoneInput"
                                            class="input-premium px-4 py-3 rounded-xl w-full font-medium"
                                            value="<%= user.phone %>" placeholder="Enter 10-digit number">
                                        <p id="phoneError" class="error-label">Enter a valid 10-digit number (cannot
                                            start with 0).</p>
                                    </div>
                                    <div class="flex space-x-3">
                                        <button type="submit"
                                            class="btn-wine flex-1 py-3 rounded-xl font-bold text-sm">Update
                                            Phone</button>
                                        <button type="button" onclick="cancelEditPhone()"
                                            class="bg-gray-100 text-gray-500 px-6 py-3 rounded-xl font-bold text-sm hover:bg-gray-200">Cancel</button>
                                    </div>
                                </form>
                                <% } %>
                        </div>

                        <!-- Password Management -->
                        <% if (passwordd) { %>
                            <div class="pt-6 border-t border-gray-100">
                                <div id="resetButtonContainer">
                                    <button onclick="showResetPasswordForm()"
                                        class="btn-gold-outline w-full py-4 rounded-xl font-bold text-sm flex items-center justify-center">
                                        <i class="fas fa-key mr-2"></i> Security Settings & Password Reset
                                    </button>
                                </div>

                                <form action="/resetPassword" method="POST" id="resetPasswordForm"
                                    class="hidden space-y-5 animate-in fade-in zoom-in-95 duration-300">
                                    <h4 class="playfair text-lg font-bold text-wine-black mb-2">Change Password</h4>

                                    <div>
                                        <label
                                            class="block text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2">Current
                                            Password</label>
                                        <input type="password" name="currentPassword"
                                            class="input-premium px-4 py-3 rounded-xl w-full" required>
                                    </div>

                                    <div>
                                        <label
                                            class="block text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2">New
                                            Password</label>
                                        <input type="password" name="newPassword" id="newPassword"
                                            class="input-premium px-4 py-3 rounded-xl w-full" required>
                                    </div>

                                    <div>
                                        <label
                                            class="block text-[10px] uppercase tracking-widest text-gray-400 font-bold mb-2">Confirm
                                            New Password</label>
                                        <input type="password" name="confirmNewPassword" id="confirmNewPassword"
                                            class="input-premium px-4 py-3 rounded-xl w-full" required>
                                    </div>

                                    <div class="flex space-x-3 pt-2">
                                        <button type="submit"
                                            class="btn-wine flex-1 py-3 rounded-xl font-bold text-sm shadow-lg shadow-wine-maroon/20">Update
                                            Security</button>
                                        <button type="button" onclick="cancelResetPasswordForm()"
                                            class="bg-gray-100 text-gray-500 px-6 py-3 rounded-xl font-bold text-sm">Cancel</button>
                                    </div>
                                </form>
                            </div>
                            <% } %>
                    </div>
                </div>
            </div>
        </main>

        <%- include('../partials/userFooter.ejs') %>

            <!-- Notifications -->
            <% if (updateSuccess) { %>
                <script>
                    Swal.fire({
                        title: '<span class="playfair">Success!</span>',
                        text: 'Your profile has been elegantly updated.',
                        icon: 'success',
                        confirmButtonColor: '#6b0f1a',
                        background: '#fdf8f2'
                    });
                </script>
                <% } %>

                    <script>
                        AOS.init({ duration: 1000, once: true, easing: 'ease-out-cubic' });

                        // Password Reset Form Toggle
                        function showResetPasswordForm() {
                            document.getElementById('resetPasswordForm').classList.remove('hidden');
                            document.getElementById('resetButtonContainer').classList.add('hidden');
                        }

                        function cancelResetPasswordForm() {
                            document.getElementById('resetPasswordForm').classList.add('hidden');
                            document.getElementById('resetButtonContainer').classList.remove('hidden');
                        }

                        // Name Edit Toggle
                        function enableEditName() {
                            document.getElementById('nameDisplay').classList.add('hidden');
                            document.getElementById('editNameForm').classList.remove('hidden');
                            document.getElementById('editNameInput').focus();
                        }

                        function cancelEditName() {
                            document.getElementById('nameDisplay').classList.remove('hidden');
                            document.getElementById('editNameForm').classList.add('hidden');
                        }

                        // Phone Edit Toggle
                        function enableEditPhone() {
                            document.getElementById('phoneDisplay').classList.add('hidden');
                            document.getElementById('editPhoneForm').classList.remove('hidden');
                            document.getElementById('editPhoneInput').focus();
                        }

                        function cancelEditPhone() {
                            document.getElementById('phoneDisplay').classList.remove('hidden');
                            document.getElementById('editPhoneForm').classList.add('hidden');
                        }

                        // Validations
                        function validateName() {
                            const val = document.getElementById('editNameInput').value.trim();
                            const err = document.getElementById('nameError');
                            err.style.display = 'none';

                            if (val.length < 3 || val.charAt(0) !== val.charAt(0).toUpperCase()) {
                                err.style.display = 'block';
                                return false;
                            }
                            return true;
                        }

                        function validatePhone() {
                            const val = document.getElementById('editPhoneInput').value.trim();
                            const err = document.getElementById('phoneError');
                            err.style.display = 'none';

                            if (!/^[1-9][0-9]{9}$/.test(val)) {
                                err.style.display = 'block';
                                return false;
                            }
                            return true;
                        }
                    </script>
</body>

</html>