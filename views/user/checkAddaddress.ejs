<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>New Delivery Destination | Wine Heaven</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&display=swap"
        rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'wine-maroon': '#6b0f1a',
                        'wine-gold': '#c9a84c',
                        'wine-cream': '#fdf8f2',
                        'wine-black': '#0a0202',
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --wine-maroon: #6b0f1a;
            --wine-gold: #c9a84c;
            --wine-cream: #fdf8f2;
            --wine-black: #0a0202;
        }

        body {
            background-color: var(--wine-cream);
            font-family: 'Inter', sans-serif;
            color: var(--wine-black);
        }

        .playfair {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.82);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(107, 15, 26, 0.1);
            box-shadow: 0 8px 32px 0 rgba(107, 15, 26, 0.05);
        }

        .input-premium {
            background: rgba(255, 255, 255, 0.5);
            border: 1px solid rgba(107, 15, 26, 0.1);
            transition: all 0.3s ease;
        }

        .input-premium:focus {
            border-color: var(--wine-gold);
            background: white;
            box-shadow: 0 0 0 4px rgba(201, 168, 76, 0.1);
            outline: none;
        }

        .btn-wine {
            background: var(--wine-maroon);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-wine:hover {
            background: #4a0a12;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(107, 15, 26, 0.2);
        }

        .error-message {
            color: #d11124;
            font-size: 0.75rem;
            margin-top: 0.25rem;
            display: none;
        }

        /* Custom radio styling */
        .radio-premium {
            appearance: none;
            width: 20px;
            height: 20px;
            border: 2px solid rgba(107, 15, 26, 0.2);
            border-radius: 50%;
            outline: none;
            cursor: pointer;
            position: relative;
            transition: all 0.3s ease;
        }

        .radio-premium:checked {
            border-color: var(--wine-gold);
        }

        .radio-premium:checked::after {
            content: '';
            position: absolute;
            width: 10px;
            height: 10px;
            background: var(--wine-gold);
            border-radius: 50%;
            top: 50%;
            left: 50%;
            transform: translate(-50%, -50%);
        }
    </style>
</head>

<body class="min-h-screen">
    <%- include('../partials/userHeader.ejs') %>

        <main class="container mx-auto px-4 pt-32 pb-12 flex justify-center">
            <div class="w-full max-w-2xl" data-aos="fade-up">
                <!-- Header Section -->
                <div class="mb-10 text-center">
                    <span class="text-wine-gold uppercase tracking-[0.3em] text-xs font-bold mb-2 block">Checkout
                        Logistics</span>
                    <h1 class="playfair text-3xl md:text-4xl font-bold text-wine-black mb-4">Add Delivery Point</h1>
                    <div class="w-16 h-1 bg-wine-gold mx-auto"></div>
                </div>

                <div class="glass-card rounded-[2.5rem] p-8 md:p-12 shadow-2xl relative overflow-hidden">
                    <form id="addressForm" action="/add-addres" method="POST" class="space-y-6"
                        onsubmit="return validateForm()">

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Name -->
                            <div>
                                <label for="name"
                                    class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">Recipient
                                    Name</label>
                                <input type="text" id="name" name="name" maxlength="15"
                                    class="input-premium px-4 py-3 rounded-xl w-full font-medium" required>
                                <p id="name-error" class="error-message">Name must be 3-15 chars, start with Uppercase,
                                    and no leading spaces.</p>
                            </div>

                            <!-- Mobile -->
                            <div>
                                <label for="mobile"
                                    class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">Mobile
                                    Contact</label>
                                <input type="text" id="mobile" name="mobile" maxlength="10"
                                    class="input-premium px-4 py-3 rounded-xl w-full font-medium" required>
                                <p id="mobile-error" class="error-message">Exactly 10 digits required (cannot start with
                                    0).</p>
                            </div>
                        </div>

                        <div class="grid grid-cols-1 md:grid-cols-2 gap-6">
                            <!-- Pincode -->
                            <div>
                                <label for="pincode"
                                    class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">Pincode</label>
                                <input type="text" id="pincode" maxlength="6" name="pincode"
                                    class="input-premium px-4 py-3 rounded-xl w-full font-medium" required>
                                <p id="pincode-error" class="error-message">Enter a valid 6-digit pincode.</p>
                            </div>

                            <!-- City -->
                            <div>
                                <label for="city"
                                    class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">City/Town</label>
                                <input type="text" id="city" maxlength="25" name="city"
                                    class="input-premium px-4 py-3 rounded-xl w-full font-medium" required>
                                <p id="city-error" class="error-message">Minimum 3 characters required.</p>
                            </div>
                        </div>

                        <!-- Address -->
                        <div>
                            <label for="address"
                                class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">Street
                                Address</label>
                            <input type="text" id="address" name="address" maxlength="25"
                                class="input-premium px-4 py-3 rounded-xl w-full font-medium" required>
                            <p id="address-error" class="error-message">Minimum 5 characters required.</p>
                        </div>

                        <!-- State -->
                        <div>
                            <label for="state"
                                class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-2">State/Region</label>
                            <select id="state" name="state"
                                class="input-premium px-4 py-3 rounded-xl w-full font-medium appearance-none cursor-pointer"
                                required>
                                <option value="">-- Select Region --</option>
                                <option value="New York">New York</option>
                                <option value="Florida">Florida</option>
                                <option value="California">California</option>
                            </select>
                            <p id="state-error" class="error-message">Please select a state from the list.</p>
                        </div>

                        <!-- Address Type -->
                        <div>
                            <label
                                class="block text-[10px] uppercase tracking-widest text-wine-gold font-bold mb-4">Location
                                Type</label>
                            <div class="flex space-x-8">
                                <label class="flex items-center group cursor-pointer">
                                    <input type="radio" id="home" name="addressType" value="Home" class="radio-premium"
                                        required>
                                    <span
                                        class="ml-3 text-sm font-medium text-wine-black group-hover:text-wine-gold transition-colors">Residential</span>
                                </label>
                                <label class="flex items-center group cursor-pointer">
                                    <input type="radio" id="work" name="addressType" value="Work" class="radio-premium"
                                        required>
                                    <span
                                        class="ml-3 text-sm font-medium text-wine-black group-hover:text-wine-gold transition-colors">Commercial</span>
                                </label>
                            </div>
                            <p id="addressType-error" class="error-message">Please categorize this location.</p>
                        </div>

                        <!-- Buttons -->
                        <div class="pt-6 flex flex-col md:flex-row gap-4">
                            <button type="submit"
                                class="btn-wine flex-1 py-4 rounded-2xl font-bold shadow-lg shadow-wine-maroon/20">Secure
                                Destination</button>
                            <a href="/checkout"
                                class="bg-gray-100 text-gray-500 py-4 px-10 rounded-2xl font-bold text-center hover:bg-gray-200 transition-colors">Return
                                to Checkout</a>
                        </div>
                    </form>
                </div>
            </div>
        </main>

        <%- include('../partials/userFooter.ejs') %>

            <script>
                AOS.init({ duration: 1000, once: true, easing: 'ease-out-cubic' });

                function validateForm() {
                    let isValid = true;
                    document.querySelectorAll('.error-message').forEach(e => e.style.display = 'none');

                    const val = (id) => document.getElementById(id).value.trim();
                    const err = (id) => document.getElementById(id + '-error');

                    if (val('name').length < 3 || val('name').charAt(0) !== val('name').charAt(0).toUpperCase()) {
                        err('name').style.display = 'block';
                        isValid = false;
                    }
                    if (!/^[1-9][0-9]{9}$/.test(val('mobile'))) {
                        err('mobile').style.display = 'block';
                        isValid = false;
                    }
                    if (!/^[1-9][0-9]{5}$/.test(val('pincode'))) {
                        err('pincode').style.display = 'block';
                        isValid = false;
                    }
                    if (val('address').length < 5) {
                        err('address').style.display = 'block';
                        isValid = false;
                    }
                    if (val('city').length < 3) {
                        err('city').style.display = 'block';
                        isValid = false;
                    }
                    if (document.getElementById('state').value === "") {
                        err('state').style.display = 'block';
                        isValid = false;
                    }
                    if (!document.querySelector('input[name="addressType"]:checked')) {
                        err('addressType').style.display = 'block';
                        isValid = false;
                    }

                    if (isValid) {
                        Swal.fire({
                            title: '<span class="playfair">Validated</span>',
                            text: 'Delivery point successfully registered.',
                            icon: 'success',
                            showConfirmButton: false,
                            timer: 1500
                        });
                    }
                    return isValid;
                }
            </script>
</body>

</html>