<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Orders | Wine Heaven</title>

    <!-- Tailwind CSS -->
    <script src="https://cdn.tailwindcss.com"></script>

    <!-- Google Fonts -->
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@500;600;700&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">

    <!-- Font Awesome -->
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">

    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --cream: #fdf8f2;
            --text-dark: #1a0a0e;
        }

        body {
            font-family: 'Inter', sans-serif;
            background-color: var(--cream);
            color: var(--text-dark);
        }

        .font-playfair {
            font-family: 'Playfair Display', serif;
        }

        .order-card {
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            background: white;
            border-radius: 20px;
            overflow: hidden;
            border: 1px solid rgba(107, 15, 26, 0.05);
        }

        .order-card:hover {
            transform: translateY(-5px);
            box-shadow: 0 20px 40px rgba(107, 15, 26, 0.08);
            border-color: var(--gold);
        }

        .page-header {
            background: white;
            border-bottom: 1px solid rgba(107, 15, 26, 0.07);
            padding: 28px 0;
        }

        .btn-view {
            background: var(--maroon);
            color: white;
            padding: 10px 24px;
            border-radius: 12px;
            font-weight: 600;
            font-size: 0.85rem;
            transition: all 0.3s ease;
        }

        .btn-view:hover {
            background: var(--maroon-dk);
            color: var(--gold);
            transform: scale(1.05);
        }

        .pagination-link {
            width: 40px;
            height: 40px;
            display: flex;
            align-items: center;
            justify-content: center;
            border-radius: 12px;
            font-weight: 600;
            transition: all 0.2s ease;
        }

        .pagination-active {
            background: var(--maroon);
            color: white;
        }

        .pagination-inactive {
            background: white;
            color: var(--maroon);
            border: 1px solid rgba(107, 15, 26, 0.1);
        }

        .pagination-inactive:hover {
            background: var(--cream);
            border-color: var(--maroon);
        }
    </style>
</head>

<body>
    <%- include('../partials/userHeader.ejs') %>

        <!-- Page Header -->
        <div class="page-header">
            <div class="container mx-auto px-4">
                <div class="max-w-6xl mx-auto flex items-center gap-4">
                    <div>
                        <div class="flex items-center gap-2 text-xs text-gray-400 mb-2">
                            <a href="/" class="hover:text-maroon transition" style="color: var(--maroon);">Home</a>
                            <i class="fa-solid fa-chevron-right text-[8px] opacity-40"></i>
                            <span class="text-gray-800 font-medium">My Orders</span>
                        </div>
                        <h1 class="text-2xl md:text-3xl font-bold font-playfair text-gray-900">My Orders</h1>
                    </div>
                    <div class="ml-auto flex items-center gap-2 text-maroon" style="color: var(--maroon);">
                        <i class="fa-solid fa-wine-bottle opacity-20 text-4xl"></i>
                    </div>
                </div>
            </div>
        </div>

        <div class="container mx-auto px-4 py-8 pb-20">
            <div class="max-w-6xl mx-auto">

                <% if (orders && orders.length> 0) { %>
                    <div class="grid grid-cols-1 gap-8">
                        <% orders.forEach(order=> { %>
                            <div class="order-card shadow-sm flex flex-col md:flex-row">
                                <!-- Left: Basic Info -->
                                <div
                                    class="p-8 md:w-1/3 bg-gray-50/50 border-b md:border-b-0 md:border-r border-gray-100 flex flex-col justify-between">
                                    <div>
                                        <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-1">
                                            Order Identifier</p>
                                        <h3 class="text-xl font-bold text-gray-900 font-playfair mb-4">#<%=
                                                order._id.toString().slice(-12).toUpperCase() %>
                                        </h3>

                                        <div class="space-y-3">
                                            <div class="flex items-center gap-3 text-sm text-gray-600">
                                                <i class="fa-solid fa-calendar opacity-30"></i>
                                                <span>
                                                    <%= new Date(order.createdAt).toLocaleDateString('en-GB', {
                                                        day: '2-digit' , month: 'short' , year: 'numeric' }) %>
                                                </span>
                                            </div>
                                            <div class="flex items-center gap-3 text-sm text-gray-600">
                                                <i class="fa-solid fa-credit-card opacity-30"></i>
                                                <span>
                                                    <%= order.paymentMethod %>
                                                </span>
                                            </div>
                                        </div>
                                    </div>

                                    <div class="mt-8 pt-8 border-t border-gray-100/50">
                                        <p class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-1">
                                            Order Total</p>
                                        <p class="text-2xl font-black text-maroon font-playfair"
                                            style="color: var(--maroon);">₹<%= order.totalAmount.toLocaleString() %>.00
                                        </p>
                                    </div>
                                </div>

                                <!-- Right: Items Snippet & Actions -->
                                <div class="p-8 md:w-2/3 flex flex-col justify-between">
                                    <div>
                                        <h4
                                            class="text-[10px] text-gray-400 uppercase tracking-widest font-bold mb-6 flex items-center gap-2">
                                            <i class="fa-solid fa-box opacity-30"></i> Items in this Order
                                        </h4>

                                        <div class="flex flex-wrap gap-4">
                                            <% order.items.slice(0, 3).forEach(item=> { %>
                                                <div
                                                    class="group relative w-20 h-24 bg-gray-50 rounded-xl overflow-hidden border border-gray-100 shadow-sm transition hover:shadow-md">
                                                    <img src="/uploads/<%= item.productImage %>"
                                                        class="w-full h-full object-cover transition group-hover:scale-110">
                                                    <div
                                                        class="absolute inset-0 bg-black/40 flex items-center justify-center opacity-0 group-hover:opacity-100 transition duration-300">
                                                        <span class="text-white font-bold text-xs">x<%=
                                                                item.productCount %></span>
                                                    </div>
                                                </div>
                                                <% }); %>
                                                    <% if(order.items.length> 3) { %>
                                                        <div
                                                            class="w-20 h-24 bg-cream rounded-xl flex items-center justify-center border border-dashed border-maroon/20">
                                                            <span class="text-maroon font-bold text-sm"
                                                                style="color: var(--maroon);">+<%= order.items.length -
                                                                    3 %></span>
                                                        </div>
                                                        <% } %>
                                        </div>
                                    </div>

                                    <div class="mt-10 flex items-center justify-between">
                                        <div
                                            class="flex items-center gap-2 text-xs font-bold uppercase tracking-widest <%= order.orderStatus === 'Pending' ? 'text-amber-600' : 'text-green-600' %>">
                                            <span
                                                class="w-2 h-2 rounded-full <%= order.orderStatus === 'Pending' ? 'bg-amber-600 animate-pulse' : 'bg-green-600' %>"></span>
                                            <%= order.orderStatus %>
                                        </div>
                                        <a href="/orders/<%= order._id %>" class="btn-view flex items-center gap-2"
                                            style="background: var(--maroon);">
                                            VIEW DETAILS <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                        </a>
                                    </div>
                                </div>
                            </div>
                            <% }); %>
                    </div>

                    <!-- Premium Pagination -->
                    <% if (totalPages> 1) { %>
                        <div class="mt-16 flex justify-center items-center gap-3">
                            <% if (hasPrevPage) { %>
                                <a href="?page=<%= currentPage - 1 %>" class="pagination-link pagination-inactive">
                                    <i class="fa-solid fa-chevron-left text-[10px]"></i>
                                </a>
                                <% } %>

                                    <% for (let i=1; i <=totalPages; i++) { %>
                                        <a href="?page=<%= i %>"
                                            class="pagination-link <%= i === currentPage ? 'pagination-active' : 'pagination-inactive' %>">
                                            <%= i %>
                                        </a>
                                        <% } %>

                                            <% if (hasNextPage) { %>
                                                <a href="?page=<%= currentPage + 1 %>"
                                                    class="pagination-link pagination-inactive">
                                                    <i class="fa-solid fa-chevron-right text-[10px]"></i>
                                                </a>
                                                <% } %>
                        </div>
                        <% } %>

                            <% } else { %>
                                <div class="bg-white rounded-[32px] p-20 text-center shadow-sm border border-gray-100">
                                    <div
                                        class="w-24 h-24 bg-cream rounded-full flex items-center justify-center mx-auto mb-8 shadow-inner">
                                        <i class="fa-solid fa-wine-glass text-maroon text-4xl opacity-10"></i>
                                    </div>
                                    <h2 class="text-3xl font-playfair font-bold text-gray-900 mb-4">No vintage
                                        selections yet</h2>
                                    <p class="text-gray-500 mb-10 max-w-sm mx-auto leading-relaxed">Begin your exquisite
                                        journey by exploring our hand-picked collection of the world's finest wines.</p>
                                    <a href="/wines"
                                        class="inline-flex items-center gap-3 px-12 py-4 bg-maroon text-white font-bold rounded-full hover:bg-maroon-dk transition shadow-2xl shadow-maroon/30"
                                        style="background: var(--maroon);">
                                        EXPLORE COLLECTION <i class="fa-solid fa-arrow-right text-[10px]"></i>
                                    </a>
                                </div>
                                <% } %>
            </div>
        </div>

        <%- include('../partials/userFooter.ejs') %>
</body>

</html>