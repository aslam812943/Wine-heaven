<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Wine Listing</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.0.0-beta3/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.css" rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.js"></script>
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>

    <style>
        :root {
            --wine-maroon: #6b0f1a;
            --wine-maroon-dark: #4a0a12;
            --wine-gold: #c9a84c;
            --wine-cream: #fdf8f2;
            --wine-black: #0a0202;
        }

        body {
            background-color: var(--wine-cream);
            font-family: 'Inter', sans-serif;
        }

        .bg-wine {
            background-color: var(--wine-maroon);
        }

        /* Products Grid UI Refined */
        .product-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
            gap: 30px;
        }

        .product-card {
            background: #fff;
            border-radius: 16px;
            overflow: hidden;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            position: relative;
            border: 1px solid rgba(107, 15, 26, 0.05);
            display: flex;
            flex-direction: column;
            box-shadow: 0 10px 25px rgba(0, 0, 0, 0.03);
        }

        .product-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(107, 15, 26, 0.12);
            border-color: rgba(201, 168, 76, 0.25);
        }

        .product-media {
            height: 320px;
            position: relative;
            overflow: hidden;
            background: #fdfdfd;
        }

        .product-media img {
            width: 100%;
            height: 100%;
            object-fit: contain;
            padding: 20px;
            transition: transform 0.6s ease;
        }

        .product-card:hover .product-media img {
            transform: scale(1.05) translateY(-5px);
        }

        .card-actions-bar {
            position: absolute;
            bottom: 12px;
            left: 50%;
            transform: translateX(-50%) translateY(20px);
            display: flex;
            gap: 10px;
            background: rgba(255, 255, 255, 0.9);
            backdrop-filter: blur(8px);
            padding: 8px 15px;
            border-radius: 30px;
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
            opacity: 0;
            transition: all 0.4s cubic-bezier(0.175, 0.885, 0.32, 1.275);
            z-index: 5;
        }

        .product-card:hover .card-actions-bar {
            opacity: 1;
            transform: translateX(-50%) translateY(0);
        }

        .bar-action {
            width: 34px;
            height: 34px;
            border-radius: 50%;
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--wine-maroon);
            transition: all 0.2s ease;
            border: none;
            background: transparent;
            cursor: pointer;
            font-size: 14px;
        }

        .bar-action:hover {
            background: var(--wine-maroon);
            color: #fff;
            transform: scale(1.15);
        }

        .product-info {
            padding: 20px;
            text-align: center;
            flex-grow: 1;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            background: linear-gradient(to bottom, #fff, #fffafb);
        }

        .product-name {
            font-family: 'Playfair Display', serif;
            font-size: 1.25rem;
            font-weight: 700;
            color: var(--wine-black);
            margin-bottom: 5px;
            text-decoration: none;
            display: -webkit-box;
            -webkit-line-clamp: 1;
            line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            transition: color 0.3s;
        }

        .product-name:hover {
            color: var(--wine-maroon);
        }

        .product-price-wrapper {
            margin-bottom: 12px;
        }

        .product-price {
            font-size: 1.2rem;
            font-weight: 600;
            color: var(--wine-maroon);
        }

        .product-price-old {
            font-size: 0.9rem;
            color: #999;
            text-decoration: line-through;
            margin-left: 8px;
        }

        .view-link {
            font-size: 0.75rem;
            text-transform: uppercase;
            letter-spacing: 2.5px;
            color: var(--wine-gold);
            font-weight: 800;
            text-decoration: none;
            display: inline-flex;
            align-items: center;
            gap: 6px;
            margin: 0 auto;
            position: relative;
            padding-bottom: 4px;
        }

        .view-link::after {
            content: '';
            position: absolute;
            bottom: 0;
            left: 0;
            width: 100%;
            height: 1.5px;
            background: var(--wine-gold);
            transform: scaleX(0);
            transform-origin: right;
            transition: transform 0.4s ease;
        }

        .product-card:hover .view-link::after {
            transform: scaleX(1);
            transform-origin: left;
        }

        .view-link i {
            font-size: 10px;
            transition: transform 0.3s;
        }

        .product-card:hover .view-link i {
            transform: translateX(3px);
        }
    </style>
</head>

<body class="bg-white min-h-screen">
    <%- include('../partials/userHeader.ejs') %>

        <div class="pt-24 pb-8">
            <div class="max-w-7xl mx-auto px-4">
                <!-- Advanced Filter Section -->
                <div class="bg-white rounded-lg shadow-xl p-6 mb-8">
                    <form id="filterForm" action="/wines" method="get" class="space-y-4">
                        <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
                            <!-- Search Input -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Search Wines</label>
                                <input type="text" name="search" value="<%= query.search || '' %>"
                                    class="mt-1 block w-full border-gray-300 shadow-sm  "
                                    placeholder="Search by name or description">
                            </div>

                            <!-- Category Dropdown -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Category</label>
                                <select name="category"
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-wine focus:ring focus:ring-wine focus:ring-opacity-50">
                                    <option value="">All Categories</option>
                                    <% categories.forEach(category=> { %>
                                        <option value="<%= category._id %>" <%=query.category &&
                                            query.category.toString()===category._id.toString() ? 'selected' : '' %>
                                            >
                                            <%= category.name %>
                                        </option>
                                        <% }) %>
                                </select>
                            </div>

                            <!-- Sort Dropdown -->
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Sort By</label>
                                <select name="sort"
                                    class="mt-1 block w-full rounded-md border-gray-300 shadow-sm focus:border-wine focus:ring focus:ring-wine focus:ring-opacity-50">
                                    <option value="" <%=!query.sort ? 'selected' : '' %>>Default Sorting</option>
                                    <option value="priceAsc" <%=query.sort==='priceAsc' ? 'selected' : '' %>>Price: Low
                                        to High</option>
                                    <option value="priceDesc" <%=query.sort==='priceDesc' ? 'selected' : '' %>>Price:
                                        High to Low</option>
                                    <option value="nameAsc" <%=query.sort==='nameAsc' ? 'selected' : '' %>>Name: A to Z
                                    </option>
                                    <option value="nameDesc" <%=query.sort==='nameDesc' ? 'selected' : '' %>>Name: Z to
                                        A</option>
                                </select>
                            </div>
                        </div>

                        <!-- Price Range Section -->
                        <div class="grid grid-cols-2 gap-4 mt-4">
                            <div>
                                <label class="block text-sm font-medium text-gray-700 ">Min Price</label>
                                <input type="number" name="minPrice" value="<%= query.minPrice || '' %>" min="0"
                                    class="mt-1 block w-full  border-gray-300 shadow-sm focus:border-wine focus:ring focus:ring-wine focus:ring-opacity-50"
                                    placeholder="Minimum Price">
                            </div>
                            <div>
                                <label class="block text-sm font-medium text-gray-700">Max Price</label>
                                <input type="number" name="maxPrice" value="<%= query.maxPrice || '' %>" min="0"
                                    class="mt-1  w-full  border-gray-500 shadow-sm focus:border-wine focus:ring focus:ring-wine focus:ring-opacity-50"
                                    placeholder="Maximum Price">
                            </div>
                        </div>

                        <!-- Action Buttons -->
                        <div class="flex justify-between items-center mt-6">
                            <button type="submit"
                                class="px-6 py-2 bg-wine text-white rounded-md hover:bg-opacity-90 transition-colors">
                                Apply Filters
                            </button>
                            <a href="/wines" class="text-wine hover:underline">
                                Reset Filters
                            </a>
                        </div>
                    </form>
                </div>

                <!-- Products Grid -->
                <div id="productsGrid" class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 lg:grid-cols-4 gap-8">
                    <% if (products.length===0) { %>
                        <div class="col-span-full text-center py-12">
                            <div class="bg-white rounded-xl shadow-lg p-8">
                                <i class="fas fa-wine-bottle text-6xl text-wine mb-4"></i>
                                <h2 class="text-2xl font-bold text-gray-800 mb-3">No Products Found</h2>
                                <p class="text-gray-600 mb-6">We couldn't find any wines matching your search criteria.
                                </p>
                                <a href="/wines"
                                    class="inline-block px-6 py-2 bg-wine text-white rounded-md hover:bg-opacity-90 transition-colors">
                                    Reset Filters
                                </a>
                            </div>
                        </div>
                        <% } else { %>
                            <% products.forEach((product, i)=> { %>
                                <div class="product-card" data-aos="fade-up" data-aos-delay="<%= 100 * (i % 4) %>">
                                    <div class="product-media">
                                        <img src="<%= (product.images && product.images.length > 0) ? (product.images[0].startsWith('http') ? product.images[0] : '/uploads/' + product.images[0]) : '/assets/img/no-image.png' %>"
                                            alt="<%= product.name %>" loading="lazy">
                                        <div class="card-actions-bar">
                                            <button onclick="addToWishlist('<%= product._id%>', this)"
                                                class="bar-action" title="Add to Wishlist">
                                                <i class="fa-regular fa-heart"></i>
                                            </button>

                                            <% if (typeof cartProductIds !=='undefined' &&
                                                cartProductIds.includes(product._id.toString())) { %>
                                                <button onclick="window.location.href='/cart'"
                                                    class="bar-action text-emerald-500" title="Go to Cart">
                                                    <i class="fa-solid fa-check-double"></i>
                                                </button>
                                                <% } else { %>
                                                    <button onclick="addToCart('<%= product._id%>', this)"
                                                        class="bar-action" title="Add to Cart">
                                                        <i class="fa-solid fa-cart-plus"></i>
                                                    </button>
                                                    <% } %>
                                        </div>
                                    </div>
                                    <div class="product-info">
                                        <div>
                                            <a href="/wine/<%= product._id %>" class="product-name">
                                                <%= product.name %>
                                            </a>
                                            <div class="product-price-wrapper">
                                                <span class="product-price">₹<%= (product.priceAfterDiscount).toFixed(0)
                                                        %></span>
                                                <% if (product.price> product.priceAfterDiscount) { %>
                                                    <span class="product-price-old">₹<%= product.price %></span>
                                                    <% } %>
                                            </div>
                                        </div>
                                        <a href="/wine/<%= product._id %>" class="view-link">
                                            Discover <i class="fa-solid fa-arrow-right"></i>
                                        </a>
                                    </div>
                                </div>
                                <% }); %>
                                    <% } %>
                </div>

                <!-- Pagination -->
                <div class="flex justify-center items-center mt-8 space-x-4">
                    <% if (pagination.hasPrevPage) { %>
                        <a href="/wines?page=<%= pagination.currentPage - 1 %>&<%= Object.keys(query).filter(key => key !== 'page').map(key => `${key}=${query[key]}`).join('&') %>"
                            class="px-4 py-2 bg-wine text-white rounded-md hover:bg-opacity-90">
                            Previous
                        </a>
                        <% } %>

                            <span class="text-gray-700">
                                Page <%= pagination.currentPage %> of <%= pagination.totalPages %>
                            </span>

                            <% if (pagination.hasNextPage) { %>
                                <a href="/wines?page=<%= pagination.currentPage + 1 %>&<%= Object.keys(query).filter(key => key !== 'page').map(key => `${key}=${query[key]}`).join('&') %>"
                                    class="px-4 py-2 bg-wine text-white rounded-md hover:bg-opacity-90">
                                    Next
                                </a>
                                <% } %>
                </div>
            </div>
        </div>

        <%- include('../partials/userFooter.ejs') %>
            <script>

                async function addToCart(productId, element) {

                    try {
                        const response = await fetch('/cartt', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ productId }),
                        });

                        if (response.ok) {
                            showToast('success', 'Product added to cart!');


                            element.innerHTML = '<i class="fa-solid fa-check-double"></i>';
                            element.classList.add('text-emerald-500');
                            element.title = 'Go to Cart';
                            element.onclick = (e) => {
                                e.stopPropagation();
                                window.location.href = '/cart';
                            };
                        } else {
                            const error = await response.json();
                            showToast('info', error.message || 'Failed to add product to cart.');
                        }
                    } catch (error) {
                        console.error("Fetch error:", error);
                        showToast('error', 'An unexpected error occurred.');
                    }


                }


                async function addToWishlist(productId, element) {
                    try {
                        const response = await fetch('/wishlistt', {
                            method: 'POST',
                            headers: {
                                'Content-Type': 'application/json',
                            },
                            body: JSON.stringify({ productId }),
                        });

                        if (response.ok) {
                            const data = await response.json();
                            showToast(data.action === 'added' ? 'success' : 'info', data.message);
                        } else {
                            const error = await response.json();
                            showToast('error', error.message || 'Failed to update the wishlist.');
                        }
                    } catch (error) {
                        console.error('Error:', error);
                        showToast('error', 'An unexpected error occurred.');
                    }


                }






                AOS.init({
                    duration: 1000,
                    once: true,
                    offset: 50
                });
            </script>
</body>

</html>