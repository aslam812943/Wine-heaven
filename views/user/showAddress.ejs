<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>My Addresses | Wine Heaven</title>
    <script src="https://cdn.tailwindcss.com"></script>
    <link href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css" rel="stylesheet">
    <link
        href="https://fonts.googleapis.com/css2?family=Inter:wght@300;400;500;600;700&family=Playfair+Display:wght@400;700&display=swap"
        rel="stylesheet">
    <link href="https://unpkg.com/aos@2.3.1/dist/aos.css" rel="stylesheet">
    <script src="https://unpkg.com/aos@2.3.1/dist/aos.js"></script>
    <script src="https://cdn.jsdelivr.net/npm/sweetalert2@11"></script>

    <script>
        tailwind.config = {
            theme: {
                extend: {
                    colors: {
                        'wine-maroon': '#6b0f1a',
                        'wine-gold': '#c9a84c',
                        'wine-cream': '#fdf8f2',
                        'wine-black': '#0a0202',
                    }
                }
            }
        }
    </script>

    <style>
        :root {
            --wine-maroon: #6b0f1a;
            --wine-gold: #c9a84c;
            --wine-cream: #fdf8f2;
            --wine-black: #0a0202;
        }

        body {
            background-color: var(--wine-cream);
            font-family: 'Inter', sans-serif;
            color: var(--wine-black);
        }

        .playfair {
            font-family: 'Playfair Display', serif;
        }

        .glass-card {
            background: rgba(255, 255, 255, 0.85);
            backdrop-filter: blur(12px);
            border: 1px solid rgba(107, 15, 26, 0.1);
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .glass-card:hover {
            transform: translateY(-8px);
            box-shadow: 0 20px 40px rgba(107, 15, 26, 0.1);
            border-color: var(--wine-gold);
        }

        .address-type-badge {
            background: rgba(107, 15, 26, 0.05);
            color: var(--wine-maroon);
            border: 1px solid rgba(107, 15, 26, 0.1);
        }

        .btn-premium {
            background: var(--wine-maroon);
            color: white;
            transition: all 0.3s ease;
        }

        .btn-premium:hover {
            background: #4a0a12;
            transform: translateY(-2px);
            box-shadow: 0 4px 12px rgba(107, 15, 26, 0.2);
        }

        .icon-circle {
            width: 40px;
            height: 40px;
            border-radius: 50%;
            background: rgba(107, 15, 26, 0.05);
            color: var(--wine-maroon);
            display: flex;
            align-items: center;
            justify-content: center;
        }
    </style>
</head>

<body class="min-h-screen">
    <%- include('../partials/userHeader.ejs') %>

        <main class="container mx-auto px-4 pt-40 pb-20">
            <!-- Header Section -->
            <div class="mb-16 flex flex-col md:flex-row justify-between items-center gap-8" data-aos="fade-down">
                <div class="text-center md:text-left">
                    <span class="text-wine-gold uppercase tracking-[0.3em] text-xs font-bold mb-2 block">Delivery
                        Management</span>
                    <h1 class="playfair text-4xl md:text-5xl font-bold text-wine-black mb-4">My Addresses</h1>
                    <div class="w-20 h-1 bg-wine-gold mx-auto md:mx-0"></div>
                </div>

                <a href="/addAddress"
                    class="btn-premium px-8 py-4 rounded-2xl font-bold flex items-center gap-3 shadow-xl shadow-wine-maroon/20">
                    <i class="fas fa-plus-circle text-lg"></i>
                    <span>Add Reserve Location</span>
                </a>
            </div>

            <!-- Address Grid -->
            <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
                <% if (addresses && addresses.length> 0) { %>
                    <% addresses.forEach((address, index)=> { %>
                        <div class="glass-card rounded-[2.5rem] p-8 flex flex-col justify-between h-full relative overflow-hidden"
                            data-aos="fade-up" data-aos-delay="<%= index * 100 %>">
                            <!-- Type Badge -->
                            <div class="absolute right-8 top-8">
                                <span
                                    class="address-type-badge px-4 py-1.5 rounded-full text-[10px] font-bold uppercase tracking-widest">
                                    <i
                                        class="fas <%= address.addressType === 'Home' ? 'fa-home' : 'fa-briefcase' %> mr-1.5"></i>
                                    <%= address.addressType %>
                                </span>
                            </div>

                            <div>
                                <h3 class="playfair text-xl font-bold text-wine-black mb-6 pr-20">
                                    <%= address.name %>
                                </h3>

                                <div class="space-y-5">
                                    <div class="flex items-start gap-4">
                                        <div class="icon-circle shrink-0">
                                            <i class="fas fa-map-marker-alt text-sm"></i>
                                        </div>
                                        <div>
                                            <p class="text-sm font-medium text-wine-black">
                                                <%= address.address %>
                                            </p>
                                            <p class="text-xs text-gray-500 mt-1">
                                                <%= address.locality %>
                                            </p>
                                        </div>
                                    </div>

                                    <div class="flex items-center gap-4">
                                        <div class="icon-circle shrink-0">
                                            <i class="fas fa-city text-sm"></i>
                                        </div>
                                        <p class="text-sm font-medium text-wine-black">
                                            <%= address.city %>, <%= address.state %> - <%= address.pincode %>
                                        </p>
                                    </div>

                                    <div class="flex items-center gap-4">
                                        <div class="icon-circle shrink-0">
                                            <i class="fas fa-phone-alt text-sm"></i>
                                        </div>
                                        <p class="text-sm font-medium text-wine-black">
                                            <%= address.mobile %>
                                        </p>
                                    </div>

                                    <% if (address.landmark) { %>
                                        <div class="flex items-center gap-4">
                                            <div class="icon-circle shrink-0">
                                                <i class="fas fa-landmark text-sm"></i>
                                            </div>
                                            <p class="text-xs text-gray-500 italic">Near <%= address.landmark %>
                                            </p>
                                        </div>
                                        <% } %>
                                </div>
                            </div>

                            <div class="mt-10 flex gap-4 pt-6 border-t border-gray-100">
                                <a href="/address-edit/<%= address._id %>"
                                    class="btn-premium flex-1 py-3 rounded-xl text-center text-xs font-bold uppercase tracking-widest flex items-center justify-center gap-2">
                                    <i class="fas fa-edit"></i> Edit
                                </a>
                                <button onclick="confirmDelete('<%= address._id %>')"
                                    class="border border-wine-maroon/10 text-wine-maroon hover:bg-wine-maroon hover:text-white flex-1 py-3 rounded-xl text-center text-xs font-bold uppercase tracking-widest transition-all duration-300 flex items-center justify-center gap-2">
                                    <i class="fas fa-trash-alt"></i> Delete
                                </button>
                                <form action="/address-delite/<%= address._id %>" method="post"
                                    id="delete-form-<%= address._id %>" class="hidden"></form>
                            </div>
                        </div>
                        <% }) %>
                            <% } else { %>
                                <div class="col-span-full py-24 text-center glass-card rounded-[3rem]"
                                    data-aos="zoom-in">
                                    <div
                                        class="w-24 h-24 bg-wine-maroon/5 rounded-full flex items-center justify-center mx-auto mb-6 text-wine-maroon/20">
                                        <i class="fas fa-map-marked-alt text-4xl"></i>
                                    </div>
                                    <h3 class="playfair text-2xl font-bold text-wine-black mb-2">No Reserve locations
                                        Saved</h3>
                                    <p class="text-gray-500 max-w-sm mx-auto">Enhance your shipping experience by adding
                                        your primary delivery locations.</p>
                                </div>
                                <% } %>
            </div>
        </main>

        <%- include('../partials/userFooter.ejs') %>

            <script>
                AOS.init({
                    duration: 1000,
                    once: true,
                    easing: 'ease-out-cubic'
                });

                function confirmDelete(addressId) {
                    Swal.fire({
                        title: '<span class="playfair">Remove Address?</span>',
                        text: "This action will permanently delete this reserve location.",
                        icon: 'warning',
                        showCancelButton: true,
                        confirmButtonColor: '#6b0f1a',
                        cancelButtonColor: '#95A5A6',
                        confirmButtonText: 'Yes, Delete',
                        cancelButtonText: 'Cancel',
                        background: '#fdf8f2',
                        customClass: {
                            title: 'playfair font-bold',
                            popup: 'rounded-[2rem]'
                        }
                    }).then((result) => {
                        if (result.isConfirmed) {
                            document.getElementById(`delete-form-${addressId}`).submit();
                        }
                    });
                }
            </script>
</body>

</html>