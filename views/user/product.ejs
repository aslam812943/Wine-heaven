<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.name %> | Wine Heaven
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.js"></script>

    <style>
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --bg: #f7f4f0;
            --surface: #ffffff;
            --border: #e8e0d6;
            --text-1: #18080e;
            --text-2: #5a4a52;
            --text-3: #9a8a92;
            --radius-lg: 24px;
            --shadow-card: 0 20px 60px rgba(107, 15, 26, .10);
        }

        *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
        body { font-family: 'Inter', sans-serif; background: var(--bg); color: var(--text-1); min-height: 100vh; }

        /* BREADCRUMB */
        .breadcrumb { background: var(--surface); border-bottom: 1px solid var(--border); padding: 11px 0; }
        .bc-inner { max-width: 1320px; margin: 0 auto; padding: 0 32px; display: flex; align-items: center; gap: 7px; font-size: 12.5px; color: var(--text-3); }
        .bc-inner a { color: var(--text-3); text-decoration: none; transition: color .2s; }
        .bc-inner a:hover { color: var(--maroon); }
        .bc-inner .bc-sep { font-size: 10px; opacity: .5; }
        .bc-inner .bc-cur { color: var(--maroon); font-weight: 500; }

        .page-wrap { max-width: 1320px; margin: 0 auto; padding: 40px 32px 80px; display: grid; grid-template-columns: minmax(400px, 460px) 1.2fr; gap: 60px; align-items: start; }

        /* GALLERY */
        .gallery { position: sticky; top: 100px; }
        .main-img-shell { background: var(--surface); border-radius: var(--radius-lg); overflow: hidden; aspect-ratio: 3 / 4; position: relative; box-shadow: var(--shadow-card); cursor: crosshair; border: 1px solid rgba(107, 15, 26, 0.05); }
        .main-img-shell img { width: 100%; height: 100%; object-fit: contain; padding: 30px; display: block; transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1); }
        .main-img-shell:hover img { transform: scale(1.15); }

        /* Badges */
        .img-badges { position: absolute; top: 20px; left: 20px; display: flex; flex-direction: column; gap: 8px; z-index: 5; }
        .ibadge { display: inline-flex; align-items: center; gap: 6px; padding: 6px 14px; border-radius: 30px; font-size: 10.5px; font-weight: 700; letter-spacing: 1px; text-transform: uppercase; backdrop-filter: blur(8px); box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1); }
        .ibadge-maroon { background: rgba(107, 15, 26, 0.85); color: #fff; }
        .ibadge-gold { background: rgba(201, 168, 76, 0.85); color: #fff; }
        .ibadge-gray { background: rgba(10, 2, 2, 0.6); color: #fff; }

        .thumbs { display: flex; gap: 12px; margin-top: 20px; justify-content: center; }
        .thumb { width: 70px; height: 70px; border-radius: 12px; overflow: hidden; border: 2px solid transparent; cursor: pointer; transition: all 0.3s ease; background: #fff; padding: 5px; box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05); }
        .thumb img { width: 100%; height: 100%; object-fit: contain; }
        .thumb:hover { border-color: var(--maroon); transform: translateY(-3px); }
        .thumb.active { border-color: var(--maroon); box-shadow: 0 4px 15px rgba(107, 15, 26, 0.15); }

        /* INFO */
        .info { display: flex; flex-direction: column; gap: 30px; }
        .brand-pills { display: flex; gap: 10px; }
        .tag { padding: 6px 16px; background: #fff; border: 1px solid var(--border); border-radius: 50px; font-size: 10px; font-weight: 800; text-transform: uppercase; letter-spacing: 2px; color: var(--maroon); }
        .status-badge { display: inline-flex; align-items: center; gap: 6px; font-size: 11px; font-weight: 700; padding: 6px 14px; border-radius: 50px; text-transform: uppercase; }
        .status-available { background: #ecfdf5; color: #059669; border: 1px solid #10b98130; }
        .status-soldout { background: #fef2f2; color: #dc2626; border: 1px solid #ef444430; }
        .product-name { font-family: 'Playfair Display', serif; font-size: clamp(2.2rem, 4.5vw, 3.5rem); font-weight: 700; color: var(--text-1); }

        .price-section { background: #fff; padding: 24px; border-radius: 20px; display: flex; flex-direction: column; gap: 10px; border: 1px solid var(--border); }
        .price-row { display: flex; align-items: baseline; gap: 15px; }
        .price-main { font-family: 'Playfair Display', serif; font-size: 3rem; font-weight: 700; color: var(--maroon); }
        .price-orig { font-size: 1.2rem; color: var(--text-3); text-decoration: line-through; }
        
        .stock-indicator { display: flex; align-items: center; gap: 8px; font-size: 13px; font-weight: 600; color: #666; }
        .stock-dot { width: 8px; height: 8px; border-radius: 50%; background: #10b981; }
        .out-stock .stock-dot { background: #ef4444; }

        .desc { font-size: 15px; line-height: 1.8; color: var(--text-2); }
        .actions { display: flex; gap: 15px; margin-top: 15px; }
        .btn-premium { flex: 1; height: 64px; border-radius: 50px; font-weight: 700; font-size: 14px; text-transform: uppercase; letter-spacing: 2px; cursor: pointer; transition: all 0.4s ease; display: flex; align-items: center; justify-content: center; gap: 12px; border: none; }
        .btn-add { background: #fff; color: var(--maroon); border: 2px solid var(--maroon); }
        .btn-add:hover { background: var(--maroon); color: #fff; transform: translateY(-3px); }
        .btn-buy { background: linear-gradient(135deg, var(--maroon), var(--maroon-dk)); color: #fff; }
        .btn-buy:hover { transform: translateY(-3px); filter: brightness(1.1); }
        .btn-wish { width: 64px; height: 64px; border-radius: 50%; background: #fff; border: 1px solid var(--border); color: #aaa; display: flex; align-items: center; justify-content: center; font-size: 20px; }
        .btn-disabled { flex: 1; height: 64px; background: #f3f4f6; color: #9ca3af; border-radius: 50px; cursor: not-allowed; display: flex; align-items: center; justify-content: center; font-weight: 700; }

        /* RELATED */
        .related { background: var(--surface); border-top: 1px solid var(--border); padding: 72px 0 80px; }
        .rel-inner { max-width: 1320px; margin: 0 auto; padding: 0 32px; }
        .rel-title { font-family: 'Playfair Display', serif; font-size: clamp(1.7rem, 3vw, 2.3rem); font-weight: 700; margin-bottom: 30px; }
        .rel-grid { display: grid; grid-template-columns: repeat(auto-fill, minmax(230px, 1fr)); gap: 22px; }
        .rel-card { background: var(--surface); border: 1px solid var(--border); border-radius: 20px; overflow: hidden; text-decoration: none; color: inherit; transition: transform .3s; }
        .rel-card:hover { transform: translateY(-7px); box-shadow: 0 20px 48px rgba(107, 15, 26, .12); }
        .rel-img { height: 220px; overflow: hidden; background: var(--bg); position: relative; }
        .rel-img img { width: 100%; height: 100%; object-fit: cover; }
        .rel-name { position: absolute; bottom: 12px; left: 12px; color: #fff; font-weight: 600; text-shadow: 0 2px 4px rgba(0,0,0,0.5); }
        .rel-foot { padding: 14px 16px; display: flex; align-items: center; justify-content: space-between; }
        .rel-price { font-weight: 700; color: var(--maroon); }

        @media (max-width: 960px) { .page-wrap { grid-template-columns: 1fr; } }
    </style>
</head>

<body>
    <%- include('../partials/userHeader.ejs') %>

    <nav class="breadcrumb">
        <div class="bc-inner">
            <a href="/">Home</a>
            <span class="bc-sep">/</span>
            <a href="/wines">Wines</a>
            <span class="bc-sep">/</span>
            <span class="bc-cur"><%= product.name %></span>
        </div>
    </nav>

    <div class="page-wrap">
        <div class="gallery">
            <div class="main-img-shell">
                <% 
                   var mainImg = '/assets/img/no-image.png';
                   if (product.images && product.images.length > 0) {
                       mainImg = product.images[0].startsWith('http') ? product.images[0] : '/uploads/' + product.images[0];
                   }
                %>
                <img id="mainImage" src="<%= mainImg %>" alt="<%= product.name %>">
                <div class="img-badges">
                    <% if (product.stock <= 0) { %>
                        <span class="ibadge ibadge-gray">Sold Out</span>
                    <% } %>
                    <% if (product.discount > 0) { %>
                        <span class="ibadge ibadge-maroon"><%= product.discount %>% OFF</span>
                    <% } %>
                </div>
            </div>
            <div class="thumbs">
                <% (product.images || []).forEach(function(img, i) { %>
                    <% var tPath = (img && img.startsWith('http')) ? img : '/uploads/' + img; %>
                    <div class="thumb <%= (i === 0) ? 'active' : '' %>" onclick="swapImage('<%= tPath %>', this)">
                        <img src="<%= tPath %>">
                    </div>
                <% }); %>
            </div>
        </div>

        <div class="info">
            <div class="brand-pills">
                <span class="tag"><%= product.category.name %></span>
                <span class="status-badge <%= product.stock > 0 ? 'status-available' : 'status-soldout' %>">
                    <%= product.stock > 0 ? 'In Stock' : 'Sold Out' %>
                </span>
            </div>

            <h1 class="product-name"><%= product.name %></h1>

            <div class="price-section">
                <div class="price-row">
                    <span class="price-main">₹<%= (product.priceAfterDiscount || 0).toFixed(0) %></span>
                    <% if (product.price > product.priceAfterDiscount) { %>
                        <span class="price-orig">₹<%= product.price %></span>
                    <% } %>
                </div>
                <div class="stock-indicator <%= product.stock > 0 ? 'in-stock' : 'out-stock' %>">
                    <div class="stock-dot"></div>
                    <span><%= product.stock > 0 ? product.stock + " units available" : "Currently Unavailable" %></span>
                </div>
            </div>

            <div class="desc"><%= product.description %></div>

            <div class="actions">
                <% if (product.stock > 0) { %>
                    <button id="cartBtn" class="btn-premium btn-add">
                        <i class="fa-solid fa-cart-plus"></i> Add to Cart
                        <input id="productId" type="hidden" value="<%= product._id %>">
                    </button>
                    <button id="buyNowBtn" class="btn-premium btn-buy">
                        <i class="fa-solid fa-bolt"></i> Buy Now
                        <input id="productIdBuy" type="hidden" value="<%= product._id %>">
                    </button>
                <% } else { %>
                    <div class="btn-disabled">Out of Stock</div>
                <% } %>
                <button id="wishBtn" class="btn-wish">
                    <i class="fa-regular fa-heart"></i>
                    <input id="productIdWish" type="hidden" value="<%= product._id %>">
                </button>
            </div>
        </div>
    </div>

    <% if (products && products.length > 0) { %>
    <section class="related">
        <div class="rel-inner">
            <h2 class="rel-title">Related Selection</h2>
            <div class="rel-grid">
                <% products.forEach(function(rp) { %>
                    <a href="/wine/<%= rp._id %>" class="rel-card">
                        <div class="rel-img">
                            <% var rpImg = (rp.images && rp.images.length > 0) ? (rp.images[0].startsWith('http') ? rp.images[0] : '/uploads/' + rp.images[0]) : '/assets/img/no-image.png'; %>
                            <img src="<%= rpImg %>" alt="<%= rp.name %>">
                            <span class="rel-name"><%= rp.name %></span>
                        </div>
                        <div class="rel-foot">
                            <span class="rel-price">₹<%= (rp.priceAfterDiscount || 0).toFixed(0) %></span>
                            <span style="font-size: 12px; color: var(--maroon);">Discover</span>
                        </div>
                    </a>
                <% }); %>
            </div>
        </div>
    </section>
    <% } %>

    <%- include('../partials/userFooter.ejs') %>

    <script>
        function swapImage(src, thumbEl) {
            const img = document.getElementById('mainImage');
            img.src = src;
            document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
            thumbEl.classList.add('active');
        }

        const cartBtn = document.getElementById('cartBtn');
        if (cartBtn) {
            cartBtn.addEventListener('click', async () => {
                const productId = document.getElementById('productId').value;
                const res = await fetch('/cartt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId })
                });
                if (res.ok) {
                    Swal.fire({ icon: 'success', title: 'Added to Cart!' }).then(() => location.reload());
                }
            });
        }
        
        const buyBtn = document.getElementById('buyNowBtn');
        if (buyBtn) {
            buyBtn.addEventListener('click', async () => {
                const productId = document.getElementById('productIdBuy').value;
                await fetch('/cartt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId })
                });
                window.location.href = '/cart';
            });
        }

        const wishBtn = document.getElementById('wishBtn');
        if (wishBtn) {
            wishBtn.addEventListener('click', async () => {
                const productId = document.getElementById('productIdWish').value;
                const res = await fetch('/wishlistt', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ productId })
                });
                if (res.ok) {
                    Swal.fire({ icon: 'success', title: 'Wishlist Updated!' });
                }
            });
        }
    </script>
</body>
</html>