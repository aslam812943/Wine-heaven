<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>
        <%= product.name %> | Wine Heaven
    </title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link
        href="https://fonts.googleapis.com/css2?family=Playfair+Display:ital,wght@0,500;0,700;1,500&family=Inter:wght@300;400;500;600&display=swap"
        rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/font-awesome/6.4.0/css/all.min.css">
    <link href="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.css" rel="stylesheet">
    <script src="https://cdnjs.cloudflare.com/ajax/libs/sweetalert2/11.7.32/sweetalert2.min.js"></script>

    <style>
        /* ============================================================
           TOKENS
        ============================================================ */
        :root {
            --maroon: #6b0f1a;
            --maroon-dk: #4a0a12;
            --gold: #c9a84c;
            --bg: #f7f4f0;
            --surface: #ffffff;
            --border: #e8e0d6;
            --text-1: #18080e;
            --text-2: #5a4a52;
            --text-3: #9a8a92;
            --radius-lg: 24px;
            --shadow-card: 0 20px 60px rgba(107, 15, 26, .10);
        }

        *,
        *::before,
        *::after {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
        }

        body {
            font-family: 'Inter', sans-serif;
            background: var(--bg);
            color: var(--text-1);
            min-height: 100vh;
        }

        /* ============================================================
           BREADCRUMB
        ============================================================ */
        .breadcrumb {
            background: var(--surface);
            border-bottom: 1px solid var(--border);
            padding: 11px 0;
        }

        .bc-inner {
            max-width: 1320px;
            margin: 0 auto;
            padding: 0 32px;
            display: flex;
            align-items: center;
            gap: 7px;
            font-size: 12.5px;
            color: var(--text-3);
        }

        .bc-inner a {
            color: var(--text-3);
            text-decoration: none;
            transition: color .2s;
        }

        .bc-inner a:hover {
            color: var(--maroon);
        }

        .bc-inner .bc-sep {
            font-size: 10px;
            opacity: .5;
        }

        .bc-inner .bc-cur {
            color: var(--maroon);
            font-weight: 500;
        }


        .page-wrap {
            max-width: 1320px;
            margin: 0 auto;
            padding: 40px 32px 80px;
            display: grid;
            grid-template-columns: minmax(400px, 460px) 1.2fr;

            gap: 60px;
            align-items: start;
        }

        /* ============================================================
           LEFT — GALLERY
        ============================================================ */
        .gallery {
            position: sticky;
            top: 100px;
        }

        /* Main image */
        .main-img-shell {
            background: var(--surface);
            border-radius: var(--radius-lg);
            overflow: hidden;
            aspect-ratio: 3 / 4;

            position: relative;
            box-shadow: var(--shadow-card);
            cursor: crosshair;
            border: 1px solid rgba(107, 15, 26, 0.05);
        }

        .main-img-shell img {
            width: 100%;
            height: 100%;
            object-fit: contain;

            padding: 30px;
            display: block;
            transition: transform 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
        }

        .main-img-shell:hover img {
            transform: scale(1.15);
        }

        /* Floating glassmorphism badges */
        .img-badges {
            position: absolute;
            top: 20px;
            left: 20px;
            display: flex;
            flex-direction: column;
            gap: 8px;
            z-index: 5;
        }

        .ibadge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            padding: 6px 14px;
            border-radius: 30px;
            font-size: 10.5px;
            font-weight: 700;
            letter-spacing: 1px;
            text-transform: uppercase;
            backdrop-filter: blur(8px);
            box-shadow: 0 4px 15px rgba(0, 0, 0, 0.1);
        }

        .ibadge-maroon {
            background: rgba(107, 15, 26, 0.85);
            color: #fff;
        }

        .ibadge-gold {
            background: rgba(201, 168, 76, 0.85);
            color: #fff;
        }

        .ibadge-gray {
            background: rgba(10, 2, 2, 0.6);
            color: #fff;
        }

        /* Thumbnail row */
        .thumbs {
            display: flex;
            gap: 12px;
            margin-top: 20px;
            justify-content: center;
        }

        .thumb {
            width: 70px;
            height: 70px;
            border-radius: 12px;
            overflow: hidden;
            border: 2px solid transparent;
            cursor: pointer;
            transition: all 0.3s ease;
            background: #fff;
            padding: 5px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.05);
        }

        .thumb img {
            width: 100%;
            height: 100%;
            object-fit: contain;
        }

        .thumb:hover {
            border-color: var(--maroon);
            transform: translateY(-3px);
        }

        .thumb.active {
            border-color: var(--maroon);
            box-shadow: 0 4px 15px rgba(107, 15, 26, 0.15);
        }

        /* ============================================================
           RIGHT — PRODUCT INFO
        ============================================================ */
        .info {
            display: flex;
            flex-direction: column;
            gap: 30px;
        }

        .brand-pills {
            display: flex;
            gap: 10px;
        }

        .tag {
            padding: 6px 16px;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 50px;
            font-size: 10px;
            font-weight: 800;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--maroon);
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.03);
        }

        .status-badge {
            display: inline-flex;
            align-items: center;
            gap: 6px;
            font-size: 11px;
            font-weight: 700;
            padding: 6px 14px;
            border-radius: 50px;
            text-transform: uppercase;
            letter-spacing: 1px;
        }

        .status-available {
            background: #ecfdf5;
            color: #059669;
            border: 1px solid #10b98130;
        }

        .status-soldout {
            background: #fef2f2;
            color: #dc2626;
            border: 1px solid #ef444430;
        }

        .product-name {
            font-family: 'Playfair Display', serif;
            font-size: clamp(2.2rem, 4.5vw, 3.5rem);
            font-weight: 700;
            line-height: 1.1;
            color: var(--text-1);
        }

        /* ---- Rating ---- */
        .rating-row {
            display: flex;
            align-items: center;
            gap: 12px;
        }

        .stars {
            display: flex;
            gap: 4px;
        }

        .star {
            font-size: 16px;
            color: #f59e0b;
        }

        .rating-num {
            font-size: 14px;
            font-weight: 500;
            color: var(--text-3);
        }

        /* ---- Price block ---- */
        .price-section {
            background: #fff;
            padding: 24px;
            border-radius: 20px;
            display: flex;
            flex-direction: column;
            gap: 10px;
            border: 1px solid var(--border);
            box-shadow: 0 4px 20px rgba(0, 0, 0, 0.02);
        }

        .price-row {
            display: flex;
            align-items: baseline;
            gap: 15px;
        }

        .price-main {
            font-family: 'Playfair Display', serif;
            font-size: 3rem;
            font-weight: 700;
            color: var(--maroon);
        }

        .price-orig {
            font-size: 1.2rem;
            color: var(--text-3);
            text-decoration: line-through;
            font-weight: 400;
        }

        .stock-indicator {
            display: flex;
            align-items: center;
            gap: 8px;
            font-size: 13px;
            font-weight: 600;
            color: #666;
        }

        .stock-dot {
            width: 8px;
            height: 8px;
            border-radius: 50%;
            position: relative;
        }

        .stock-dot::after {
            content: '';
            position: absolute;
            inset: -4px;
            border-radius: 50%;
            opacity: 0.4;
        }

        .in-stock .stock-dot {
            background: #10b981;
        }

        .in-stock .stock-dot::after {
            background: #10b981;
            animation: pulse 2s infinite;
        }

        .out-stock .stock-dot {
            background: #ef4444;
        }

        @keyframes pulse {
            0% {
                transform: scale(1);
                opacity: 0.6;
            }

            100% {
                transform: scale(2.5);
                opacity: 0;
            }
        }

        /* ---- Quantity & Actions ---- */
        .controls-group {
            display: flex;
            flex-direction: column;
            gap: 20px;
            margin-top: 10px;
        }

        .qty-label {
            font-size: 14px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 1px;
            color: var(--text-2);
        }

        .qty-ctrl {
            display: flex;
            align-items: center;
            width: fit-content;
            background: #fff;
            border: 1px solid var(--border);
            border-radius: 50px;
            padding: 4px;
            box-shadow: 0 2px 8px rgba(0, 0, 0, 0.04);
        }

        .qty-btn {
            width: 42px;
            height: 42px;
            border-radius: 50%;
            border: none;
            background: #fff;
            cursor: pointer;
            font-size: 16px;
            color: var(--text-1);
            transition: all 0.2s ease;
            display: flex;
            align-items: center;
            justify-content: center;
        }

        .qty-btn:hover {
            background: var(--maroon);
            color: #fff;
        }

        .qty-val {
            width: 50px;
            text-align: center;
            font-size: 18px;
            font-weight: 700;
            color: var(--text-1);
            border: none;
            background: none;
        }

        .actions {
            display: flex;
            gap: 15px;
            margin-top: 15px;
        }

        .btn-premium {
            flex: 1;
            height: 64px;
            border-radius: 50px;
            font-weight: 700;
            font-size: 14px;
            text-transform: uppercase;
            letter-spacing: 2px;
            cursor: pointer;
            transition: all 0.4s cubic-bezier(0.165, 0.84, 0.44, 1);
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 12px;
            border: none;
        }

        .btn-add {
            background: #fff;
            color: var(--maroon);
            border: 2px solid var(--maroon);
        }

        .btn-add:hover {
            background: var(--maroon);
            color: #fff;
            box-shadow: 0 10px 25px rgba(107, 15, 26, 0.2);
            transform: translateY(-3px);
        }

        .btn-buy {
            background: linear-gradient(135deg, var(--maroon), var(--maroon-dk));
            color: #fff;
            box-shadow: 0 10px 25px rgba(107, 15, 26, 0.3);
        }

        .btn-buy:hover {
            transform: translateY(-3px);
            box-shadow: 0 15px 35px rgba(107, 15, 26, 0.4);
            filter: brightness(1.1);
        }

        .btn-wish {
            width: 64px;
            height: 64px;
            border-radius: 50%;
            background: #fff;
            border: 1px solid var(--border);
            color: #aaa;
            display: flex;
            align-items: center;
            justify-content: center;
            font-size: 20px;
            transition: all 0.3s ease;
        }

        .btn-wish:hover,
        .btn-wish.active {
            border-color: #ef4444;
            color: #ef4444;
            transform: scale(1.1);
        }

        .btn-disabled {
            flex: 1;
            height: 56px;
            border: 2px solid #e5e7eb;
            border-radius: 16px;
            background: #f3f4f6;
            color: #9ca3af;
            font-size: 14px;
            font-weight: 600;
            cursor: not-allowed;
            font-family: 'Inter', sans-serif;
            display: flex;
            align-items: center;
            justify-content: center;
            gap: 8px;
        }

        /* ============================================================
           RELATED SECTION
        ============================================================ */
        .related {
            background: var(--surface);
            border-top: 1px solid var(--border);
            padding: 72px 0 80px;
        }

        .rel-inner {
            max-width: 1320px;
            margin: 0 auto;
            padding: 0 32px;
        }

        .rel-header {
            margin-bottom: 44px;
        }

        .rel-label {
            font-size: 11px;
            font-weight: 700;
            text-transform: uppercase;
            letter-spacing: 2px;
            color: var(--maroon);
            display: block;
            margin-bottom: 10px;
        }

        .rel-title {
            font-family: 'Playfair Display', serif;
            font-size: clamp(1.7rem, 3vw, 2.3rem);
            font-weight: 700;
            color: var(--text-1);
        }

        .rel-title em {
            color: var(--maroon);
            font-style: italic;
        }

        .rel-grid {
            display: grid;
            grid-template-columns: repeat(auto-fill, minmax(230px, 1fr));
            gap: 22px;
        }

        .rel-card {
            background: var(--surface);
            border: 1px solid var(--border);
            border-radius: 20px;
            overflow: hidden;
            text-decoration: none;
            color: inherit;
            display: flex;
            flex-direction: column;
            transition: transform .3s, box-shadow .3s;
        }

        .rel-card:hover {
            transform: translateY(-7px);
            box-shadow: 0 20px 48px rgba(107, 15, 26, .12);
        }

        .rel-img {
            position: relative;
            height: 220px;
            overflow: hidden;
            background: var(--bg);
        }

        .rel-img img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            transition: transform .5s;
        }

        .rel-card:hover .rel-img img {
            transform: scale(1.08);
        }

        .rel-overlay {
            position: absolute;
            inset: 0;
            background: linear-gradient(to top, rgba(18, 5, 8, .72) 0%, transparent 55%);
        }

        .rel-name {
            position: absolute;
            bottom: 12px;
            left: 12px;
            right: 12px;
            font-family: 'Playfair Display', serif;
            font-size: 1rem;
            font-weight: 600;
            color: #fff;
            line-height: 1.3;
        }

        .rel-foot {
            padding: 14px 16px;
            display: flex;
            align-items: center;
            justify-content: space-between;
        }

        .rel-price {
            font-size: 1.1rem;
            font-weight: 700;
            color: var(--maroon);
        }

        .rel-price small {
            display: block;
            font-size: .75rem;
            font-weight: 400;
            color: var(--text-3);
            text-decoration: line-through;
        }

        .rel-cta {
            padding: 7px 15px;
            background: #f3ece4;
            color: var(--maroon);
            border: 1px solid var(--border);
            border-radius: 30px;
            font-size: 12px;
            font-weight: 600;
            cursor: pointer;
            transition: background .18s, color .18s;
            font-family: 'Inter', sans-serif;
        }

        .rel-cta:hover {
            background: var(--maroon);
            color: #fff;
            border-color: var(--maroon);
        }

        /* ============================================================
           RESPONSIVE
        ============================================================ */
        @media (max-width: 960px) {
            .page-wrap {
                grid-template-columns: 1fr;
                gap: 32px;
                padding: 24px 20px 60px;
            }

            .gallery {
                position: static;
            }
        }

        @media (max-width: 580px) {
            .actions {
                flex-wrap: wrap;
            }

            .btn-add,
            .btn-buy {
                flex: 1 1 calc(50% - 6px);
            }

            .btn-wish {
                width: 100%;
            }

            .specs-row {
                gap: 10px;
            }
        }
    </style>
</head>

<body>

    <%- include('../partials/userHeader.ejs') %>

        <!-- Breadcrumb -->
        <nav class="breadcrumb">
            <div class="bc-inner">
                <a href="/"><i class="fa-solid fa-house" style="font-size:10px;"></i></a>
                <span class="bc-sep"><i class="fa-solid fa-chevron-right" style="font-size:9px;"></i></span>
                <a href="/products">Wines</a>
                <span class="bc-sep"><i class="fa-solid fa-chevron-right" style="font-size:9px;"></i></span>
                <a href="/category/<%= product.category._id %>">
                    <%= product.category.name %>
                </a>
                <span class="bc-sep"><i class="fa-solid fa-chevron-right" style="font-size:9px;"></i></span>
                <span class="bc-cur">
                    <%= product.name %>
                </span>
            </div>
        </nav>

        <!-- Page -->
        <div class="page-wrap">

            <!-- ══════════════════════════════════
         LEFT — GALLERY
    ══════════════════════════════════ -->
            <!-- ══════════════════════════════════
                 LEFT — GALLERY (Balanced)
            ══════════════════════════════════ -->
            <div class="gallery" data-aos="fade-right">
                <div class="main-img-shell">
                    <img id="mainImage"
                        src="<%= product.images[0].startsWith('http') ? product.images[0] : '/uploads/' + product.images[0] %>"
                        alt="<%= product.name %>">
                    <div class="img-badges">
                        <% if (product.stock <=0) { %>
                            <span class="ibadge ibadge-gray"><i class="fa-solid fa-ban"></i> Sold Out</span>
                            <% } %>
                                <% if (product.discount> 0) { %>
                                    <span class="ibadge ibadge-maroon">
                                        <i class="fa-solid fa-tag"></i>
                                        <%= product.discount %>% OFF
                                    </span>
                                    <% } %>
                                        <% if (product.offerDiscout> 0) { %>
                                            <span class="ibadge ibadge-gold">
                                                <i class="fa-solid fa-bolt"></i> Extra <%= product.offerDiscout %>%
                                            </span>
                                            <% } %>
                    </div>
                </div>

                <!-- Thumbnails -->
                <div class="thumbs">
                    <% product.images.forEach((img, i)=> {
                        const thumbPath = img.startsWith('http') ? img : '/uploads/' + img;
                        %>
                        <div class="thumb <%= i === 0 ? 'active' : '' %>" onclick="swapImage('<%= thumbPath %>', this)">
                            <img src="<%= thumbPath %>" alt="View <%= i+1 %>">
                        </div>
                        <% }); %>
                </div>
            </div>

            <!-- ══════════════════════════════════
         RIGHT — PRODUCT INFO
    ══════════════════════════════════ -->
            <div class="info" data-aos="fade-left">
                <div class="brand-pills">
                    <span class="tag">
                        <%= product.category.name %>
                    </span>
                    <div class="status-badge <%= product.stock > 0 ? 'status-available' : 'status-soldout' %>">
                        <i class="fa-solid <%= product.stock > 0 ? 'fa-check-circle' : 'fa-times-circle' %>"></i>
                        <%= product.stock> 0 ? 'In Stock' : 'Sold Out' %>
                    </div>
                </div>

                <h1 class="product-name">
                    <%= product.name %>
                </h1>

                <div class="rating-row">
                    <div class="stars">
                        <% for(let i=0; i<4; i++) { %>
                            <i class="fa-solid fa-star star"></i>
                            <% } %>
                                <i class="fa-solid fa-star-half-stroke star"></i>
                    </div>
                    <span class="rating-num">4.5 (24 Boutique Reviews)</span>
                </div>

                <div class="sep"></div>

                <div class="price-section">
                    <div class="price-row">
                        <span class="price-main">₹<%= (product.priceAfterDiscount).toFixed(0) %></span>
                        <% if (product.price> product.priceAfterDiscount) { %>
                            <span class="price-orig">₹<%= product.price %></span>
                            <% } %>
                    </div>
                    <div class="stock-indicator <%= product.stock > 0 ? 'in-stock' : 'out-stock' %>">
                        <div class="stock-dot"></div>
                        <span>
                            <%= product.stock> 0 ? product.stock + " limited editions available" : "Currently
                                unavailable in our boutique" %>
                        </span>
                    </div>
                </div>

                <div class="desc">
                    A masterpiece of flavor and refinement. This exquisite <%= product.category.name.toLowerCase() %>
                        selection offers a sensory journey through the world's most celebrated vineyards.
                </div>

                <div class="controls-group">
                    <% if (product.stock> 0) { %>
                        <!-- <div class="qty-section">
                            <span class="qty-label">Quantity</span>
                            <div class="qty-ctrl">
                                <button class="qty-btn" onclick="changeQty(-1)"><i
                                        class="fa-solid fa-minus"></i></button>
                                <input class="qty-val" id="qtyVal" type="text" value="1" readonly>
                                <button class="qty-btn" onclick="changeQty(1)"><i class="fa-solid fa-plus"></i></button>
                            </div>
                        </div> -->
                        <% } %>

                            <div class="actions">
                                <% if (product.stock> 0) { %>
                                    <% if (isInCart) { %>
                                        <a href="/cart" class="btn-premium btn-buy">
                                            <i class="fa-solid fa-cart-shopping"></i> GO TO CART
                                        </a>
                                        <% } else { %>
                                            <button id="cartBtn" class="btn-premium btn-add">
                                                <i class="fa-solid fa-cart-plus"></i> ADD TO CART
                                                <input id="productId" type="hidden" value="<%= product._id %>">
                                            </button>
                                            <% } %>

                                                <button id="buyNowBtn" class="btn-premium btn-buy">
                                                    <i class="fa-solid fa-bolt"></i> BUY NOW
                                                    <input id="productIdBuy" type="hidden" value="<%= product._id %>">
                                                </button>

                                                <button id="wishBtn" class="btn-wish" title="Add to Wishlist">
                                                    <i class="fa-regular fa-heart"></i>
                                                    <input id="productIdWish" type="hidden" value="<%= product._id %>">
                                                </button>
                                                <% } else { %>
                                                    <div class="btn-disabled" style="flex:1;">
                                                        <i class="fa-solid fa-ban"></i> OUT OF STOCK
                                                    </div>
                                                    <button id="wishBtn" class="btn-wish" title="Add to Wishlist">
                                                        <i class="fa-regular fa-heart"></i>
                                                        <input id="productIdWish" type="hidden"
                                                            value="<%= product._id %>">
                                                    </button>
                                                    <% } %>
                            </div>
                </div>
            </div>
        </div><!-- /page-wrap -->


        <!-- ══════════════════════════════════
     RELATED PRODUCTS
══════════════════════════════════ -->
        <% if (products && products.length> 0) { %>
            <section class="related">
                <div class="rel-inner">
                    <div class="rel-header">
                        <span class="rel-label"><i class="fa-solid fa-star" style="font-size:10px;"></i> &nbsp;Explore
                            More</span>
                        <h2 class="rel-title">More from <em>
                                <%= product.category.name %>
                            </em></h2>
                    </div>

                    <div class="rel-grid">
                        <% products.forEach(rp=> { %>
                            <a href="/products/<%= rp._id %>" class="rel-card">
                                <div class="rel-img">
                                    <img src="/uploads/<%= rp.images[0] %>" alt="<%= rp.name %>">
                                    <div class="rel-overlay"></div>
                                    <div class="rel-name">
                                        <%= rp.name %>
                                    </div>
                                </div>
                                <div class="rel-foot">
                                    <div class="rel-price">
                                        ₹<%= (rp.priceAfterDiscount).toFixed(0) %>
                                            <% if(rp.price> rp.priceAfterDiscount) { %>
                                                <small>₹<%= rp.price %></small>
                                                <% } %>
                                    </div>
                                    <button class="rel-cta">View <i class="fa-solid fa-arrow-right"
                                            style="font-size:9px;"></i></button>
                                </div>
                            </a>
                            <% }); %>
                    </div>
                </div>
            </section>
            <% } %>

                <span id="maxStock" data-value="<%= product.stock %>" style="display:none;"></span>

                <%- include('../partials/userFooter.ejs') %>

                    <script>
                        /* -- image swap -- */
                        function swapImage(src, thumbEl) {
                            const img = document.getElementById('mainImage');
                            if (!img) return;
                            img.style.opacity = '0';
                            img.style.transform = 'scale(0.95)';

                            setTimeout(() => {
                                img.src = src;
                                img.style.opacity = '1';
                                img.style.transform = 'scale(1)';
                            }, 250);

                            document.querySelectorAll('.thumb').forEach(t => t.classList.remove('active'));
                            thumbEl.classList.add('active');
                        }

                        /* -- quantity -- */
                        function changeQty(delta) {
                            const el = document.getElementById('qtyVal');
                            const max = parseInt(document.getElementById('maxStock')?.getAttribute('data-value')) || 10;
                            let val = parseInt(el.value) + delta;

                            if (val < 1) val = 1;
                            if (val > max) {
                                val = max;
                                Swal.fire({
                                    icon: 'info',
                                    title: 'Boutique Limit',
                                    text: `Only ${max} units are currently available in our collection.`,
                                    confirmButtonColor: '#6b0f1a',
                                    timer: 2000
                                });
                            }
                            el.value = val;
                        }

                        /* -- add to cart -- */
                        const cartBtn = document.getElementById('cartBtn');
                        if (cartBtn) {
                            cartBtn.addEventListener('click', async () => {
                                const productId = document.getElementById('productId').value;
                                cartBtn.disabled = true;
                                cartBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i> Adding…';
                                try {
                                    const res = await fetch('/cartt', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ productId })
                                    });
                                    if (res.ok) {
                                        Swal.fire({ icon: 'success', title: 'Added to Cart!', confirmButtonColor: '#6b0f1a' })
                                            .then(() => location.reload());
                                    } else {
                                        const err = await res.json();
                                        Swal.fire({ icon: 'info', title: 'Notice', text: err.message || 'Could not add to cart.', confirmButtonColor: '#6b0f1a' });
                                        cartBtn.disabled = false;
                                        cartBtn.innerHTML = '<i class="fa-solid fa-cart-plus"></i> ADD TO CART';
                                    }
                                } catch {
                                    cartBtn.disabled = false;
                                    cartBtn.innerHTML = '<i class="fa-solid fa-cart-plus"></i> ADD TO CART';
                                }
                            });
                        }

                        /* -- buy now (add to cart then redirect) -- */
                        const buyBtn = document.getElementById('buyNowBtn');
                        if (buyBtn) {
                            buyBtn.addEventListener('click', async () => {
                                const productId = document.getElementById('productIdBuy').value;
                                buyBtn.disabled = true;
                                buyBtn.innerHTML = '<i class="fa-solid fa-spinner fa-spin"></i>';
                                try {
                                    await fetch('/cartt', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ productId })
                                    });
                                    window.location.href = '/cart';
                                } catch {
                                    buyBtn.disabled = false;
                                    buyBtn.innerHTML = '<i class="fa-solid fa-bolt"></i> BUY NOW';
                                }
                            });
                        }

                        /* -- wishlist -- */
                        const wishBtn = document.getElementById('wishBtn');
                        if (wishBtn) {
                            wishBtn.addEventListener('click', async () => {
                                const productId = document.getElementById('productIdWish').value;
                                try {
                                    const res = await fetch('/wishlistt', {
                                        method: 'POST',
                                        headers: { 'Content-Type': 'application/json' },
                                        body: JSON.stringify({ productId })
                                    });
                                    if (res.ok) {
                                        const data = await res.json();
                                        const added = data.action === 'added';
                                        wishBtn.querySelector('i').className = `fa-${added ? 'solid' : 'regular'} fa-heart`;
                                        wishBtn.style.background = added ? '#fdf0f2' : '';
                                        wishBtn.style.borderColor = added ? 'var(--maroon)' : '';
                                        Swal.fire({
                                            icon: added ? 'success' : 'info',
                                            title: added ? 'Added to Wishlist' : 'Removed',
                                            text: data.message,
                                            confirmButtonColor: '#6b0f1a',
                                            timer: 1800, showConfirmButton: false
                                        });
                                    } else {
                                        const err = await res.json();
                                        Swal.fire({ icon: 'error', title: 'Error', text: err.message, confirmButtonColor: '#6b0f1a' });
                                    }
                                } catch {
                                    Swal.fire({ icon: 'error', title: 'Error', text: 'Unexpected error.', confirmButtonColor: '#6b0f1a' });
                                }
                            });
                        }

                        /* -- auto-hide flash -- */
                        setTimeout(() => {
                            const f = document.getElementById('flashMsg');
                            if (f) f.style.display = 'none';
                        }, 3000);
                    </script>
</body>

</html>